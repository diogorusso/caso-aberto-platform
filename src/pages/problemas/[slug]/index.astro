---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import reports from '../../../data/relatos.json';
import topics from '../../../data/issues.json';
import {brands} from '../../../lib/brands';
type Topic=(typeof topics.items)[number];
export function getStaticPaths(){return topics.items.filter(t=>reports.filter(r=>r.tema===t.theme).length>=2).map(topic=>({params:{slug:topic.slug},props:{topic}}));}
interface Props {topic:Topic}
const {topic}=Astro.props;
const found=reports.filter(r=>r.tema===topic.theme).sort((a,b)=>b.data.localeCompare(a.data));
const cityCount=new Set(found.map(r=>r.cidade)).size;
const slugPath='/problemas/'+topic.slug+'/';
---
<BaseLayout title={topic.title+' | CasoAberto'} description={topic.description} dateModified={topics.updated_at}
 breadcrumbs={[{name:'Início',item:'/'},{name:'Problemas',item:'/problemas/'},{name:topic.theme,item:slugPath}]}>
 <Breadcrumbs items={[{label:'Início',href:'/'},{label:'Problemas',href:'/problemas/'},{label:topic.theme,href:slugPath}]}/>
 <section class="pagehead"><div class="container"><span class="eyebrow">RELATOS POR TEMA · {topic.theme}</span><h1>{topic.title}</h1><p>{topic.intro}</p><div class="brand-scope-grid"><div><strong>{found.length}</strong><span>Reclamações catalogadas</span></div><div><strong>{cityCount}</strong><span>Localidades distintas declaradas</span></div><div><strong>{found.filter(x=>/^resolvid[oa]\b/i.test(x.status.trim())).length}</strong><span>Registros com status resolvido</span></div><div><strong>{topics.updated_at.split('-').reverse().join('/')}</strong><span>Última consulta editorial</span></div></div></div></section>
 <section class="section"><div class="container"><span class="eyebrow">ARQUIVO DE FONTES</span><h2>Relatos e situação informada no registro original</h2><div class="reports-grid">{found.map(r=><article class="record"><div class="record-top"><span>{r.data.split('-').reverse().join('/')}</span><span>·</span><span>{r.cidade}</span></div><h3>{r.titulo}</h3><p>{r.resumo}</p><p class="muted"><strong>Status registrado:</strong> {r.status}</p><a class="text-link" href={r.url} target="_blank" rel="noopener noreferrer">Consultar reclamação original ↗</a></article>)}</div></div></section>
 <section class="section section-soft"><div class="container narrow editorial"><h2>O que verificar antes de contratar ou reclamar</h2><ol>{topic.what_to_check.map(q=><li>{q}</li>)}</ol><p><a href={topic.related_guide}>Ver guia completo de documentação e prazos ↗</a></p><p>Esta coleção não é um índice estatístico de todo o mercado. Os registros são uma amostra de fontes publicadas e catalogadas; compare período, unidade, localidade e status individual.</p></div></section>
 <section class="section"><div class="container"><span class="eyebrow">EMPRESAS E DOSSIÊS RELACIONADOS</span><h2>Leia o contexto corporativo</h2><div class="brand-directory-grid">{brands.filter(b=>b.case_ids.some(id=>found.some(r=>r.case_id===id))).map(b=><article class="brand-rating-card"><h3><a href={'/empresas/'+b.slug+'/'}>{b.name}</a></h3><p>{b.summary}</p><a class="text-link" href={'/empresas/'+b.slug+'/'}>Dossiê empresarial ↗</a></article>)}</div></div></section>
</BaseLayout>