---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PrecedentTimeline from '../../../components/PrecedentTimeline.astro';
import {precedents,precedentPath,formatDate,stageDescription,signalRows,type Precedent} from '../../../lib/precedents';
import raw from '../../../data/precedents.json';
export function getStaticPaths(){return precedents.map(precedent=>({params:{slug:precedent.slug},props:{precedent}}));}
interface Props{precedent:Precedent}
const {precedent:p}=Astro.props;
const url=precedentPath(p);
const isBankrupt=p.stage==='falencia_decretada';
const relatedProceedings=('related_proceedings' in p ? p.related_proceedings : undefined) ?? [];
const institutionalRecords=('institutional_records' in p ? p.institutional_records : undefined) ?? [];
const hasLinkedCase=raw.case_links.some(link=>link.precedent_ids.includes(p.id));
const schema={'@context':'https://schema.org','@type':'Article',headline:p.brand+': cronologia judicial e precedente de risco',dateModified:raw.updated_at,citation:p.sources.map(s=>s.url),about:{'@type':'Organization',name:p.brand}};
---
<BaseLayout title={p.brand+': '+p.stage_label.toLowerCase()+', processo e cronologia documentada | CasoAberto'}
 description={p.summary.slice(0,275)} dateModified={raw.updated_at} breadcrumbs={[{name:'Início',item:'/'},{name:'Precedentes',item:'/precedentes/'},{name:p.brand,item:url}]} schema={schema}>
 <Breadcrumbs items={[{label:'Início',href:'/'},{label:'Precedentes',href:'/precedentes/'},{label:p.brand,href:url}]}/>
 <section class="bg-forest py-14 text-forest-foreground md:py-20 [&_h1]:my-4 [&_h1_em]:text-brand [&_h1_em]:not-italic [&>div>p]:max-w-3xl [&>div>p]:text-lg [&>div>p]:text-white/75 [&_.eyebrow]:text-brand"><div class="container">
  <span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">ARQUIVO JUDICIAL · {p.geography}</span><span class:list={['ml-3 inline-flex px-2.5 py-0.5 text-xs font-semibold uppercase',isBankrupt?'bg-brand text-brand-foreground':'bg-warning-soft text-warning']}>{p.stage_label}</span>
  <h1>{p.brand}: o que aconteceu, quando e com quais documentos?</h1><p>{p.headline}</p>
  <div class="mt-6 flex flex-wrap gap-2 [&>span]:border [&>span]:border-white/20 [&>span]:px-3 [&>span]:py-1 [&>span]:text-sm [&>span]:text-white/80">{p.process_number&&<span>Processo {p.process_number}</span>}{p.court&&<span>{p.court}</span>}<span>Pesquisa revisada em {formatDate(raw.updated_at)}</span></div>
  <div class="mt-6 flex flex-wrap gap-2.5"><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90" href={p.sources[0].url} target="_blank" rel="noopener noreferrer">Abrir processo ou fonte judicial ↗</a><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 border bg-background text-foreground shadow-xs hover:bg-accent" href="#linha-do-tempo">Ver cronologia ↓</a></div>
 </div></section>
 <section class="py-14 md:py-20 bg-muted"><div class="container">
  <span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">INDICADORES DA DOCUMENTAÇÃO</span><h2>Não é uma previsão: são marcos já registrados.</h2>
  <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3 [&>article]:flex [&>article]:flex-col [&>article]:gap-2 [&>article]:border [&>article]:bg-card [&>article]:p-5 [&>article]:shadow-sm [&_strong]:text-lg [&_p]:m-0 [&_p]:text-sm [&_p]:text-muted-foreground [&_small]:text-xs [&_small]:text-muted-foreground [&_a]:text-sm [&_a]:font-semibold [&_a]:text-brand-strong">{p.metrics.map(metric=><article><strong>{metric.label}</strong><p>{metric.meaning}</p>{metric.kind==='calculated'&&<small>Intervalo entre datas explicitadas nas fontes do processo</small>}{'source_url'in metric && metric.source_url && <a href={metric.source_url} target="_blank" rel="noopener noreferrer">Fonte do indicador ↗</a>}</article>)}</div>
 </div></section>
 <section class="py-14 md:py-20" id="linha-do-tempo"><div class="container">
  <span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">MARCO A MARCO</span><h2>Linha do tempo com documentos.</h2>
  <PrecedentTimeline precedent={p}/>
  <p class="my-6 border border-warning/25 bg-warning-soft p-5 text-sm"><strong>Limite da comparação:</strong> {p.known_limits}</p>
 </div></section>
 <section class="py-14 md:py-20 bg-muted"><div class="container grid gap-10 lg:grid-cols-[1.4fr_0.85fr]"><div>
  <span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">REGISTRO PÚBLICO</span><h2>O que está estabelecido?</h2><p>{p.summary}</p><ul class="m-0 grid list-none gap-4 p-0">{p.signals.map(s=>{const label=signalRows.find(r=>r.key===s.key)?.label||s.key;return <li class="border-l-2 border-brand-strong pl-4"><strong class="block">{label}</strong><time datetime={s.date} class="text-sm font-semibold text-brand-strong">{formatDate(s.date)}</time>{s.note&&<span class="block text-sm text-muted-foreground">{s.note}</span>}<a class="text-sm font-semibold text-brand-strong" href={s.source_url} target="_blank" rel="noopener noreferrer">Fonte do sinal ↗</a></li>;})}</ul></div>
  <aside class="self-start border bg-card p-6 shadow-sm"><h3>Estágio processual</h3><p>{stageDescription(p.stage)}</p><strong>{isBankrupt?'Sentença de falência':'Recuperação judicial'}</strong><p>{isBankrupt&&p.bankruptcy_decree_date?formatDate(p.bankruptcy_decree_date):p.recovery_acceptance_date?formatDate(p.recovery_acceptance_date):'—'}</p><strong>Por que este precedente é relevante?</strong><p>{p.relevance}</p></aside>
 </div></section>

 {relatedProceedings.length>0&&<section class="py-14 md:py-20 bg-muted" id="processos-relacionados"><div class="container">
  <span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">CONEXÕES COM A JUSTIÇA</span>
  <h2>Processo principal e recursos relacionados</h2>
  <p class="max-w-3xl text-muted-foreground">Cada número identifica um procedimento documentado. Agravos do mesmo processo de recuperação não são novas recuperações judiciais. Pauta de sessão não significa julgamento concluído.</p>
  <div class="mt-7 grid gap-3 md:grid-cols-2">{relatedProceedings.map(d=><article class="min-w-0 border bg-card p-5 shadow-sm">
    <p class="m-0 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{d.kind} · {d.institution}</p>
    <h3 class="my-2 break-all font-mono text-lg">{d.number}</h3>
    <p class="my-2">{d.role}</p>
    <p class="m-0 text-sm text-muted-foreground"><strong>Conferência necessária:</strong> {d.verification}</p>
    <a class="mt-3 inline-block text-sm font-semibold text-brand-strong" href={d.source_url} target="_blank" rel="noopener noreferrer">Abrir fonte do vínculo ↗</a>
  </article>)}</div>
 </div></section>}
 {institutionalRecords.length>0&&<section class="py-14 md:py-20" id="fontes-institucionais"><div class="container">
  <span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">TRIBUNAL · CREDORES · REGULAÇÃO</span>
  <h2>Onde verificar cada parte do caso?</h2>
  <div class="mt-6 grid gap-4 md:grid-cols-2">{institutionalRecords.map(source=><article class="border bg-card p-5">
   <p class="m-0 text-xs font-semibold uppercase tracking-wide text-muted-foreground">{source.category}</p>
   <h3 class="my-2 text-lg"><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a></h3>
   <p class="m-0 text-sm text-muted-foreground">{source.scope}</p>
  </article>)}</div>
 </div></section>}
 <section class="py-14 md:py-20"><div class="container">
  <span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">AUDITORIA DE FONTES</span><h2>Documentos e reportagens para conferência.</h2>
  <ol class="m-0 list-none divide-y p-0 [&>li]:flex [&>li]:flex-col [&>li]:gap-1 [&>li]:py-3 [&_a]:font-semibold [&_a]:break-words [&_a]:text-brand-strong [&_small]:text-xs [&_small]:text-muted-foreground">{p.sources.map(s=><li><span class="w-fit bg-muted px-2 py-0.5 text-xs font-medium uppercase text-muted-foreground">{s.kind.replaceAll('_','')}</span><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><small>Consultado em {formatDate(s.checked_at)}</small></li>)}</ol>
  {hasLinkedCase&&<div class="mt-10 flex flex-col gap-4 bg-forest p-6 text-forest-foreground md:flex-row md:items-center md:justify-between md:p-8 [&_h3]:mt-0 [&_p]:mb-0 [&_p]:text-white/75 [&_a]:bg-white! [&_a]:text-foreground!"><div><h3>Compare com o dossiê relacionado.</h3><p>O setor de móveis planejados reúne situações documentadas de atraso, recuperação e falência. Compare datas e fatos antes de contratar.</p></div><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90" href="/casos/florense-ipanema-rj-atraso-moveis-planejados/precedentes/">Abrir comparação com Florense Ipanema ↗</a></div>}
 </div></section>
</BaseLayout>