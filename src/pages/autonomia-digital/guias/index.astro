---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CivicPageHeader from '../../../components/CivicPageHeader.astro';
import catalog from '../../../data/learning-publications.json';
---
<BaseLayout title="Guias de Autonomia Digital — Pesquisa aplicada | CasoAberto" description="Guias aprofundados sobre proteção de dados, fingerprinting, brokers, algoritmos, agentes de IA, direitos, deepfakes e publicidade programática.">
<CivicPageHeader eyebrow="ESCOLA CASOABERTO · GUIAS ABERTOS" title="Entenda a tecnologia antes que ela decida por você." lead="Guias com perguntas concretas, mecanismo técnico, limites da evidência, experimentos locais e fontes originais. Aprofunde seu repertório e transforme informação em ação verificável." note="Publicações com data de revisão e fontes; não são relatórios de experimentos originais conduzidos pelo CasoAberto." />
<section class="container space-y-8 py-14"><div class="flex flex-wrap items-center justify-between gap-4"><h2 class="m-0 text-3xl">{catalog.articles.length} guias de pesquisa aplicada</h2><a class="text-link" href="/autonomia-digital/">Voltar às trilhas ↗</a></div><div class="grid gap-4 md:grid-cols-2">{catalog.articles.map(a=><article class="flex flex-col gap-4 border border-border bg-card p-6"><p class="m-0 text-xs font-semibold tracking-wider text-brand-strong">ESTUDO E FERRAMENTA · {a.updated_at.split('-').reverse().join('/')}</p><h3 class="m-0 text-xl">{a.title}</h3><p class="flex-1 text-muted-foreground">{a.summary}</p><div class="flex flex-wrap gap-4"><a class="text-link text-sm" href={'/autonomia-digital/guias/'+a.slug+'/'}>Ler guia com fontes ↗</a><a class="text-link text-sm" href={'/autonomia-digital/ferramentas/'+a.slug+'/'}>Ficha de laboratório ↗</a></div></article>)}</div></section>
</BaseLayout>
