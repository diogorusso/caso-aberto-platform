---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CivicPageHeader from '../../../components/CivicPageHeader.astro';
import catalog from '../../../data/learning-publications.json';
---
<BaseLayout title="Guias de Autonomia Digital — Pesquisa aplicada | CasoAberto" description="Insights gratuitos e amostras sobre proteção de dados, fingerprinting, brokers, algoritmos, agentes de IA, direitos, deepfakes e publicidade programática.">
<CivicPageHeader eyebrow="ESCOLA CASOABERTO · GUIAS ABERTOS" title="Entenda a tecnologia antes que ela decida por você." lead="Conteúdos curtos com uma pergunta, explicação verificável e fontes. O currículo completo, as experiências e os laboratórios avançados integram os programas da Academia." note="Estas são amostras editoriais, não a publicação do playbook. Não representam experimentos próprios." />
<section class="container space-y-8 py-14"><div class="flex flex-wrap items-center justify-between gap-4"><h2 class="m-0 text-3xl">{catalog.articles.length} insights abertos</h2><a class="text-link" href="/autonomia-digital/">Voltar às trilhas ↗</a></div><div class="grid gap-4 md:grid-cols-2">{catalog.articles.map(a=><article class="flex flex-col gap-4 border border-border bg-card p-6"><p class="m-0 text-xs font-semibold tracking-wider text-brand-strong">ESTUDO E FERRAMENTA · {a.updated_at.split('-').reverse().join('/')}</p><h3 class="m-0 text-xl">{a.title}</h3><p class="flex-1 text-muted-foreground">{a.summary}</p><div class="flex flex-wrap gap-4"><a class="text-link text-sm" href={'/autonomia-digital/guias/'+a.slug+'/'}>Ler insight e fontes ↗</a><a class="text-link text-sm" href={'/autonomia-digital/ferramentas/'+a.slug+'/'}>Microexercício gratuito ↗</a></div></article>)}</div></section>
</BaseLayout>
