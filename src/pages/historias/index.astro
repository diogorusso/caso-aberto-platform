---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CivicPageHeader from '../../components/CivicPageHeader.astro';
import CaseResearchExplorer from '../../components/islands/CaseResearchExplorer';
import {categories,personalStories,categoryHref} from '../../lib/case-catalog';
---
<BaseLayout title="Histórias documentadas: consumidores exigem respostas | CasoAberto" description="Viagens não realizadas, móveis atrasados, compras não entregues e apagões: 12 histórias com fontes, datas, empresas e respostas para investigar.">
 <CivicPageHeader eyebrow="CASOABERTO · HISTÓRIAS DO ARQUIVO" title="O prazo passou. O prejuízo ficou. Quem responde?" lead="Um quarto de bebê que não chegou. Uma cama entregue depois de três meses. Viagens perdidas. Dias sem energia. Por trás de cada número existe uma pessoa, uma cobrança e uma fonte para conferir."/>
 <section class="container space-y-7 py-14">
  <div class="grid gap-3 md:grid-cols-4">{categories.map(category=><a href={categoryHref(category)} class="flex min-h-24 flex-col justify-between border border-border bg-card p-4 no-underline hover:border-brand"><strong class="text-lg text-foreground">{category.title}</strong><span class="text-sm text-link">Ver casos da categoria ↗</span></a>)}</div>
  <CaseResearchExplorer client:idle entries={personalStories} categories={categories}/>
 </section>
 <section class="border-t bg-muted py-12"><div class="container grid gap-5 md:grid-cols-[1fr_auto] md:items-center"><div><h2 class="m-0 text-2xl">A história não termina quando a empresa responde.</h2><p class="mb-0 mt-2 max-w-3xl">Entrega, ressarcimento e solução precisam aparecer na cronologia. Uma promessa não fecha o caso. Uma entrega confirmada também precisa ser registrada.</p></div><a class="text-link font-semibold" href="/casos/">Pesquisar toda a documentação ↗</a></div></section>
</BaseLayout>
