---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import atlas from '../../../data/public-case-atlas.json';
export function getStaticPaths(){return atlas.stories.map(person=>({params:{slug:person.slug},props:{person}}));}
type Person=typeof atlas.stories[number];
const {person}=Astro.props as {person:Person};
const related=atlas.cases.filter(study=>person.case_slugs.includes(study.slug));
const path='/historias/'+person.slug+'/';
---
<BaseLayout title={person.headline+' | Histórias públicas CasoAberto'} description={person.deck} type="article" datePublished={person.source_published_at} dateModified={person.reviewed_at} breadcrumbs={[{name:'Início',item:'/'},{name:'Histórias',item:'/historias/'},{name:person.display_name,item:path}]}>
<article>
<header class="bg-primary py-16 text-primary-foreground"><div class="container max-w-5xl space-y-5"><p class="m-0 text-xs font-bold uppercase tracking-wider text-[#ff917e]">RELATO DE TERCEIRO · {person.category}</p><h1 class="m-0 max-w-5xl text-4xl md:text-6xl">{person.headline}</h1><p class="max-w-3xl text-xl text-white/80">{person.deck}</p><p class="m-0 text-sm text-white/60">Fonte: {person.primary_source_name} · Revisado em {person.reviewed_at.split('-').reverse().join('/')}</p></div></header>
<div class="container grid max-w-6xl gap-10 py-14 lg:grid-cols-[minmax(0,1fr)_17rem]">
<div class="min-w-0 space-y-9">
<section class="space-y-4"><p class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">{person.display_name} · {person.persona}</p><h2 class="m-0 text-3xl">O que foi relatado</h2>{person.narrative.map(par=><p class="leading-relaxed">{par}</p>)}</section>
<section class="space-y-3 border-l-4 border-brand bg-muted p-6"><h2 class="m-0 text-2xl">Como estava o caso na data da reportagem?</h2><p class="m-0">{person.source_outcome}</p><p class="m-0 text-xs text-muted-foreground">Relato publicado em {person.source_published_at.split('-').reverse().join('/')}. Esta informação não é uma atualização de atendimento, processo ou resultado posterior.</p></section>
<section class="space-y-4"><h2 class="m-0 text-2xl">O que este caso ensina</h2><ul class="list-disc space-y-3 pl-5">{person.what_to_learn.map(item=><li>{item}</li>)}</ul></section>
<section class="space-y-4"><h2 class="m-0 text-2xl">O caso na esfera pública</h2><p>As histórias pessoais se conectam a medidas e estatísticas de órgãos públicos, mas não devem ser contadas como uma nova amostra nesses totais.</p><div class="grid gap-4 md:grid-cols-2">{related.map(study=><a class="block border border-border p-5" href={'/casos/arquivo-publico/'+study.slug+'/'}><h3 class="mt-0 text-lg">{study.company}</h3><p class="text-sm text-muted-foreground">{study.deck}</p><span class="text-link text-sm">Ver documentos públicos ↗</span></a>)}</div></section>
<section class="space-y-4 border-t border-border pt-8"><h2 class="m-0 text-2xl">Fontes e atribuição</h2><ul class="space-y-3">{person.sources.map(source=><li><a class="text-link" href={source.url} rel="noopener noreferrer">{source.name} ↗</a><p class="m-0 text-xs text-muted-foreground">{source.kind}{source.published_at && <> · {source.published_at.split('-').reverse().join('/')}</>}</p></li>)}</ul></section>
<section class="border-l-4 border-border bg-muted p-6"><h2 class="mt-0 text-lg">Limites e proteção da pessoa</h2><p class="m-0">{person.limits}</p><a class="mt-3 block text-link text-sm" href="/sobre/criterios-de-publicacao/">Correções e direito de resposta ↗</a></section>
</div>
<aside class="h-fit space-y-4 border-t-4 border-brand bg-card p-6 lg:sticky lg:top-24"><h2 class="m-0 text-lg">De onde vem esta história?</h2><p class="m-0 text-sm text-muted-foreground">É uma publicação atribuída a terceiro, não entrevista do CasoAberto.</p><a class="block text-link text-sm" href={person.primary_source_url} rel="noopener noreferrer">Ler a fonte original ↗</a><a class="block text-link text-sm" href="/historias/">Outras histórias ↗</a><a class="block text-link text-sm" href="/organizar/caderno-de-acao/">Documentar meu problema ↗</a></aside>
</div></article>
</BaseLayout>
