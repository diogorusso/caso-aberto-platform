---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import atlas from '../../../data/public-case-atlas.json';
import CaseVisibilityBadge from '../../../components/CaseVisibilityBadge.astro';
import StickyWhatsAppBar from '../../../components/StickyWhatsAppBar.astro';
import ViralShareRail from '../../../components/ViralShareRail.astro';
import {caseStudies,categoryHref} from '../../../lib/case-catalog';
export function getStaticPaths(){return atlas.stories.map(person=>({params:{slug:person.slug},props:{person}}));}
type Person=typeof atlas.stories[number];
const {person}=Astro.props as {person:Person};
const related=atlas.cases.filter(study=>person.case_slugs.includes(study.slug));
const path='/historias/'+person.slug+'/';
const relatedCases=caseStudies.filter(entry=>person.case_slugs.includes(entry.slug));
const topic=relatedCases[0]?.categorySlug;
---
<BaseLayout image={'/og/historias/'+person.slug+'.png'} title={person.headline+' | Histórias públicas CasoAberto'} description={person.deck} type="article" datePublished={person.source_published_at} dateModified={person.reviewed_at} breadcrumbs={[{name:'Início',item:'/'},{name:'Histórias',item:'/historias/'},{name:person.display_name,item:path}]}>
<article>
<header class="bg-primary text-primary-foreground">
  <div class="container max-w-3xl py-10 md:py-14">
    <p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-[#ff917e]">HISTÓRIA DOCUMENTADA · {person.category}</p>
    <h1 class="mt-4 m-0 text-balance text-[1.85rem] font-bold leading-[1.15] tracking-tight sm:text-4xl md:text-[2.75rem] md:leading-[1.1]">{person.headline}</h1>
    <div class="mt-5 space-y-2">
      <CaseVisibilityBadge caseId={person.id} variant="header" tone="inverse" />
      <p class="m-0 text-sm text-white/45">Fonte: {person.primary_source_name} · Revisado em {person.reviewed_at.split('-').reverse().join('/')}</p>
    </div>
    <p class="mt-6 m-0 max-w-2xl text-lg leading-relaxed text-white/75 md:text-xl">{person.deck}</p>
    <div class="mt-8 border-t border-white/10 pt-6">
      <ViralShareRail
        embedded
        compact
        caseId={person.id}
        title={person.headline}
        href={path}
        summary={person.deck}
        company={related.map(study=>study.company).join(' · ')}
        showComplaint={false}
        tone="dark"
      />
    </div>
  </div>
</header>
<div class="container grid max-w-6xl gap-10 py-14 lg:grid-cols-[minmax(0,1fr)_17rem]">
<div class="min-w-0 space-y-9">
<section class="space-y-4"><p class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">{person.display_name} · {person.persona}</p><h2 class="m-0 text-3xl">O que aconteceu com esta pessoa?</h2>{person.narrative.map(par=><p class="leading-relaxed">{par}</p>)}</section>
<section class="space-y-3 border-l-4 border-brand bg-muted p-6"><h2 class="m-0 text-2xl">O que mudou até a última atualização?</h2><p class="m-0">{person.source_outcome}</p><p class="m-0 text-xs text-muted-foreground">Registro publicado em {person.source_published_at.split('-').reverse().join('/')}.</p></section>
<section class="space-y-4"><h2 class="m-0 text-2xl">As perguntas que este caso levanta</h2><ul class="list-disc space-y-3 pl-5">{person.what_to_learn.map(item=><li>{item}</li>)}</ul></section>
<section class="space-y-4"><h2 class="m-0 text-2xl">O que a pesquisa encontrou sobre o caso</h2><p>O relato se conecta aos dados públicos, aos documentos e às respostas que o consumidor tem direito de examinar.</p><div class="grid gap-4 md:grid-cols-2">{related.map(study=><a class="block border border-border p-5" href={'/casos/arquivo-publico/'+study.slug+'/'}><h3 class="mt-0 text-lg">{study.company}</h3><p class="text-sm text-muted-foreground">{study.deck}</p><span class="text-link text-sm">Ver documentos públicos ↗</span></a>)}</div></section>
<section class="space-y-4 border-t border-border pt-8"><h2 class="m-0 text-2xl">Documentos que sustentam esta história</h2><ul class="space-y-3">{person.sources.map(source=><li><a class="text-link" href={source.url} rel="noopener noreferrer">{source.name} ↗</a><p class="m-0 text-xs text-muted-foreground">{source.kind}{source.published_at && <> · {source.published_at.split('-').reverse().join('/')}</>}</p></li>)}</ul></section>
<section class="border-t border-border pt-6"><h2 class="mt-0 text-xl">O que a empresa ainda precisa explicar?</h2><p class="m-0">Quando a promessa é feita, o consumidor precisa de data, documento e resultado. Consulte os casos relacionados e veja quais perguntas permanecem abertas.</p><a class="mt-3 inline-block text-link font-semibold" href="/casos/">Investigar as empresas e os casos ↗</a></section>
</div>
<aside class="h-fit space-y-4 border-t-4 border-brand bg-card p-6 lg:sticky lg:top-24"><h2 class="m-0 text-lg">De onde vem esta história?</h2><p class="m-0 text-sm text-muted-foreground">{person.primary_source_name} · {person.source_published_at.split('-').reverse().join('/')}</p><a class="block text-link text-sm" href={person.primary_source_url} rel="noopener noreferrer">Ler a fonte original ↗</a>{topic&&<a class="block text-link text-sm" href={categoryHref(topic)}>Investigar esta categoria ↗</a>}<a class="block text-link text-sm" href="/historias/">Outras histórias ↗</a><a class="block text-link text-sm" href="/organizar/caderno-de-acao/">Documentar meu problema ↗</a></aside>
</div></article>
<StickyWhatsAppBar caseId={person.id} title={person.headline} href={path} summary={person.deck} company={related.map(study=>study.company).join(' · ')} />
</BaseLayout>
