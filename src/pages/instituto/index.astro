---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CivicPageHeader from '../../components/CivicPageHeader.astro';
const areas = [
  {name:'Dossiês e transparência',detail:'Casos individuais ou coletivos, fatos, contratos, órgãos, empresas, respostas e versões documentadas.',href:'/casos/',action:'Examinar casos'},
  {name:'Observatório político e direitos',detail:'Bets, patrocínios, instituições, violência política, direitos indígenas e emendas: investigação com documentos, nomes e respostas.',href:'/observatorio/politica/',action:'Examinar o poder'},
  {name:'Observatório de plataformas',detail:'Documentação de moderação, alcance, anúncios, IA e dever de transparência, incluindo fontes contraditórias.',href:'/observatorio/plataformas/',action:'Ler observatório'},
  {name:'Organização comunitária',detail:'Do registro individual à ação pública verificável, com responsabilidades, objetivos e acompanhamento de respostas.',href:'/organizar/',action:'Aprender a organizar'},
  {name:'Autonomia e autodefesa digital',detail:'Ferramentas e educação sobre rastreabilidade, fingerprinting, recomendação algorítmica e proteção de dados.',href:'/autonomia-digital/',action:'Explorar a escola'}
];
const metodo = [
  ['01','Pergunta pública','Qual fato concreto precisa ser esclarecido, por quem e em qual prazo?'],
  ['02','Registro de evidência','Fonte original, data, contexto, integridade, atribuição e o que ainda não se sabe.'],
  ['03','Confronto de versões','Registrar relatos, documentos, resposta da parte citada e achados independentes separadamente.'],
  ['04','Análise reproduzível','Mostrar método, recorte, denominador, limites e, quando possível, dados reutilizáveis.'],
  ['05','Ação verificável','Transformar resultados em pedidos, guias, materiais de divulgação e acompanhamento de providências.'],
  ['06','Revisão e correção','Atualizar status, corrigir erros, publicar respostas e preservar histórico de alterações.']
];
---
<BaseLayout title="Instituto CasoAberto — Pesquisa, dados e cidadania digital" description="Instituto independente de pesquisa aplicada: investigação documental, plataformas digitais, organização cidadã, direitos e autonomia digital.">
  <CivicPageHeader eyebrow="INSTITUTO CASOABERTO · PESQUISA APLICADA" title="Transformar dados em capacidade de agir." lead="Problemas pessoais, comunitários e institucionais precisam de mais do que indignação. Precisam de investigação verificável, ferramentas abertas e acompanhamento público de resultados." />
  <section class="container space-y-8 py-14" aria-labelledby="areas">
    <div class="space-y-3"><h2 id="areas" class="m-0 text-3xl">Frentes complementares. Uma infraestrutura de interesse público.</h2><p class="max-w-3xl text-muted-foreground">O mesmo método atende desde um contrato descumprido até a fiscalização de sistemas que moldam a vida pública.</p></div>
    <div class="grid gap-4 md:grid-cols-2">
      {areas.map(area => <article class="flex flex-col gap-4 border border-border bg-card p-6"><h3 class="m-0 text-xl">{area.name}</h3><p class="m-0 flex-1 text-muted-foreground">{area.detail}</p><a class="text-link font-semibold" href={area.href}>{area.action} ↗</a></article>)}
    </div>
  </section>
  <section class="bg-muted py-14" aria-labelledby="metodo">
    <div class="container space-y-8"><div class="space-y-3"><h2 id="metodo" class="m-0 text-3xl">Pesquisa que pode ser contestada e reproduzida.</h2><p class="max-w-3xl text-muted-foreground">Não somamos amostras sobrepostas, não transformamos relato em sentença e não tratamos a posição de uma empresa como prova independente.</p></div>
      <ol class="grid list-none gap-4 p-0 md:grid-cols-3">{metodo.map(item => <li class="border-t-4 border-brand bg-card p-5"><span class="text-sm font-bold text-brand-strong">{item[0]}</span><h3 class="mt-2 text-lg">{item[1]}</h3><p class="text-sm text-muted-foreground">{item[2]}</p></li>)}</ol>
      <a class="text-link" href="/metodologia/">Consultar a metodologia editorial existente ↗</a>
    </div>
  </section>
  <section class="container space-y-5 py-14"><h2 class="m-0 text-3xl">Do conhecimento à presença digital independente.</h2><p class="max-w-4xl">A pesquisa gera dossiês SEO com fontes, fichas públicas, conjuntos de dados revisáveis, checklists imprimíveis, materiais educativos e ferramentas gratuitas. O currículo integral permanece privado como núcleo dos produtos educativos; publicamos amostras independentes e recursos gratuitos. Os cursos e oficinas aprofundam os métodos, mas informações essenciais de direitos e correções continuam abertas.</p><p class="max-w-4xl">Inspiração editorial: <em>Program or Be Programmed</em>, de Douglas Rushkoff. A questão não é apenas o que uma plataforma informa, mas quem controla as regras, os dados e os meios de agir.</p><div class="flex flex-wrap gap-3"><a href="/autonomia-digital/diagnostico/" class="text-link font-semibold">Fazer o diagnóstico gratuito de exposição digital ↗</a><a href="/organizar/" class="text-link font-semibold">Conhecer os instrumentos de ação cidadã ↗</a><a href="/academia/" class="text-link font-semibold">Conhecer a Academia ↗</a></div></section>
</BaseLayout>
