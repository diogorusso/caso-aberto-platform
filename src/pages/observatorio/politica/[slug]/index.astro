---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ledger from '../../../../data/political-observatory.json';
export function getStaticPaths() { return ledger.cases.map(study=>({params:{slug:study.slug},props:{study}})); }
type Study = typeof ledger.cases[number];
const {study}=Astro.props as {study:Study};
const base='/observatorio/politica/';
const caseUrl=base+study.slug+'/';
const bySource=new Map(ledger.sources.map(source=>[source.id,source]));
const sources=study.source_ids.map(id=>bySource.get(id)).filter(Boolean);
const entities=study.entity_ids.map(id=>ledger.entities.find(entity=>entity.id===id)).filter(Boolean);
const relationships=ledger.relationships.filter(edge=>edge.case_id===study.id);
const related=ledger.cases.filter(other=>other.id!==study.id&&(other.topic===study.topic||other.entity_ids.some(id=>study.entity_ids.includes(id)))).slice(0,4);
const sponsors=study.id==='POL-002'?ledger.sponsorships:[];
const date=s=>s?.split('-').reverse().join('/')||'Data não identificada';
const sourceLink=id=>bySource.get(id)?.url||'#fontes';
const sourceTitle=id=>bySource.get(id)?.title||'Fonte';
---
<BaseLayout title={study.title+' | Observatório CasoAberto'} description={study.summary} type="article" dateModified={ledger.reviewed_at} breadcrumbs={[{name:'Início',item:'/'},{name:'Observatório político',item:base},{name:study.title,item:caseUrl}]}>
<article>
 <header class="bg-primary py-14 md:py-20 text-primary-foreground"><div class="container max-w-6xl space-y-5"><div class="flex flex-wrap gap-3 text-xs font-bold uppercase tracking-[.15em]"><span class="text-[#ff917e]">{study.id} · {study.topic}</span><span class="text-white/60">REVISADO EM {date(ledger.reviewed_at)}</span></div><h1 class="m-0 max-w-5xl text-4xl leading-tight md:text-6xl">{study.title}</h1><p class="max-w-4xl text-lg text-white/80 md:text-xl">{study.summary}</p><p class="m-0 border-l-4 border-brand pl-4 text-sm font-semibold">{study.status}</p></div></header>
 <div class="container grid max-w-7xl gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_17rem]">
  <div class="min-w-0 space-y-12">
    <section class="space-y-4"><p class="m-0 text-xs font-bold uppercase tracking-[.15em] text-brand-strong">O QUE ESTÁ EM JOGO · {study.scope}</p><h2 class="m-0 text-3xl">A pergunta pública</h2><p class="text-lg leading-relaxed">{study.opening}</p><div class="border-l-4 border-brand bg-muted p-5"><p class="m-0 text-xs font-bold uppercase tracking-wide text-brand-strong">Estágio documental</p><p class="mb-0 mt-2">{study.legal_stage}</p></div></section>
    <section class="space-y-5" id="fatos"><h2 class="m-0 text-2xl">O que as fontes realmente sustentam</h2><ol class="space-y-4 list-none p-0">{study.facts.map((fact,i)=><li class="border border-border bg-card p-5"><div class="flex justify-between gap-4 text-xs font-bold uppercase tracking-wider text-muted-foreground"><span>REGISTRO {String(i+1).padStart(2,'0')}</span><span>{fact.kind.replaceAll('-',' ')}</span></div><p class="mb-3 mt-3">{fact.finding}</p><a class="text-link text-sm" href={sourceLink(fact.source)} rel="noopener noreferrer">Conferir documento ou cobertura de origem ↗</a></li>)}</ol></section>
    <section class="space-y-5" id="cronologia"><h2 class="m-0 text-2xl">Cronologia verificável</h2><ol class="space-y-6 border-l-2 border-border pl-6">{study.timeline.map(event=><li class="relative space-y-2"><span class="absolute -left-[1.82rem] top-1 h-3 w-3 bg-brand"></span><time datetime={event.date} class="text-sm font-semibold text-brand-strong">{date(event.date)}</time><h3 class="m-0 text-lg">{event.title}</h3><p class="m-0 text-muted-foreground">{event.detail}</p><a class="text-link text-sm" href={sourceLink(event.source)} rel="noopener noreferrer">Ver registro original ↗</a></li>)}</ol></section>
    {sponsors.length>0&&<section class="space-y-5" id="patrocinios"><div class="space-y-2"><h2 class="m-0 text-2xl">Quais clubes tinham marcas de bets na camisa?</h2><p class="m-0 text-muted-foreground">Fotografia jornalística de 18/09/2026, anterior à MP 1.394/2026. Não significa que esses contratos ou anúncios permanecem em execução.</p></div><div class="overflow-x-auto border border-border bg-card"><table class="w-full text-sm"><thead class="bg-muted text-left"><tr><th scope="col" class="p-4">Clube</th><th scope="col" class="p-4">Marca máster na data</th><th scope="col" class="p-4">Recorte</th></tr></thead><tbody>{sponsors.map(s=><tr class="border-t border-border"><td class="p-4 font-medium">{s.club}</td><td class="p-4">{s.brand}</td><td class="p-4 text-muted-foreground">{date(s.as_of)}</td></tr>)}</tbody></table></div><a href={sourceLink('clubes-mapa')} rel="noopener noreferrer" class="text-link text-sm">Consultar o levantamento e a situação histórica ↗</a></section>}
    <section class="space-y-5" id="relacoes"><div class="space-y-2"><h2 class="m-0 text-2xl">Nomes, papéis e vínculos documentais</h2><p class="m-0 text-muted-foreground">A presença de alguém neste índice indica apenas o papel descrito na fonte. Não é lista de suspeitos nem prova de conluio.</p></div><div class="grid gap-3 sm:grid-cols-2">{entities.map(entity=><div class="border border-border p-4"><h3 class="m-0 text-base">{entity.name}</h3><p class="mb-0 mt-2 text-xs text-muted-foreground">{entity.role}</p></div>)}</div>{relationships.length>0&&<ol class="space-y-3 list-none p-0">{relationships.map(edge=><li class="border-l-4 border-brand bg-muted p-4"><p class="m-0 text-sm font-semibold">{ledger.entities.find(x=>x.id===edge.from)?.name} / {ledger.entities.find(x=>x.id===edge.to)?.name}</p><p class="my-2 text-sm">{edge.relation}</p><a href={sourceLink(edge.source)} rel="noopener noreferrer" class="text-link text-sm">Fonte do vínculo ↗</a></li>)}</ol>}</section>
    <section id="perguntas" class="space-y-5"><h2 class="m-0 text-2xl">O que ainda precisa de resposta?</h2><ol class="grid gap-4 md:grid-cols-2 list-none p-0">{study.questions.map((q,i)=><li class="border-t-4 border-brand bg-muted p-5"><span class="text-xs font-bold text-brand-strong">PERGUNTA {String(i+1).padStart(2,'0')}</span><p class="mb-0 mt-3 font-medium">{q}</p></li>)}</ol></section>
    <section class="space-y-3 border-l-4 border-brand bg-brand-soft p-6" id="proxima"><h2 class="m-0 text-xl">Próxima verificação</h2><p class="m-0">{study.next_check}</p><p class="mb-0 text-sm">Este campo descreve uma tarefa editorial, não um serviço de monitoramento em tempo real.</p></section>
    <section class="space-y-4" id="fontes"><h2 class="m-0 text-2xl">Documentos, registros e versões</h2><ol class="list-none space-y-3 p-0">{sources.map((source,i)=><li class="border-b border-border pb-3"><span class="mr-2 text-xs font-bold text-brand-strong">{String(i+1).padStart(2,'0')}</span><a class="text-link font-semibold" href={source.url} rel="noopener noreferrer">{source.title} ↗</a><p class="m-0 text-xs text-muted-foreground">{source.kind} · {source.published_at?date(source.published_at):'registro sem data editorial atribuída'}</p></li>)}</ol></section>
    <section class="border-l-4 border-border bg-muted p-6 space-y-3"><h2 class="m-0 text-lg">Limites da investigação</h2><p class="m-0">{study.limits}</p><p class="m-0 text-sm"><a href="/sobre/criterios-de-publicacao/" class="text-link">Critérios editoriais, correções e direito de resposta ↗</a></p></section>
    {related.length>0&&<section class="space-y-4"><h2 class="m-0 text-xl">Investigações relacionadas</h2><ul class="space-y-2">{related.map(x=><li><a class="text-link" href={base+x.slug+'/'}>{x.title} ↗</a></li>)}</ul></section>}
  </div>
  <aside class="h-fit space-y-4 border-t-4 border-brand bg-card p-6 lg:sticky lg:top-24"><h2 class="m-0 text-xl">Neste dossiê</h2><p class="text-xs text-muted-foreground">ID {study.id} · Revisão {date(ledger.reviewed_at)}</p><nav aria-label="Seções do dossiê" class="flex flex-col gap-3 text-sm">{[['fatos','Fatos verificados'],['cronologia','Cronologia'],['relacoes','Nomes e vínculos'],['perguntas','Perguntas abertas'],['proxima','Próxima verificação'],['fontes','Fontes originais']].map(([id,label])=><a class="text-link" href={'#'+id}>{label} ↗</a>)}{sponsors.length>0&&<a class="text-link" href="#patrocinios">Clubes e patrocínios ↗</a>}</nav><div class="border-t border-border pt-4"><a href={base} class="text-link text-sm font-semibold">Voltar ao observatório ↗</a></div></aside>
 </div>
</article>
</BaseLayout>
