---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import registries from '../../data/company-profiles.json';
const items=registries.entities.slice().sort((a,b)=>a.name.localeCompare(b.name,'pt-BR'));
const money=(v:number|null)=>v==null?'Não divulgado':new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:0}).format(v);
---
<BaseLayout title="Consulta de CNPJ: empresas, QSA, CNAE, capital e fontes | CasoAberto" description="Arquivo de CNPJ, sócios e administradores, CNAE e capital social das empresas documentadas no CasoAberto, com vínculos à marca e casos." dateModified={registries.updated_at}>
 <Breadcrumbs items={[{label:'Início',href:'/'},{label:'Empresas',href:'/empresas/'},{label:'Arquivo CNPJ',href:'/cnpj/'}]}/>
 <section class="border-b bg-card py-12 md:py-16 [&_h1]:my-4 [&_p]:max-w-3xl [&_p]:text-lg [&_p]:text-muted-foreground"><div class="container"><span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">ARQUIVO CADASTRAL</span><h1>CNPJ, sócios, atividades e relações empresariais.</h1><p>Quem fabrica, quem vende, quem monta? Aqui estão os CNPJs e o QSA citados nos dossiês. Exija no contrato o CNPJ que recebe o pagamento — marca na fachada não basta.</p></div></section>
 <section class="py-14 md:py-20"><div class="container"><div class="grid gap-4 md:grid-cols-2">{items.map(p=><article class="flex flex-col gap-2 border bg-card p-6 shadow-sm [&_h3]:m-0 [&_h3]:text-xl [&_h3_a]:no-underline [&_p]:m-0 [&_p]:text-sm [&_p]:text-muted-foreground"><span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">{p.scope}</span><h3><a href={'/cnpj/'+p.cnpj.replace(/\D/g,'')+'/'}>{p.name}</a></h3><p><strong>CNPJ:</strong> {p.cnpj}</p><p><strong>Atividade:</strong> {p.main_activity}</p><p><strong>Capital cadastrado:</strong> {money(p.capital_brl)}</p><p>{p.relationship}</p><a class="text-link" href={'/cnpj/'+p.cnpj.replace(/\D/g,'')+'/'}>Ficha individual CNPJ e fontes ↗</a></article>)}</div><div class="my-8 border bg-brand-soft p-5 text-sm"><p>Cadastros consultados em {registries.updated_at.split('-').reverse().join('/')}. As informações podem mudar; emita comprovante oficial atualizado antes de instruir procedimento.</p><a href={registries.registry_verification_url} target="_blank" rel="noopener noreferrer">Consultar Receita Federal ↗</a></div></div></section>
</BaseLayout>