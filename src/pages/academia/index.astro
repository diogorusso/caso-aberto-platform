---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CivicPageHeader from '../../components/CivicPageHeader.astro';
import products from '../../data/education-products.json';
import catalog from '../../data/learning-publications.json';
---
<BaseLayout title="Academia CasoAberto — Produtos educacionais de autonomia digital" description="Programas educacionais em produção sobre privacidade, algoritmos, IA e direitos. Explore amostras úteis e materiais gratuitos sem cadastro.">
<CivicPageHeader eyebrow="ACADEMIA CASOABERTO · EDUCAÇÃO" title="Conhecimento para não ser programado." lead="Os insights abertos ajudam a reconhecer o problema. Os produtos educativos reúnem progressão completa, protocolos, experiências, casos e material de formação." note="O playbook completo é nosso acervo editorial central e permanece reservado. Não há matrícula, checkout nem venda nesta versão." />
<section class="container space-y-7 py-14"><h2 class="m-0 text-3xl">Acesso aberto e aprofundamento educacional</h2><div class="grid gap-4 md:grid-cols-2"><div class="border-t-4 border-brand bg-muted p-6"><h3 class="m-0 text-xl">Aberto e gratuito</h3><p>Insights curtos, perguntas, fontes, microexercícios introdutórios, modelos para impressão e ferramentas locais úteis por si só.</p><a class="text-link" href="/autonomia-digital/guias/">Explorar {catalog.articles.length} insights ↗</a></div><div class="border-t-4 border-primary bg-muted p-6"><h3 class="m-0 text-xl">Nos produtos educativos</h3><p>O currículo organizado, protocolos aprofundados, estudos comentados, laboratórios completos, recursos de ensino, avaliações e materiais avançados ficam reservados para os programas.</p><p class="m-0 text-sm text-muted-foreground">Em produção · sem venda aberta</p></div></div></section>
<section class="bg-muted py-14"><div class="container space-y-7"><h2 class="m-0 text-3xl">Programas em desenvolvimento</h2><div class="grid gap-4 md:grid-cols-2">{products.tiers.map(p=><article class="flex flex-col gap-4 border border-border bg-card p-6"><p class="m-0 text-xs font-bold uppercase tracking-wider text-brand-strong">{p.type} · {p.status.replaceAll('-',' ')}</p><h3 class="m-0 text-xl">{p.name}</h3><p class="flex-1">{p.promise}</p><p class="text-sm text-muted-foreground">{p.audience}</p><a class="text-link font-semibold" href={'/academia/'+p.slug+'/'}>Conhecer proposta e prévias ↗</a></article>)}</div></div></section>
<section class="container space-y-5 py-14"><h2 class="m-0 text-3xl">Comece sem cadastro ou pagamento</h2><div class="grid gap-4 md:grid-cols-2">{products.free_resources.map(r=><a class="block border border-border p-5 text-link" href={r.url}><strong>{r.name}</strong><p class="mt-2 text-sm text-muted-foreground">{r.format}</p></a>)}</div><p class="max-w-4xl text-sm text-muted-foreground">Pesquisas do instituto mantêm fontes e correções públicas. Informações essenciais de direitos e segurança não dependem de compra.</p></section>
</BaseLayout>
