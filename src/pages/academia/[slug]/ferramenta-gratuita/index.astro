---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import programs from '../../../../data/education-products.json';
import catalog from '../../../../data/academy-lead-magnets.json';

export function getStaticPaths() {
  return catalog.items.map(magnet => ({
    params: {slug: magnet.slug},
    props: {magnet, product: programs.tiers.find(p => p.slug === magnet.slug)},
  }));
}
type Magnet = typeof catalog.items[number];
type Product = typeof programs.tiers[number];
const {magnet, product} = Astro.props as {magnet: Magnet; product: Product};
const programUrl = '/academia/' + magnet.slug + '/';
const pageUrl = programUrl + 'ferramenta-gratuita/';
---
<BaseLayout title={magnet.title + ' — Ferramenta gratuita | CasoAberto'} description={magnet.tagline} breadcrumbs={[{name:'Início',item:'/'},{name:'Academia',item:'/academia/'},{name:product.name,item:programUrl},{name:'Ficha gratuita',item:pageUrl}]}>
  <header class="bg-primary py-12 text-primary-foreground" data-print-hide>
    <div class="container max-w-5xl space-y-4">
      <p class="m-0 text-xs font-bold uppercase tracking-wider text-[#ff917e]">ACADEMIA CASOABERTO · FERRAMENTA ABERTA</p>
      <h1 class="m-0 max-w-4xl text-3xl md:text-5xl">{magnet.title}</h1>
      <p class="max-w-3xl text-lg text-white/85">{magnet.tagline}</p>
      <div class="flex flex-wrap gap-4">
        <button type="button" onclick="window.print()" class="cursor-pointer border border-white bg-white px-5 py-3 font-semibold text-primary">Imprimir ou salvar como PDF</button>
        <a class="inline-block border border-white/60 px-5 py-3 font-semibold text-white" href={programUrl}>Conhecer a trilha educativa ↗</a>
      </div>
    </div>
  </header>
  <article class="container max-w-4xl space-y-6 py-9" aria-label="Ficha introdutória">
    <div class="flex flex-wrap items-baseline justify-between gap-3 border-b-4 border-brand pb-3">
      <div>
        <p class="m-0 text-xs font-bold uppercase tracking-wider text-brand-strong">CASOABERTO · FICHA GRATUITA</p>
        <h2 class="my-2 text-2xl">{magnet.title}</h2>
        <p class="m-0 text-sm text-muted-foreground">{magnet.kind} · Revisto em {catalog.reviewed_at.split('-').reverse().join('/')}</p>
      </div>
      <span class="text-xs font-semibold text-muted-foreground">Uso pessoal · não enviar</span>
    </div>
    <p class="m-0 text-sm leading-relaxed">{magnet.intro}</p>
    <ol class="grid list-none gap-3 p-0 sm:grid-cols-2">
      {magnet.steps.map((step, i) => <li class:list={["break-inside-avoid border border-border bg-card p-4", i === 4 && "sm:col-span-2"]}>
        <div class="mb-2 flex items-center gap-3"><span class="text-lg font-bold text-brand-strong">{String(i+1).padStart(2,'0')}</span><h3 class="m-0 text-base">{step.heading}</h3></div>
        <p class="m-0 text-sm">{step.prompt}</p>
      </li>)}
    </ol>
    <section class="break-inside-avoid space-y-3 border-t-2 border-foreground pt-4">
      <h2 class="m-0 text-lg">Registre suas respostas, sem dados pessoais de terceiros</h2>
      {magnet.fields.map((field, i) => <div class="space-y-1"><strong class="block text-xs">{i+1}. {field}</strong><div class="h-8 border-b border-dashed border-foreground/60"></div></div>)}
    </section>
    <p class="break-inside-avoid border-l-4 border-brand bg-muted p-4 text-sm"><strong>O que esta ficha não demonstra:</strong> {magnet.limits}</p>
    <p class="text-xs text-muted-foreground">Recurso educativo gratuito; esta página não coleta, transmite, armazena ou envia suas respostas. O material completo de formação continua reservado.</p>
    <div class="flex flex-wrap gap-4" data-print-hide>
      <a class="text-link" href={'/autonomia-digital/guias/'+magnet.entry_slug+'/'}>{magnet.cta} ↗</a>
      <a class="text-link" href={programUrl}>Conhecer o programa em desenvolvimento ↗</a>
    </div>
  </article>
</BaseLayout>
