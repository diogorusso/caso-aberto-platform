---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import ConsumerRiskWarning from '../components/ConsumerRiskWarning.astro';
import { cases, brl, reports, metrics, updates, dateBR } from '../lib/cases';
const featured = cases[0];
const reportCount = reports.length;
const updateCount = updates.length;
---
<BaseLayout
  title="CasoAberto | O consumidor tem voz. A empresa precisa responder."
  description="Publicação independente que transforma reclamações documentadas em dossiês públicos, com evidências, cronologia, impacto financeiro e perguntas institucionais."
  breadcrumbs={[{name:'Início', item:'/'}]}
>
  <section class="home-hero">
    <div class="container">
      <div class="eyebrow light"><span class="signal"></span> PUBLICAÇÃO INDEPENDENTE DE ACCOUNTABILITY</div>
      <h1>O consumidor tem voz.<br /><em>A empresa precisa responder.</em></h1>
      <p class="hero-lead">Transformamos reclamações documentadas em dossiês públicos, organizamos evidências, acompanhamos respostas e damos visibilidade a problemas que não podem ser simplesmente ignorados.</p>
      <div class="hero-buttons">
        <a class="button button-primary" href="/casos/florense-ipanema-rj-atraso-moveis-planejados/">Abrir dossiê CA-001 ↗</a>
        <a class="button button-ghost" href="/guias/risco-pagamento-antecipado-moveis-planejados/">Alerta: pagamento antecipado</a>
      </div>
      <div class="hero-note"><span>!</span><span>Não somos governo, Procon, tribunal nem escritório de advocacia. Somos uma redação independente de evidências públicas.</span></div>
    </div>
    <div class="hero-accent" aria-hidden="true">CA</div>
  </section>

  <section class="section">
    <div class="container home-stats">
      <div><small>Casos publicados</small><strong>{metrics.platform.published_cases}</strong></div>
      <div><small>Relatos públicos indexados</small><strong>{reportCount}</strong></div>
      <div><small>Atualizações editoriais</small><strong>{updateCount}</strong></div>
      <div><small>Exposição no caso destaque</small><strong>{featured?.valor_brl ? brl(featured.valor_brl) : '—'}</strong></div>
    </div>
  </section>

  <section class="section case-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <div class="eyebrow">CASO EM ANDAMENTO</div>
          <h2>Florense Ipanema — R$ 190 mil em disputa de entrega</h2>
        </div>
        <a href="/casos/" class="text-link">Arquivo de casos ↗</a>
      </div>
      {featured && <CaseCard item={featured} featured />}
      <p class="evidence-legend">Distinção editorial: fatos documentados (protocolos, links públicos, datas) ≠ relatos do consumidor ≠ hipóteses não verificadas.</p>
    </div>
  </section>

  <section class="dossier-feature"><div class="container"><span class="eyebrow">DOSSIÊ CORPORATIVO DA FLORENSE</span><h2>383 reclamações no histórico público da marca. Veja os dados da empresa.</h2><p>Pesquisa sobre a fabricante, a franqueada de Ipanema, 55 lojas no Brasil e 14 nas Américas declaradas em 2026, capital social, dirigentes públicos e declarações sobre produção. Todas as estatísticas têm fontes e períodos.</p><div class="feature-links"><a class="button button-dark" href="/empresas/florense/">Abrir dossiê completo ↗</a><a class="button button-subtle" href="/empresas/florense/ipanema-rj/">Unidade Ipanema ↗</a></div></div></section>
  <section class="section">
    <div class="container">
      <ConsumerRiskWarning />
    </div>
  </section>

  <section class="section intro-section">
    <div class="container section-top">
      <span class="eyebrow">COMO INVESTIGAMOS</span>
      <h2>Dossiê permanente. Evidência rastreável. Pressão por resposta.</h2>
      <p>Cada caso reúne cronologia, fontes, impacto financeiro informado, liderança pública verificável e perguntas em aberto — pronto para busca, imprensa e compartilhamento.</p>
    </div>
    <div class="container service-grid">
      <article><span class="service-n">01 / DOSSIÊ</span><h3>Endereço indexável</h3><p>Uma URL permanente por caso, com SEO, compartilhamento e histórico de status.</p></article>
      <article><span class="service-n">02 / EVIDÊNCIAS</span><h3>Fontes com data e status</h3><p>Reclamações públicas, protocolos e registros institucionais, sem inventar depoimentos.</p></article>
      <article><span class="service-n">03 / ACCOUNTABILITY</span><h3>Quem pode responder</h3><p>Mapa de papéis públicos, canais oficiais e perguntas objetivas — sem assédio pessoal.</p></article>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container two-col">
      <div>
        <span class="eyebrow">ÚLTIMAS ATUALIZAÇÕES</span>
        <h2>O que mudou no arquivo</h2>
        <ul class="home-updates">
          {updates.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,3).map((u) => (
            <li><time datetime={u.date}>{dateBR(u.date)}</time><strong>{u.title}</strong><span>{u.summary}</span></li>
          ))}
        </ul>
        <a class="text-link" href="/casos/florense-ipanema-rj-atraso-moveis-planejados/atualizacoes/">Ver todas as atualizações ↗</a>
      </div>
      <div>
        <span class="eyebrow">PARTICIPE</span>
        <h2>Também foi afetado?</h2>
        <p>Envie um relato factual com links públicos. Publicamos apenas após revisão e consentimento.</p>
        <a class="button button-dark" href="/casos/florense-ipanema-rj-atraso-moveis-planejados/#apoiar">Apoiar / enviar evidência ↗</a>
        <p class="muted" style="margin-top:18px">Imprensa: use o kit em cada dossiê. Empresas: respondam pelos canais oficiais documentados.</p>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <span class="eyebrow light">NÃO IGNORE O RISCO</span>
      <h2>Na dúvida, procure outro fornecedor.</h2>
      <div class="hero-buttons">
        <a class="button button-white" href="/guias/risco-pagamento-antecipado-moveis-planejados/">Ler alerta Roma Mobili ↗</a>
        <a class="button button-outline" href="/casos/florense-ipanema-rj-atraso-moveis-planejados/imprensa/">Kit para imprensa</a>
      </div>
    </div>
  </section>
</BaseLayout>
