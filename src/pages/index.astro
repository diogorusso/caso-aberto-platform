---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import { cases, reports } from '../lib/cases';
import { brands, ratingDefinitions } from '../lib/brands';
import registries from '../data/company-profiles.json';

const publishedCases = cases.slice().sort((a,b) => b.status_data.localeCompare(a.status_data));
const newestCases = publishedCases.slice(0,3);
const reviewedCompanies = brands.length;
const reviewedUnits = brands.reduce((total, brand) => total + brand.units.filter(unit => unit.published).length, 0);
const companyStatuses = ratingDefinitions.slice().sort((a,b) => b.sort - a.sort);
const steps = [
  {number:'01',eyebrow:'PERFIS EMPRESARIAIS',title:'Conheça quem está por trás do contrato.',description:'Razão social, CNPJ, administradores, unidades, vínculos e histórico público — com fontes para consulta.',href:'/empresas/',link:'Explorar empresas'},
  {number:'02',eyebrow:'CASOS DOCUMENTADOS',title:'Entenda os fatos antes de decidir.',description:'Valores relatados, cronologias, registros, reclamações originais, atualizações e pedidos de resposta.',href:'/casos/',link:'Explorar casos'},
  {number:'03',eyebrow:'AVALIAÇÕES EDITORIAIS',title:'Saiba quando recomendamos cautela.',description:'Recomendação com escopo definido, fundamentos públicos, data de revisão e critérios para reavaliação.',href:'/avaliacoes/nao-recomendamos/',link:'Ver avaliações'}
];
const pathways = [
  {number:'01',title:'Avaliações de empresas',description:'Consulte perfis e recomendações por empresa e unidade.',href:'/empresas/',link:'Buscar empresas'},
  {number:'02',title:'Casos e reclamações',description:'Leia os dossiês, as fontes originais e o histórico.',href:'/casos/',link:'Ver casos'},
  {number:'03',title:'Tipos de problema',description:'Pesquise atrasos, montagem, atendimento e outros temas documentados.',href:'/problemas/',link:'Explorar temas'},
  {number:'04',title:'Cadastro CNPJ',description:'Confira atividades, capital registrado e vínculos societários publicados.',href:'/cnpj/',link:'Consultar CNPJs'}
];
---
<BaseLayout
  title="CasoAberto — Consulte empresas, avaliações e casos antes de contratar"
  description="O CasoAberto reúne perfis empresariais, CNPJ, casos documentados, reclamações públicas e avaliações editoriais com fontes. Pesquise antes de contratar."
  breadcrumbs={[{name:'Início',item:'/'}]}
>
  <section class="home-hero platform-hero" aria-labelledby="platform-home-title">
    <div class="container">
      <div class="eyebrow light"><span class="signal" aria-hidden="true"></span> CASOABERTO · TRANSPARÊNCIA PARA O CONSUMIDOR</div>
      <h1 id="platform-home-title">Antes de contratar,<br /><em>conheça os fatos.</em></h1>
      <p class="hero-lead">Empresas têm histórico. Consumidores merecem respostas. Reunimos perfis empresariais, reclamações, evidências e avaliações editoriais para você decidir com mais informação.</p>
      <div class="hero-buttons">
        <a class="button button-primary" href="/empresas/">Consultar empresas <span aria-hidden="true">↗</span></a>
        <a class="button button-ghost" href="/casos/">Explorar casos documentados <span aria-hidden="true">↗</span></a>
      </div>
      <p class="platform-hero-proof">Fontes públicas verificáveis <span aria-hidden="true">·</span> Critérios transparentes <span aria-hidden="true">·</span> Histórico atualizado por caso</p>
    </div>
    <div class="hero-accent" aria-hidden="true">CA</div>
  </section>

  <section class="platform-stats" aria-label="Arquivo publicado">
    <div class="container home-stats">
      <div><small>Empresas avaliadas</small><strong>{reviewedCompanies}</strong><span>Perfis com avaliação publicada</span></div>
      <div><small>Unidades identificadas</small><strong>{reviewedUnits}</strong><span>Avaliações com recorte local</span></div>
      <div><small>Casos publicados</small><strong>{publishedCases.length}</strong><span>Com cronologia e fontes</span></div>
      <div><small>Registros de reclamação</small><strong>{reports.length}</strong><span>Links para publicações originais</span></div>
    </div>
    <div class="container platform-stats-caption">Contagens do arquivo CasoAberto nesta versão, não estatísticas do mercado brasileiro. <a href="/metodologia/">Como organizamos os dados ↗</a></div>
  </section>

  <section class="section platform-explore" aria-labelledby="explore-title">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">COMECE SUA PESQUISA</span><h2 id="explore-title">O que você quer verificar?</h2></div>
        <a class="text-link" href="/como-funciona/">Como funciona o CasoAberto ↗</a>
      </div>
      <div class="platform-pathways">
        {pathways.map(path => <article class="platform-path">
          <span class="platform-path-number">{path.number} / PESQUISAR</span>
          <h3>{path.title}</h3>
          <p>{path.description}</p>
          <a href={path.href}>{path.link} <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section section-soft platform-value" aria-labelledby="platform-value-title">
    <div class="container section-top">
      <span class="eyebrow">O QUE FAZEMOS</span>
      <h2 id="platform-value-title">Não basta reclamar. <em>É preciso mostrar os fatos.</em></h2>
      <p>Organizamos dados de empresas e casos em páginas permanentes, documentadas e fáceis de encontrar, verificar e compartilhar.</p>
    </div>
    <div class="container service-grid">
      {steps.map(step => <article>
        <span class="service-n">{step.number} / {step.eyebrow}</span>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
        <a class="platform-service-link" href={step.href}>{step.link} <span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
  </section>

  <section class="section platform-statuses" aria-labelledby="statuses-title">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">AVALIAÇÃO EDITORIAL</span><h2 id="statuses-title">Uma recomendação. Com motivos e fontes.</h2></div>
        <a class="text-link" href="/metodologia/#avaliacao-editorial">Consultar os critérios ↗</a>
      </div>
      <p class="platform-section-lead">Classificações relacionadas a evidências e ao tipo de contratação analisado. Cada empresa tem sua própria página, documentos, escopo e data de revisão.</p>
      <div class="platform-status-grid">
        {companyStatuses.map(status => <article class={'platform-status status-'+status.code}>
          <span class="platform-status-label">{status.label}</span>
          <p>{status.explanation}</p>
          <a href="/empresas/">Ver empresas e fundamentos <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </section>

  {newestCases.length>0 && <section class="section case-section" aria-labelledby="home-cases-title">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">ARQUIVO PÚBLICO</span><h2 id="home-cases-title">Casos documentados</h2><p class="platform-section-lead">Cada caso possui um endereço próprio, cronologia, status e referências para acompanhar o desfecho.</p></div>
        <a class="text-link" href="/casos/">Todos os casos ↗</a>
      </div>
      <div class="platform-cases">
        {newestCases.map((item,i) => <CaseCard item={item} featured={i===0}/>)}
      </div>
    </div>
  </section>}

  <section class="section platform-research" aria-labelledby="research-title">
    <div class="container platform-research-layout">
      <div>
        <span class="eyebrow">PESQUISA DOCUMENTAL</span>
        <h2 id="research-title">O cadastro da empresa é parte da história.</h2>
        <p>Rastreie razão social, CNPJ, CNAE, administradores e vínculos empresariais para entender quem fabrica, vende ou presta o serviço. Relacionamos os registros aos casos somente quando há fontes para sustentar esse vínculo.</p>
        <div class="hero-buttons">
          <a class="button button-dark" href="/cnpj/">Explorar {registries.entities.length} cadastros publicados ↗</a>
          <a class="button button-subtle" href="/problemas/">Pesquisar problemas ↗</a>
        </div>
      </div>
      <aside class="platform-research-note">
        <span class="eyebrow">TRANSPARÊNCIA EDITORIAL</span>
        <h3>O histórico não é uma sentença.</h3>
        <p>Separamos o relato do consumidor, as fontes independentes, as respostas da empresa e a análise editorial. Uma solução confirmada deve aparecer no arquivo, assim como uma pendência.</p>
        <a class="text-link" href="/metodologia/">Ler metodologia ↗</a>
      </aside>
    </div>
  </section>

  <section class="final-cta platform-final">
    <div class="container">
      <span class="eyebrow light">DECISÕES MAIS INFORMADAS</span>
      <h2>Mais transparência.<br/>Mais responsabilidade.</h2>
      <p>Pesquise antes de contratar. Acompanhe os casos depois. Compartilhe informações que possam ser verificadas.</p>
      <div class="hero-buttons">
        <a class="button button-white" href="/empresas/">Consultar empresas ↗</a>
        <a class="button button-outline" href="/como-funciona/">Entenda nossa proposta ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>