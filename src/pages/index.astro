---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import {categories,featuredCase,caseStudies,personalStories,caseCountFor,categoryHref} from '../lib/case-catalog';
import {casePath} from '../lib/cases';
import { brands, ratingDefinitions } from '../lib/brands';
import registries from '../data/company-profiles.json';
import Section from '../components/layout/Section.astro';
import Eyebrow from '../components/layout/Eyebrow.astro';
import ButtonLink from '../components/layout/ButtonLink.astro';
import ResearchMetrics from '../components/ResearchMetrics.astro';
import ResearchBenchmarks from '../components/ResearchBenchmarks.astro';
import CaseActionBar from '../components/CaseActionBar.astro';
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from '../components/ui/card';

const companyStatuses = ratingDefinitions.slice().sort((a,b) => b.sort - a.sort);
const steps = [
  {number:'01',eyebrow:'PERFIS EMPRESARIAIS',title:'Conheça quem está por trás do contrato.',description:'Razão social, CNPJ, administradores, unidades, vínculos e histórico público — com fontes para consulta.',href:'/empresas/',link:'Explorar empresas'},
  {number:'02',eyebrow:'CASOS DOCUMENTADOS',title:'Entenda os fatos antes de decidir.',description:'Valores relatados, cronologias, registros, reclamações originais, atualizações e pedidos de resposta.',href:'/casos/',link:'Explorar casos'},
  {number:'03',eyebrow:'PRECEDENTES E CENÁRIOS',title:'Mostre onde uma disputa pode chegar.',description:'Comparamos processos de falência e recuperação, créditos de consumidores, datas e consequências reais — sem inventar previsões.',href:'/precedentes/',link:'Explorar processos e cenários'}
];
const statusBorder: Record<string,string> = { nao_recomendamos: 'border-t-brand-strong', cautela: 'border-t-warning', recomendamos: 'border-t-success'};
const pathways = [
  {number:'01',title:'Avaliações de empresas',description:'Consulte perfis e recomendações por empresa e unidade.',href:'/empresas/',link:'Buscar empresas'},
  {number:'02',title:'Casos e reclamações',description:'Leia os dossiês, as fontes originais e o histórico.',href:'/casos/',link:'Ver casos'},
  {number:'03',title:'Precedentes judiciais',description:'Falências, recuperações e valores de contratos não entregues — com decisões e cronologias.',href:'/precedentes/',link:'Ver precedentes'},
  {number:'04',title:'Cadastro CNPJ',description:'Confira atividades, capital registrado e vínculos societários publicados.',href:'/cnpj/',link:'Consultar CNPJs'}
];
---
<BaseLayout
  title="CasoAberto — Pesquisa, organização e autonomia digital para agir"
  description="Investigue casos, verifique dados, organize demandas, acompanhe instituições e aprenda autonomia digital com fontes e ferramentas abertas."
  breadcrumbs={[{name:'Início',item:'/'}]}
>
  <section class="relative overflow-hidden bg-primary py-14 text-primary-foreground md:py-24" aria-labelledby="platform-home-title">
    <div class="container relative z-10 space-y-7">
      <Eyebrow inverse class="flex items-center gap-2.5"><span class="size-2 bg-brand" aria-hidden="true"></span> CASOABERTO · PESQUISA, AUTONOMIA E AÇÃO CIDADÃ</Eyebrow>
      <h1 id="platform-home-title" class="m-0 max-w-5xl text-5xl leading-[0.98] tracking-[-0.06em] sm:text-6xl lg:text-8xl">O consumidor cobra.<br /><em class="text-[#ff917e] not-italic">Quem responde?</em></h1>
      <p class="m-0 max-w-2xl text-lg leading-relaxed text-white/75 md:text-xl">Dados públicos, pesquisa verificável e tecnologia a serviço de quem precisa de respostas. Investigue empresas, instituições e plataformas, organize demandas coletivas e aprenda a controlar sua presença digital.</p>
      <div class="flex flex-wrap gap-2.5">
        <ButtonLink variant="brand" size="lg" href="/casos/">Investigar os casos <span aria-hidden="true">↗</span></ButtonLink>
        {featuredCase&&<ButtonLink variant="outline-inverse" size="lg" href={casePath(featuredCase)}>Caso em destaque <span aria-hidden="true">↗</span></ButtonLink>}
      </div>
      <p class="m-0 border-t border-white/15 pt-6 text-sm font-medium text-white/60">Evidências rastreáveis <span aria-hidden="true" class="text-brand">·</span> Organização cidadã <span aria-hidden="true" class="text-brand">·</span> Autonomia e direitos digitais</p>
    </div>
    <div class="pointer-events-none absolute -right-4 -bottom-32 hidden text-[min(50vw,40rem)] leading-none font-black tracking-[-0.12em] text-forest select-none lg:block" aria-hidden="true">CA</div>
  </section>

  <ResearchMetrics/>

  {featuredCase&&<Section eyebrow="CASO EM DESTAQUE · A COBRANÇA COMEÇA AQUI" title="R$ 190 mil pagos. Prazo estourado. Cadê os móveis?" description="A contratação da unidade de Ipanema abriu o arquivo CasoAberto. O consumidor pagou. A entrega não ocorreu no prazo relatado. Contrato, cronologia, empresa e perguntas estão publicados.">
    <a slot="action" class="text-link font-semibold" href={casePath(featuredCase)}>Acompanhar o caso em destaque ↗</a>
    <CaseCard item={featuredCase} featured/>
    <CaseActionBar title={featuredCase.titulo} summary={featuredCase.resumo} href={casePath(featuredCase)} caseId={featuredCase.id} printHref={"/casos/imprimir/"+featuredCase.slug+"/"}/>
   </Section>}
  <Section tone="muted" eyebrow="ACERVO DE PESQUISA" title="Não é só um problema. São setores inteiros cobrados." description="Viagens, entregas, móveis, energia e política. Todas as pesquisas do CasoAberto estão organizadas num único arquivo, com buscas por empresa, cidade, problema e categoria.">
    <a slot="action" class="text-link font-semibold" href="/casos/#pesquisar-casos">Pesquisar todos os casos ↗</a>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {categories.map(cat=><a class="flex flex-col gap-4 rounded-lg border border-border bg-card p-5 no-underline hover:border-brand/60" href={categoryHref(cat)}>
       <span class="text-xs font-extrabold uppercase tracking-wider text-brand-strong">{cat.eyebrow}</span>
       <h3 class="m-0 text-xl text-foreground">{cat.title}</h3>
       <p class="m-0 flex-1 text-sm leading-relaxed text-muted-foreground">{cat.description}</p>
       <span class="text-sm font-semibold text-link">{caseCountFor(cat.slug)} casos · Conferir ↗</span>
      </a>)}
    </div>
    <p class="mb-0 mt-5 text-sm font-semibold">{caseStudies.length} casos documentados · {personalStories.length} histórias de consumidores. <a class="text-link" href="/historias/">Leia as histórias que movimentam cada caso ↗</a></p>
  </Section>

  <ResearchBenchmarks/>

  <Section eyebrow="DO DADO À AÇÃO" title="Três capacidades para não depender de intermediários." description="O CasoAberto combina investigação pública, organização por consentimento e educação técnica. Casos de consumo são uma das aplicações — não o limite do projeto.">
    <div class="grid gap-4 md:grid-cols-3">
      {[
        {title:'Instituto de dados',description:'Protocolos, fontes originais, casos, respostas, pesquisas e observatórios públicos com escopo e revisão.',href:'/instituto/',link:'Pesquisar com método'},
        {title:'Organização cidadã',description:'Da causa individual à demanda comunitária: documentar, reunir, publicar pedidos e acompanhar resultados.',href:'/organizar/',link:'Aprender a organizar'},
        {title:'Autonomia digital',description:'Fingerprinting, algoritmos, IA, fraudes, segurança e direitos para entender e controlar tecnologias.',href:'/autonomia-digital/',link:'Começar a aprender'}
      ].map(pillar => (
        <Card className="h-full">
          <CardHeader><CardTitle className="text-xl">{pillar.title}</CardTitle></CardHeader>
          <CardContent className="text-sm text-muted-foreground">{pillar.description}</CardContent>
          <CardFooter className="mt-auto"><a class="text-link text-sm" href={pillar.href}>{pillar.link} ↗</a></CardFooter>
        </Card>
      ))}
    </div>
  </Section>

  <Section eyebrow="COMECE SUA PESQUISA" title="O que você quer verificar?">
    <a slot="action" class="text-link text-sm" href="/como-funciona/">Como funciona o CasoAberto ↗</a>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {pathways.map(path => (
        <Card className="h-full">
          <CardHeader className="gap-3">
            <span class="font-mono text-xs font-semibold text-brand-strong">{path.number} / PESQUISAR</span>
            <CardTitle className="text-xl">{path.title}</CardTitle>
          </CardHeader>
          <CardContent className="text-sm text-muted-foreground">{path.description}</CardContent>
          <CardFooter className="mt-auto"><a class="text-link text-sm" href={path.href}>{path.link} <span aria-hidden="true">↗</span></a></CardFooter>
        </Card>
      ))}
    </div>
  </Section>

  <Section tone="muted" eyebrow="O QUE FAZEMOS" description="Transformamos conflitos individuais em dossiês pesquisáveis, com indicadores de impacto, precedentes judiciais comparáveis e perguntas que cobram resolução. Cada afirmação aponta para sua fonte.">
    <Fragment slot="title">Não basta reclamar. <em class="text-brand-strong not-italic">É preciso mostrar os fatos.</em></Fragment>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map(step => (
        <Card className="h-full">
          <CardHeader className="gap-3">
            <span class="text-xs font-semibold tracking-wider text-brand-strong">{step.number} / {step.eyebrow}</span>
            <CardTitle className="text-xl leading-snug">{step.title}</CardTitle>
          </CardHeader>
          <CardContent className="text-sm text-muted-foreground">{step.description}</CardContent>
          <CardFooter className="mt-auto"><a class="text-link text-sm" href={step.href}>{step.link} <span aria-hidden="true">↗</span></a></CardFooter>
        </Card>
      ))}
    </div>
  </Section>

  <Section eyebrow="AVALIAÇÃO EDITORIAL" title="Uma recomendação. Com motivos e fontes." description="Classificações relacionadas a evidências e ao tipo de contratação analisado. Cada empresa tem sua própria página, documentos, escopo e data de revisão.">
    <a slot="action" class="text-link text-sm" href="/metodologia/#avaliacao-editorial">Consultar os critérios ↗</a>
    <div class="grid gap-4 md:grid-cols-3">
      {companyStatuses.map(status => (
        <Card className={'h-full border-t-4 bg-muted shadow-none '+ (statusBorder[status.code] ?? '')}>
          <CardHeader><CardTitle className="text-lg">{status.label}</CardTitle></CardHeader>
          <CardContent className="text-sm text-muted-foreground">{status.explanation}</CardContent>
          <CardFooter className="mt-auto"><a class="text-link text-sm" href="/empresas/">Ver empresas e fundamentos <span aria-hidden="true">↗</span></a></CardFooter>
        </Card>
      ))}
    </div>
  </Section>

  <section class="bg-forest py-14 text-forest-foreground md:py-20" aria-labelledby="kit-home-title" data-print-hide>
    <div class="container grid gap-10 lg:grid-cols-[1.3fr_0.9fr] lg:items-center">
      <div class="space-y-4">
        <Eyebrow inverse>AÇÃO PÚBLICA COM DOCUMENTOS</Eyebrow>
        <h2 id="kit-home-title" class="m-0">Quando a empresa não resolve, o problema não pode ficar invisível.</h2>
        <p class="m-0 max-w-2xl text-lg text-white/75">Explore os cenários de impacto e leve os fatos adiante: cartazes e panfletos com QR code, fontes e modelos prontos para imprimir. A denúncia ganha alcance sem perder a documentação.</p>
        <div class="flex flex-wrap gap-2.5 pt-2">
          <ButtonLink variant="inverse" size="lg" href="/kit-boca-a-boca/">Abrir Kit Boca a Boca ↗</ButtonLink>
          <ButtonLink variant="outline-inverse" size="lg" href="/cenarios/">Explorar cenários ↗</ButtonLink>
        </div>
      </div>
      <ol class="m-0 grid list-none gap-px overflow-hidden border border-white/15 bg-white/15 p-0">
        {[['01 / INVESTIGAR','Quanto custou? Quem responde?'],['02 / EXPLORAR','Quais cenários podem afetar o consumidor?'],['03 / MOBILIZAR','Como levar os fatos para mais pessoas?']].map(([k,v]) => (
          <li class="bg-forest p-5"><span class="block text-xs font-semibold tracking-wider text-brand">{k}</span><strong class="mt-1 block text-lg">{v}</strong></li>
        ))}
      </ol>
    </div>
  </section>

  <Section tone="card">
    <div class="grid gap-10 lg:grid-cols-[1.5fr_0.8fr] lg:items-center">
      <div class="space-y-4">
        <Eyebrow>PESQUISA DOCUMENTAL</Eyebrow>
        <h2 id="research-title" class="m-0">O cadastro da empresa é parte da história.</h2>
        <p class="m-0 max-w-2xl text-lg text-muted-foreground">Rastreie razão social, CNPJ, CNAE, administradores e vínculos empresariais para entender quem fabrica, vende ou presta o serviço. Relacionamos os registros aos casos somente quando há fontes para sustentar esse vínculo.</p>
        <div class="flex flex-wrap gap-2.5 pt-2">
          <ButtonLink href="/cnpj/">Explorar {registries.entities.length} cadastros publicados ↗</ButtonLink>
          <ButtonLink variant="outline" href="/problemas/">Pesquisar problemas ↗</ButtonLink>
        </div>
      </div>
      <aside class="space-y-3 border-l-4 border-brand bg-muted p-6">
        <Eyebrow>TRANSPARÊNCIA EDITORIAL</Eyebrow>
        <h3 class="m-0">O histórico não é uma sentença.</h3>
        <p class="m-0 text-sm text-muted-foreground">Separamos o relato do consumidor, as fontes independentes, as respostas da empresa e a análise editorial. Uma solução confirmada deve aparecer no arquivo, assim como uma pendência.</p>
        <a class="text-link text-sm" href="/metodologia/">Ler metodologia ↗</a>
      </aside>
    </div>
  </Section>

  <section class="bg-forest py-16 text-forest-foreground md:py-24">
    <div class="container space-y-5">
      <Eyebrow inverse>DECISÕES MAIS INFORMADAS</Eyebrow>
      <h2 class="m-0 max-w-4xl text-4xl sm:text-5xl lg:text-7xl">Dados para compreender.<br/>Ferramentas para agir.</h2>
      <p class="m-0 max-w-2xl text-lg text-white/75">Investigue com fontes. Organize sem perder o controle da sua identidade, dos seus dados e das suas decisões.</p>
      <div class="flex flex-wrap gap-2.5 pt-2">
        <ButtonLink variant="inverse" size="lg" href="/instituto/">Pesquisar com o instituto ↗</ButtonLink>
        <ButtonLink variant="outline-inverse" size="lg" href="/autonomia-digital/diagnostico/">Diagnóstico digital gratuito ↗</ButtonLink>
      </div>
    </div>
  </section>
</BaseLayout>
