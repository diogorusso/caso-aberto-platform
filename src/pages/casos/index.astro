---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseCard from '../../components/CaseCard.astro';
import CaseResearchExplorer from '../../components/islands/CaseResearchExplorer';
import {categories,featuredCase,caseStudies,personalStories,allResearch,caseCountFor,categoryHref} from '../../lib/case-catalog';
---
<BaseLayout title="Casos documentados: empresas, problemas e histórias | CasoAberto" description="Pesquise todos os casos documentados do CasoAberto: Florense em destaque, viagens, móveis, compras online, energia, doze histórias e provas para conferir.">
 <Breadcrumbs items={[{label:'Início',href:'/'},{label:'Casos',href:'/casos/'}]}/>
 <header class="bg-primary py-14 text-primary-foreground md:py-20">
  <div class="container space-y-5">
   <p class="m-0 text-xs font-extrabold uppercase tracking-[.18em] text-[#ff917e]">CASOABERTO · PESQUISA DOCUMENTADA</p>
   <h1 class="m-0 max-w-5xl text-4xl leading-[1.05] tracking-tight sm:text-5xl lg:text-7xl">Pagou. Não recebeu. <span class="text-[#ff917e]">Cadê a resposta?</span></h1>
   <p class="m-0 max-w-3xl text-lg leading-relaxed text-white/80">Móveis, viagens, compras e energia. Empresas e instituições aparecem com seus nomes, fatos, fontes e perguntas. Encontre o seu problema. Veja quem foi cobrado. Confira o resultado.</p>
   <div class="flex flex-wrap gap-3 text-sm font-semibold text-white/80"><span>{caseStudies.length} casos documentados</span><span aria-hidden="true">·</span><span>{personalStories.length} histórias de consumidores</span><span aria-hidden="true">·</span><span>{categories.length} categorias</span></div>
  </div>
 </header>
 {featuredCase&&<section class="py-14 md:py-18" aria-labelledby="caso-destaque">
  <div class="container space-y-6">
   <div class="flex flex-wrap items-end justify-between gap-4"><div class="space-y-2"><p class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">CASO EM DESTAQUE · INVESTIGAÇÃO CASOABERTO</p><h2 id="caso-destaque" class="m-0 text-3xl md:text-4xl">R$ 190 mil pagos. A entrega ficou para quando?</h2><p class="m-0 text-muted-foreground">Florense Ipanema. Contrato, cronologia, perguntas, fontes e atualizações do caso que abriu o arquivo.</p></div><a class="text-link font-semibold" href={'/casos/'+featuredCase.slug+'/'}>Acompanhar o caso completo ↗</a></div>
   <CaseCard item={featuredCase} featured/>
  </div>
 </section>}
 <section class="border-y bg-muted py-12" aria-labelledby="categorias-casos">
  <div class="container space-y-7"><div><p class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">ENCONTRE O PROBLEMA</p><h2 id="categorias-casos" class="mb-2 mt-3 text-3xl">Quatro categorias. Toda a pesquisa.</h2><p class="m-0 text-muted-foreground">Escolha um assunto ou pesquise por empresa, cidade, serviço e documento.</p></div>
   <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">{categories.map(cat=><a class="group flex flex-col gap-3 rounded-lg border border-border bg-card p-5 no-underline hover:border-brand/60 focus-visible:ring-2 focus-visible:ring-brand" href={categoryHref(cat)}><span class="text-xs font-bold uppercase tracking-widest text-brand-strong">{cat.eyebrow}</span><strong class="text-xl text-foreground">{cat.title}</strong><p class="m-0 flex-1 text-sm leading-relaxed text-muted-foreground">{cat.description}</p><span class="text-sm font-semibold text-link">{caseCountFor(cat.slug)} casos · Explorar ↗</span></a>)}</div>
  </div>
 </section>
 <section class="container space-y-7 py-14" id="pesquisar-casos">
  <CaseResearchExplorer client:idle entries={allResearch} categories={categories}/>
 </section>
 <section class="border-t bg-card py-10"><div class="container flex flex-wrap items-center justify-between gap-5"><div><p class="m-0 text-xs font-bold uppercase tracking-wider text-brand-strong">PODER E INSTITUIÇÕES</p><h2 class="mb-2 mt-3 text-2xl">Quando o poder decide, quem presta contas?</h2><p class="m-0 max-w-3xl text-muted-foreground">Bets, recursos públicos, direitos eleitorais e instituições. Cada investigação tem documentos, datas, perguntas e responsáveis identificados.</p></div><a class="text-link font-semibold" href="/observatorio/politica/">Examinar as investigações ↗</a></div></section>
<section class="border-t bg-card py-12"><div class="container grid gap-6 md:grid-cols-[1fr_auto] md:items-center"><div><h2 class="m-0 text-2xl">O consumidor cobra. A empresa precisa responder.</h2><p class="mb-0 mt-2 max-w-3xl text-muted-foreground">Cada caso liga o problema à sua cronologia e às fontes para consulta. Cada história ajuda a entender o custo de uma promessa não cumprida.</p></div><div class="flex flex-wrap gap-4"><a class="text-link font-semibold" href="/sobre/">Conheça o projeto ↗</a><a class="text-link font-semibold" href="/organizar/caderno-de-acao/">Registre seu problema ↗</a></div></div></section>
</BaseLayout>
