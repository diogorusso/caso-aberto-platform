---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseCard from '../../components/CaseCard.astro';
import { cases } from '../../lib/cases';
import atlas from '../../data/public-case-atlas.json';
import PublicCaseCard from '../../components/PublicCaseCard.astro';
---
<BaseLayout title="Casos documentados de consumidores | CasoAberto" description="Dossiês de consumo organizados em páginas públicas com prazos, reclamações, documentos, respostas e acompanhamento.">
  <Breadcrumbs items={[{label:'Início',href:'/'},{label:'Casos',href:'/casos/'}]} />
  <section class="border-b bg-card py-12 md:py-16 [&_h1]:my-4 [&_p]:max-w-3xl [&_p]:text-lg [&_p]:text-muted-foreground"><div class="container"><span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">ARQUIVO DE CASOS</span><h1>Casos abertos. Empresas cobradas.</h1><p>Cada caso tem cronologia, fontes, exigências e um placar simples: a empresa respondeu ou não. Quando resolve, registramos.</p></div></section>
  <section class="border-y bg-muted py-4 [&>.container]:flex [&>.container]:flex-wrap [&>.container]:gap-2.5"><div class="container"><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90" href="/empresas/">Consultar recomendações por empresa ↗</a><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 border bg-background text-foreground shadow-xs hover:bg-accent" href="/avaliacoes/nao-recomendamos/">Empresas que não recomendamos ↗</a></div></section>
  <section class="py-14 md:py-20 pt-10"><div class="container mt-4 space-y-5"><div><h2 class="m-0 text-3xl">Dossiês acompanhados diretamente</h2><p class="mt-2 max-w-4xl text-muted-foreground">Casos que o CasoAberto acompanha com arquivo próprio, cronologia, documentação e atualizações publicadas. Não confundir com pesquisa baseada em fontes de terceiros.</p></div>{cases.map((item)=><CaseCard item={item}/>)}</div></section>
<section class="border-t bg-muted py-14"><div class="container space-y-7"><div class="flex flex-wrap items-end justify-between gap-5"><div class="space-y-3"><p class="m-0 text-xs font-bold uppercase tracking-wider text-brand-strong">CASOS PÚBLICOS PESQUISADOS</p><h2 class="m-0 text-3xl">Outros problemas já viraram documento público.</h2><p class="max-w-4xl text-muted-foreground">Pacotes de viagem não cumpridos, produtos não entregues e interrupções de energia: Procons, decisões e reportagens registram as perguntas que continuam relevantes. São pesquisas de fontes externas, não apurações contratuais próprias.</p></div><a class="text-link font-semibold" href="/casos/arquivo-publico/">Abrir arquivo público completo ↗</a></div><div class="grid gap-4 md:grid-cols-2">{atlas.cases.map(study=><PublicCaseCard study={study} compact/>)}</div></div></section>
<section class="container space-y-6 py-14"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="m-0 text-xs font-bold uppercase tracking-wider text-brand-strong">HISTÓRIAS DE PESSOAS · ATRIBUÍDAS</p><h2 class="mt-2 text-3xl">O problema não cabe numa planilha.</h2><p class="max-w-3xl text-muted-foreground">Seis histórias já publicadas por imprensa e consumidores, resumidas com atribuição e data. Nenhum depoimento é apresentado como entrevista do CasoAberto.</p></div><a class="text-link" href="/historias/">Ler todas as histórias ↗</a></div><div class="grid gap-4 md:grid-cols-3">{atlas.stories.slice(0,3).map(person=><a class="block border border-border bg-card p-5" href={'/historias/'+person.slug+'/'}><p class="m-0 text-xs font-bold text-brand-strong">{person.category}</p><h3 class="mt-3 text-lg">{person.headline}</h3><p class="text-sm text-muted-foreground">{person.deck}</p><span class="text-link text-sm">Ler relato e fontes ↗</span></a>)}</div></section>
</BaseLayout>
<style>.case-list {display:grid;gap:20px}</style>
