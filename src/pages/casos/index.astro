---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseCard from '../../components/CaseCard.astro';
import CaseActionBar from '../../components/CaseActionBar.astro';
import CaseResearchExplorer from '../../components/islands/CaseResearchExplorer';
import {categories,featuredCase,caseStudies,personalStories,allResearch,caseCountFor,categoryHref} from '../../lib/case-catalog';
import {precedents,precedentPath} from '../../lib/precedents';
const educationPrecedents=precedents.filter(p=>p.segment.includes('Ensino superior'));

---
<BaseLayout title="Casos documentados: empresas, problemas e histórias | CasoAberto" description="Pesquise todos os casos documentados do CasoAberto: Florense em destaque, viagens, móveis, compras online, energia, doze histórias e provas para conferir.">
 <Breadcrumbs items={[{label:'Início',href:'/'},{label:'Casos',href:'/casos/'}]}/>
 <header class="bg-primary py-12 text-primary-foreground md:py-16">
  <div class="container stack-copy">
   <p class="m-0 text-xs font-extrabold uppercase tracking-[.18em] text-[#ff917e]">CASOABERTO · PESQUISA DOCUMENTADA</p>
   <h1 class="m-0 max-w-5xl text-4xl leading-[1.05] tracking-tight sm:text-5xl lg:text-7xl">Pagou. Não recebeu. <span class="text-[#ff917e]">Cadê a resposta?</span></h1>
   <p class="m-0 max-w-3xl text-lg leading-relaxed text-white/80">Móveis, viagens, compras, energia, política e direitos. Empresas e instituições aparecem com seus nomes, fatos, fontes e perguntas. Encontre o seu problema. Veja quem foi cobrado. Confira o resultado.</p>
   <div class="flex flex-wrap gap-3 text-sm font-semibold text-white/80"><span>{caseStudies.length} casos documentados</span><span aria-hidden="true">·</span><span>{personalStories.length} histórias de consumidores</span><span aria-hidden="true">·</span><span>{categories.length} categorias</span></div>
  </div>
 </header>
 {featuredCase&&<section class="py-14 md:py-18" aria-labelledby="caso-destaque">
  <div class="container space-y-6">
   <div class="flex flex-wrap items-end justify-between gap-4"><div class="space-y-2"><p class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">CASO EM DESTAQUE · INVESTIGAÇÃO CASOABERTO</p><h2 id="caso-destaque" class="m-0 text-3xl md:text-4xl">R$ 190 mil pagos. A entrega ficou para quando?</h2><p class="m-0 text-muted-foreground">Florense Ipanema. Contrato, cronologia, perguntas, fontes e atualizações do caso que abriu o arquivo.</p></div><a class="text-link font-semibold" href={'/casos/'+featuredCase.slug+'/'}>Acompanhar o caso completo ↗</a></div>
   <CaseCard item={featuredCase} featured/>
   <CaseActionBar compact title={featuredCase.titulo} summary={featuredCase.resumo} href={"/casos/"+featuredCase.slug+"/"} caseId={featuredCase.id} printHref={"/casos/imprimir/"+featuredCase.slug+"/"}/>
  </div>
 </section>}
 <section class="border-t border-border bg-card py-10 md:py-12" aria-labelledby="destaque-escola-suica">
  <div class="container grid max-w-6xl gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
   <div class="space-y-3">
    <p class="m-0 text-xs font-bold uppercase tracking-[.14em] text-brand-strong">NOVO DOSSIÊ DOCUMENTAL · 12/11/2026</p>
    <h2 id="destaque-escola-suica" class="m-0 max-w-3xl text-2xl leading-tight md:text-3xl">Cacofonias e Escola Suíço-Brasileira: o que mostram as fontes sobre os processos?</h2>
    <p class="m-0 max-w-3xl text-sm leading-relaxed text-muted-foreground">A perda de um filho, comentários ofensivos atribuídos a um funcionário, duas ações judiciais noticiadas e uma intimação questionada. Cronologia com a versão pública da instituição, fontes identificadas e documentos ainda necessários.</p>
    <p class="m-0 text-xs text-muted-foreground">Reportagens verificadas; autos e intimação original pendentes de conferência.</p>
   </div>
   <a class="inline-flex min-h-12 items-center justify-center rounded-md border border-primary bg-primary px-5 py-3 text-sm font-bold text-primary-foreground no-underline hover:bg-brand-strong" href="/casos/cacofonias-escola-suico-brasileira/">Abrir o dossiê e as fontes ↗</a>
  </div>
 </section>
 <section class="border-y bg-muted py-12" aria-labelledby="categorias-casos">
  <div class="container space-y-7"><div><p class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">ENCONTRE O PROBLEMA</p><h2 id="categorias-casos" class="mb-2 mt-3 text-3xl">{categories.length} categorias. Toda a pesquisa.</h2><p class="m-0 text-muted-foreground">Escolha um assunto ou pesquise por empresa, cidade, serviço e documento.</p></div>
   <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">{categories.map(cat=><a class="group flex flex-col gap-3 rounded-lg border border-border bg-card p-5 no-underline hover:border-brand/60 focus-visible:ring-2 focus-visible:ring-brand" href={categoryHref(cat)}><span class="text-xs font-bold uppercase tracking-widest text-brand-strong">{cat.eyebrow}</span><strong class="text-xl text-foreground">{cat.title}</strong><p class="m-0 flex-1 text-sm leading-relaxed text-muted-foreground">{cat.description}</p><span class="text-sm font-semibold text-link">{caseCountFor(cat.slug)} casos · Explorar ↗</span></a>)}</div>
  </div>
 </section>
 <section class="container space-y-7 py-14" id="pesquisar-casos">
  <CaseResearchExplorer client:idle entries={allResearch} categories={categories}/>
 </section>
 {educationPrecedents.length>0&&<section class="border-t bg-muted py-12" aria-labelledby="dossies-educacao"><div class="container space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4"><div class="space-y-2"><p class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">JUSTIÇA · ENSINO SUPERIOR</p><h2 id="dossies-educacao" class="m-0 text-3xl">Universidades, recuperação judicial e direitos dos credores</h2><p class="m-0 max-w-3xl text-muted-foreground">Processos judiciais, recursos, documentos do administrador, leilões e decisões. Estes são precedentes documentais, não contratos pessoais acompanhados pelo CasoAberto.</p></div><a class="text-link font-semibold" href="/precedentes/">Ver todos os precedentes ↗</a></div>
  <div class="grid gap-4 md:grid-cols-2">{educationPrecedents.map(p=><article class="border bg-card p-6 shadow-sm"><span class="text-xs font-bold uppercase tracking-wider text-brand-strong">{p.stage_label}</span><h3 class="mt-3 text-2xl"><a href={precedentPath(p)}>{p.brand}</a></h3><p class="font-mono text-xs text-muted-foreground">{p.process_number}</p><p class="text-sm text-muted-foreground">{p.summary}</p><a class="text-link font-semibold" href={precedentPath(p)}>Explorar conexões com a Justiça e documentos ↗</a></article>)}</div>
 </div></section>}
 <section class="border-t bg-card py-10"><div class="container flex flex-wrap items-center justify-between gap-5"><div><p class="m-0 text-xs font-bold uppercase tracking-wider text-brand-strong">PODER E INSTITUIÇÕES</p><h2 class="mb-2 mt-3 text-2xl">Quando o poder decide, quem presta contas?</h2><p class="m-0 max-w-3xl text-muted-foreground">Bets, recursos públicos, direitos eleitorais e instituições. Cada investigação tem documentos, datas, perguntas e responsáveis identificados.</p></div><a class="text-link font-semibold" href="/observatorio/politica/">Examinar as investigações ↗</a></div></section>
<section class="border-t bg-card py-12"><div class="container grid gap-6 md:grid-cols-[1fr_auto] md:items-center"><div><h2 class="m-0 text-2xl">O consumidor cobra. A empresa precisa responder.</h2><p class="mb-0 mt-2 max-w-3xl text-muted-foreground">Cada caso liga o problema à sua cronologia e às fontes para consulta. Cada história ajuda a entender o custo de uma promessa não cumprida.</p></div><div class="flex flex-wrap gap-4"><a class="text-link font-semibold" href="/sobre/">Conheça o projeto ↗</a><a class="text-link font-semibold" href="/organizar/caderno-de-acao/">Registre seu problema ↗</a></div></div></section>
</BaseLayout>
