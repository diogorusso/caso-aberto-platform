---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseCard from '../../components/CaseCard.astro';
import { cases } from '../../lib/cases';
---
<BaseLayout title="Casos documentados de consumidores | CasoAberto" description="Dossiês de consumo organizados em páginas públicas com prazos, reclamações, documentos, respostas e acompanhamento.">
  <Breadcrumbs items={[{label:'Início',href:'/'},{label:'Casos',href:'/casos/'}]} />
  <section class="border-b bg-card py-12 md:py-16 [&_h1]:my-4 [&_p]:max-w-3xl [&_p]:text-lg [&_p]:text-muted-foreground"><div class="container"><span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">ARQUIVO DE CASOS</span><h1>Casos abertos. Empresas cobradas.</h1><p>Cada caso tem cronologia, fontes, exigências e um placar simples: a empresa respondeu ou não. Quando resolve, registramos.</p></div></section>
  <section class="border-y bg-muted py-4 [&>.container]:flex [&>.container]:flex-wrap [&>.container]:gap-2.5"><div class="container"><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90" href="/empresas/">Consultar recomendações por empresa ↗</a><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 border bg-background text-foreground shadow-xs hover:bg-accent" href="/avaliacoes/nao-recomendamos/">Empresas que não recomendamos ↗</a></div></section>
  <section class="py-14 md:py-20 pt-10"><div class="container mt-4 space-y-4">{cases.map((item)=><CaseCard item={item}/>)}</div></section>
</BaseLayout>
<style>.case-list {display:grid;gap:20px}</style>
