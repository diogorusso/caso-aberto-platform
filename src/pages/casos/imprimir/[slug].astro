---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {caseStudies} from '../../../lib/case-catalog';
import {caseStory} from '../../../lib/visual-impact';
import {Printer,ArrowLeft,ExternalLink,FileText} from 'lucide-react';
export function getStaticPaths(){return caseStudies.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
type Entry=(typeof caseStudies)[number];
const {entry}=Astro.props as {entry:Entry};
const story=caseStory(entry.id);
const date=(s:string)=>s.split('-').reverse().join('/');
const caseUrl='https://casoaberto.pages.dev'+story.href;
const refs=story.sources.slice(0,6);
---
<BaseLayout title={'Ficha pública para impressão: '+story.title+' | CasoAberto'} description={'Ficha A4 do caso '+story.id+' com dados, cenários condicionais, fontes e data de revisão.'} type="article" dateModified={story.date}>
  <div class="print-case-toolbar container flex flex-wrap items-center justify-between gap-4 py-7">
    <a class="inline-flex items-center gap-2 text-sm font-bold text-brand-strong" href={story.href}><ArrowLeft size={16} aria-hidden="true"/> Voltar ao dossiê</a>
    <button type="button" id="print-case-button" class="inline-flex min-h-11 items-center gap-2 bg-primary px-5 py-3 text-sm font-bold text-primary-foreground hover:bg-forest"><Printer size={17} aria-hidden="true"/> Imprimir / salvar PDF</button>
  </div>
  <section class="print-case-sheet mx-auto mb-12 max-w-[850px] border border-border bg-white p-7 text-foreground shadow-md md:p-12" aria-label={'Material de impressão '+story.id}>
    <header class="flex items-center justify-between gap-4 border-b-4 border-primary pb-4 text-xs font-bold uppercase tracking-[.14em]"><span class="text-xl font-black tracking-tight">CASO<span class="text-brand-strong">ABERTO</span></span><span>FICHA PÚBLICA / {story.id}</span></header>
    <p class="mt-7 text-xs font-bold uppercase tracking-[.16em] text-brand-strong">{story.audience}</p>
    <h1 class="my-3 text-3xl font-black leading-tight md:text-4xl">{story.headline}</h1>
    <p class="text-lg leading-relaxed">{story.exposure}</p>
    <div class="mt-6 grid grid-cols-2 gap-3">
      {story.metrics.slice(0,4).map(m=><div class="border-t-2 border-brand bg-muted p-4"><div class="text-[.62rem] font-bold uppercase tracking-wide">{m.label}</div><strong class="my-2 block text-xl tabular-nums">{m.value}</strong><p class="m-0 text-[.7rem]">{m.note}</p></div>)}
    </div>
    <section class="my-7 border-l-4 border-brand-strong bg-brand-soft p-6">
      <h2 class="m-0 text-sm font-black uppercase tracking-[.14em] text-brand-strong">E SE A SITUAÇÃO CONTINUAR?</h2>
      <p class="mb-0 mt-3 text-base font-medium leading-relaxed">{story.worst_case}</p>
    </section>
    <div class="grid gap-5 border-y border-border py-5 md:grid-cols-2">
      <div><h2 class="m-0 text-sm font-black uppercase tracking-wider">O que exige atenção</h2><p class="mb-0 mt-2 text-sm leading-relaxed">{story.threshold}</p></div>
      <div><h2 class="m-0 text-sm font-black uppercase tracking-wider">Qual prova encerra o caso?</h2><p class="mb-0 mt-2 text-sm leading-relaxed">{story.resolution}</p></div>
    </div>
    <div class="my-6"><h2 class="m-0 text-base font-black">Qual resposta estamos cobrando?</h2><p class="mb-0 mt-2">{story.action}</p></div>
    <section class="border-t border-border pt-5">
      <h2 class="m-0 flex items-center gap-2 text-base font-black"><FileText size={17} aria-hidden="true"/> Fontes para conferência</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-xs">
        {refs.map(s=><li><span class="font-semibold">{s.title}</span><span class="block break-all text-muted-foreground">{s.url}</span></li>)}
      </ol>
    </section>
    <footer class="mt-8 flex flex-wrap justify-between gap-3 border-t-4 border-primary pt-4 text-[.7rem]">
      <div class="font-semibold">CASO {story.id} · REVISÃO {date(story.date)}</div><a href={caseUrl} class="break-all font-bold text-brand-strong">{caseUrl} <ExternalLink size={12} className="inline" aria-hidden="true"/></a>
    </footer>
  </section>
  <script>
    document.getElementById('print-case-button')?.addEventListener('click',()=>window.print());
  </script>
</BaseLayout>
<style is:global>
@media print {
  @page{size:A4 portrait;margin:11mm}
  html,body{background:#fff!important;print-color-adjust:exact;-webkit-print-color-adjust:exact}
  body>header,body>footer,.print-case-toolbar,.print-case-toolbar~script,.print-case-sheet~script{display:none!important}
  main{min-height:0!important}
  .print-case-sheet{width:100%!important;max-width:none!important;margin:0!important;padding:0!important;border:0!important;box-shadow:none!important}
  .print-case-sheet h1{font-size:25pt!important}
  .print-case-sheet h2,.print-case-sheet li,.print-case-sheet p{break-inside:avoid}
  a{color:inherit;text-decoration:none}
}
</style>
