---
/*
 * Case page IA — one linear story, one link per destination:
 * verdict → hero → nav → O caso (resumo + situação) → Exigimos → O risco (alerta, impacto, precedentes)
 * → Discurso × realidade → Outras vozes → Sem resposta + movimentações → Siga o caso (hub) → Junte-se → Compartilhe.
 * Sub-page links live only in CaseSectionHub (lib/case-sections.ts). Words live in lib/copy.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CaseIntro from '../../../components/CaseIntro.astro';
import CaseActionHub from '../../../components/CaseActionHub.astro';
import Requests from '../../../components/Requests.astro';
import SourceList from '../../../components/SourceList.astro';
import ShareActions from '../../../components/ShareActions.astro';
import ConsumerRiskWarning from '../../../components/ConsumerRiskWarning.astro';
import CorporateStatements from '../../../components/CorporateStatements.astro';
import CaseMetrics from '../../../components/CaseMetrics.astro';
import CaseUpdates from '../../../components/CaseUpdates.astro';
import CaseQuestions from '../../../components/CaseQuestions.astro';
import ParticipationCTA from '../../../components/ParticipationCTA.astro';
import EditorialVerdict from '../../../components/EditorialVerdict.astro';
import CaseVisualStory from '../../../components/CaseVisualStory.astro';
import CaseCompanyReference from '../../../components/CaseCompanyReference.astro';
import PrecedentComparison from '../../../components/PrecedentComparison.astro';
import CollapseSignalsMatrix from '../../../components/CollapseSignalsMatrix.astro';
import CaseSectionHub from '../../../components/CaseSectionHub.astro';
import Section from '../../../components/layout/Section.astro';
import {forCase,verdictForCase} from '../../../lib/brands';
import {sectionHref} from '../../../lib/case-sections';
import {copy} from '../../../lib/copy';
import { cases, casePath, crumbFor, dateBR, reportsFor, type Case } from '../../../lib/cases';
export function getStaticPaths() { return cases.map(item => ({params:{slug:item.slug},props:{item}})); }
interface Props { item: Case }
const {item} = Astro.props;
const base = casePath(item);
const caseVerdict = verdictForCase(item);
const caseBrand = forCase(item);
const caseUnit = caseBrand?.units.find(u => u.slug === item.unidade_slug);
const crumbs = crumbFor(item);
const related = reportsFor(item).filter(r => r.destaque || (r.cidade||'').includes('Ipanema')).slice(0,4);
const romaHref = sectionHref(item,'risco-roma-mobili');
const c = copy.case;
---
<BaseLayout
  title={`${item.titulo} | CasoAberto`}
  description={item.resumo}
  dateModified={item.status_data}
  datePublished={item.data_publicacao}
  type="article"
  breadcrumbs={crumbs.map(x => ({name:x.label, item:x.href}))}
>
  <Breadcrumbs items={crumbs} />
  <CaseIntro item={item}/>
  {caseVerdict && <EditorialVerdict verdict={caseVerdict} subject={item.empresa_resumo} prominence="hero" caseHref={base+'evidencias/'} brand={caseBrand} unit={caseUnit}/>}

  <CaseActionHub caseId={item.id} compact/>
  <CaseVisualStory caseId={item.id}/>

  <!-- O CASO -->
  <Section id="o-caso" eyebrow={c.summary.eyebrow} title={c.summary.title}>
    <div class="grid gap-8 lg:grid-cols-[1.6fr_1fr]">
      <div class="space-y-4 text-lg leading-relaxed">
        <p class="m-0">{item.resumo}</p>
        {item.impacto && <p class="m-0"><strong>{c.summary.impactLabel}</strong> {item.impacto}</p>}
        {item.legal_entity_note && <p class="m-0 text-sm text-muted-foreground">{item.legal_entity_note}</p>}
        <a class="font-bold" href={`${base}linha-do-tempo/`}>{c.summary.timelineLink} →</a>
      </div>
      <aside class="rounded-xl border bg-card p-6">
        <p class="m-0 text-xs font-bold uppercase tracking-widest text-muted-foreground">{c.status.eyebrow}</p>
        <h3 class="mt-2 mb-2 text-2xl font-extrabold">{item.status}</h3>
        <p class="m-0 text-sm text-muted-foreground">{c.status.body(item.status_data)}</p>
        <dl class="mt-5 grid gap-3 text-sm">
          <div><dt class="font-bold">{c.status.category}</dt><dd class="m-0">{item.categoria} · {item.local}</dd></div>
          {item.prazo_posterior && <div><dt class="font-bold">{c.status.laterDeadline}</dt><dd class="m-0">{item.prazo_posterior}</dd></div>}
          {item.procon_protocol && <div><dt class="font-bold">{c.status.procon}</dt><dd class="m-0">{item.procon_protocol}</dd></div>}
        </dl>
      </aside>
    </div>
  </Section>

  <!-- EXIGIMOS -->
  <Section id="exigencias" tone="muted" eyebrow={c.demands.eyebrow} title={c.demands.title} description={c.demands.description}>
    <Requests items={item.pedidos}/>
  </Section>

  <!-- O RISCO -->
  {romaHref && <Section id="alerta" eyebrow={c.warning.eyebrow} title={c.warning.title}>
    <ConsumerRiskWarning href={romaHref} />
  </Section>}
  <CollapseSignalsMatrix item={item}/>
  <PrecedentComparison item={item} compact/>

  <!-- DISCURSO × REALIDADE -->
  {item.id==='CA-001' && <Section id="discurso" tone="muted" eyebrow={c.discourse.eyebrow} title={c.discourse.title} description={c.discourse.description}>
    <CorporateStatements />
  </Section>}

  <!-- OUTRAS VOZES -->
  <Section id="outras-vozes" eyebrow={c.others.eyebrow} title={c.others.title} description={c.others.description}>
    <div class="grid gap-8 lg:grid-cols-[1.6fr_1fr]">
      <div>
        <div class="grid gap-4 sm:grid-cols-2">
          {related.map(r => (
            <article class="rounded-xl border bg-card p-5">
              <p class="m-0 text-xs text-muted-foreground">{dateBR(r.data)} · {r.cidade} · {r.tema}</p>
              <h3 class="mt-2 mb-2 text-base font-bold">{r.titulo}</h3>
              <p class="m-0 text-sm">{r.resumo}</p>
              <p class="mt-3 mb-0 flex items-center justify-between gap-3 text-xs"><strong>{r.status}</strong><a href={r.url} target="_blank" rel="noopener noreferrer">{c.others.sourceLink} ↗</a></p>
            </article>
          ))}
        </div>
        <a class="mt-5 inline-block font-bold" href={`${base}reclamacoes-publicas/`}>{c.others.allLink} →</a>
      </div>
      <SourceList items={item.fontes}/>
    </div>
  </Section>

  <!-- SEM RESPOSTA + MOVIMENTAÇÕES -->
  <Section id="sem-resposta" tone="muted">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <p class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">{c.questions.eyebrow}</p>
        <h2 class="mt-2">{c.questions.title}</h2>
        <CaseQuestions questions={item.imprensa_perguntas || []} />
      </div>
      <div>
        <p class="m-0 text-xs font-bold uppercase tracking-widest text-muted-foreground">{c.updates.eyebrow}</p>
        <h2 class="mt-2">{c.updates.title}</h2>
        <CaseUpdates item={item} limit={3} />
        <CaseMetrics item={item} />
      </div>
    </div>
  </Section>

  <CaseCompanyReference item={item}/>
  <CaseSectionHub item={item} exclude={['resumo','linha-do-tempo','reclamacoes-publicas']}/>
  <div id="apoiar"><ParticipationCTA item={item} /></div>
  <ShareActions title={item.titulo} summary={item.resumo} caseHref={base}/>
</BaseLayout>
