---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CaseNav from '../../../components/CaseNav.astro';
import CaseIntro from '../../../components/CaseIntro.astro';
import Requests from '../../../components/Requests.astro';
import SourceList from '../../../components/SourceList.astro';
import ShareActions from '../../../components/ShareActions.astro';
import ConsumerRiskWarning from '../../../components/ConsumerRiskWarning.astro';
import CorporateStatements from '../../../components/CorporateStatements.astro';
import CaseMetrics from '../../../components/CaseMetrics.astro';
import CaseUpdates from '../../../components/CaseUpdates.astro';
import CaseQuestions from '../../../components/CaseQuestions.astro';
import ParticipationCTA from '../../../components/ParticipationCTA.astro';
import EditorialVerdict from '../../../components/EditorialVerdict.astro';
import {verdictForCase} from '../../../lib/brands';
import EvidenceIndex from '../../../components/EvidenceIndex.astro';
import { cases, casePath, crumbFor, dateBR, reportsFor, type Case } from '../../../lib/cases';
export function getStaticPaths() { return cases.map(item => ({params:{slug:item.slug},props:{item}})); }
interface Props { item: Case }
const {item} = Astro.props;
const base = casePath(item);
const caseVerdict=verdictForCase(item);
const crumbs = crumbFor(item);
const related = reportsFor(item).filter(r => r.destaque || (r.cidade||'').includes('Ipanema')).slice(0,4);
---
<BaseLayout
  title={`${item.titulo} | CasoAberto`}
  description={item.resumo}
  dateModified={item.status_data}
  datePublished={item.data_publicacao}
  type="article"
  breadcrumbs={crumbs.map(c => ({name:c.label, item:c.href}))}
>
  <Breadcrumbs items={crumbs} />
  {caseVerdict && <EditorialVerdict verdict={caseVerdict} subject={item.empresa_resumo} prominence="hero" caseHref={base+'evidencias/'}/>}
  <CaseIntro item={item}/>
  <CaseNav item={item}/>

  <section class="section"><div class="container">
    <CaseMetrics item={item} />
  </div></section>

  <section class="section"><div class="container two-col">
    <div>
      <span class="eyebrow">RESUMO EXECUTIVO</span>
      <h2>Da promessa de entrega à cobrança por solução.</h2>
      <p>{item.resumo}</p>
      {item.impacto && <p><strong>Impacto relatado:</strong> {item.impacto}</p>}
      {item.legal_entity_note && <p class="note-inline">{item.legal_entity_note}</p>}
      <a href={`${base}linha-do-tempo/`} class="text-link">Ler a cronologia completa ↗</a>
    </div>
    <aside class="info-panel">
      <span class="eyebrow">ACOMPANHAMENTO</span>
      <h3>{item.status}</h3>
      <p>Status do dossiê em {dateBR(item.status_data)}. A situação pode ter mudado desde a última verificação.</p>
      <div class="divider"></div>
      <strong>Categoria · Local</strong>
      <p>{item.categoria} · {item.local}</p>
      {item.prazo_posterior && <><strong>Previsão posterior relatada</strong><p>{item.prazo_posterior}</p></>}
      {item.procon_protocol && <><strong>Procon/RJ</strong><p>{item.procon_protocol}</p></>}
    </aside>
  </div></section>

  <section class="section section-soft"><div class="container">
    <span class="eyebrow">PEDIDOS DE SOLUÇÃO</span>
    <h2>O que precisa ser respondido?</h2>
    <Requests items={item.pedidos}/>
  </div></section>

  {item.id==='CA-001' && <section class="section"><div class="container">
    <span class="eyebrow">ALERTA AO CONSUMIDOR</span>
    <h2>Por que o risco do pagamento antecipado importa neste caso</h2>
    <ConsumerRiskWarning href={base+'risco-roma-mobili/'} />
  </div></section>}

  {item.id==='CA-001' && <section class="section section-soft"><div class="container">
    <span class="eyebrow">DECLARAÇÕES PÚBLICAS × EXPERIÊNCIA RELATADA</span>
    <h2>O que a empresa diz em público — e o que este dossiê pergunta</h2>
    <p class="muted">Não inventamos nexo causal. Mostramos o contraste entre falas institucionais datadas e as perguntas em aberto do pedido de Ipanema.</p>
    <CorporateStatements />
  </div></section>}

  <section class="section"><div class="container two-col">
    <div>
      <span class="eyebrow">ARQUIVO RELACIONADO</span>
      <h2>Outras reclamações públicas</h2>
      <p>Inclui registros de Ipanema e de outras unidades. Status resolvido permanece explícito.</p>
      <div class="reports-grid">
        {related.map(r => (
          <article class="record">
            <div class="record-top"><span>{r.data.split('-').reverse().join('/')}</span><span>·</span><span>{r.cidade}</span></div>
            <span class="tag">{r.tema}</span>
            <h3>{r.titulo}</h3>
            <p>{r.resumo}</p>
            <small>{r.status}</small>
            <a class="text-link" href={r.url} target="_blank" rel="noopener noreferrer">Fonte original ↗</a>
          </article>
        ))}
      </div>
      <a class="button button-dark" href={`${base}reclamacoes-publicas/`}>Abrir arquivo completo ↗</a>
    </div>
    <div class="info-panel">
      <span class="eyebrow">FONTES DESTE CASO</span>
      <SourceList items={item.fontes}/>
      <div class="divider"></div>
      {item.id==='CA-001' ? <a class="text-link" href={base+'responsaveis/'}>Quem responde institucionalmente? ↗</a> : <a class="text-link" href="/empresas/">Empresas e responsáveis institucionais ↗</a>}
    </div>
  </div></section>

  <section class="section section-soft"><div class="container two-col">
    <div>
      <span class="eyebrow">PERGUNTAS EM ABERTO</span>
      <h2>O que a empresa ainda precisa esclarecer</h2>
      <CaseQuestions questions={item.imprensa_perguntas || []} />
    </div>
    <div>
      <span class="eyebrow">ÚLTIMAS ATUALIZAÇÕES</span>
      <h2>Linha editorial recente</h2>
      <CaseUpdates item={item} limit={3} />
      <a class="text-link" href={`${base}atualizacoes/`}>Histórico completo ↗</a>
    </div>
  </div></section>

  {item.id === 'CA-001' && <section class="dossier-feature"><div class="container"><span class="eyebrow">INVESTIGAÇÃO CORPORATIVA · FLORENSE</span><h2>383 reclamações no histórico. Rede com 69 lojas declaradas. Quem responde pelo pedido?</h2><p>Reunimos CNPJs, estrutura industrial, empresa no endereço de Ipanema, administradores, capital social e declarações executivas. O histórico de reclamações abrange diferentes unidades e períodos.</p><div class="feature-links"><a class="button button-dark" href="/empresas/florense/">Ler dossiê corporativo ↗</a><a class="button button-subtle" href="/empresas/florense/ipanema-rj/">Empresa em Ipanema ↗</a></div></div></section>}
  {item.id==='CA-001' && <EvidenceIndex caseId={item.id} slug={item.slug} compact />}
  <section class="press-actionbar"><div class="container"><a class="button button-dark" href={base+'evidencias/'}>Índice de evidências ↗</a><a class="button button-subtle" href={base+'materiais-imprensa/'}>Materiais de mídia ↗</a><a class="button button-subtle" href={base+'indice-evidencias.csv'}>Exportar CSV</a></div></section>
  <div id="apoiar"><ParticipationCTA item={item} /></div>
  <ShareActions />
</BaseLayout>
