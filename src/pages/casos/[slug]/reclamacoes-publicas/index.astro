---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SourceList from '../../../../components/SourceList.astro';
import ReportsExplorer from '../../../../components/islands/ReportsExplorer';
import { cases, casePath, crumbFor, reportsFor, type Case } from '../../../../lib/cases';
export function getStaticPaths() {return cases.map(item=>({params:{slug:item.slug},props:{item}}));}
interface Props {item: Case}
const {item}=Astro.props;
const reports=reportsFor(item);
---
<BaseLayout title={`Reclamações públicas e fontes: ${item.empresa_resumo} | CasoAberto`} description={`Registros e reclamações públicas relacionados a ${item.empresa_resumo}. Links originais, datas, unidades, assuntos e atualizações.`} dateModified={item.status_data}>
  <Breadcrumbs items={[...crumbFor(item),{label:'Fontes públicas',href:`${casePath(item)}reclamacoes-publicas/`}]}/>
  <section class="border-b bg-card py-12 md:py-16 [&_h1]:my-4 [&_p]:max-w-3xl [&_p]:text-lg [&_p]:text-muted-foreground"><div class="container"><span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">ORIGEM DOS REGISTROS</span><h1>{item.empresa_resumo}: quem mais reclamou.</h1><p>Cada registro com data, local e situação — inclusive os resolvidos. Relato de outra unidade não vira, automaticamente, acusação contra a rede inteira.</p></div></section>
  <section class="py-14 md:py-20"><div class="container"><h2>Fontes diretamente ligadas ao caso</h2><SourceList items={item.fontes}/>
    {reports.length > 0 && <><div class="my-8 border border-warning/25 bg-warning-soft p-5 [&_h2]:text-xl [&_p]:mb-0 [&_p]:text-muted-foreground"><strong>Arquivo de reclamações externas</strong><p>{reports.length} publicações selecionadas com links originais. O histórico pode incluir registros resolvidos e reclamações de outras localidades; cada entrada identifica seu status registrado.</p></div><ReportsExplorer reports={reports} client:visible /></>}
  </div></section>
</BaseLayout>
