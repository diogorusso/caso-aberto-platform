---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CaseNav from '../../../../components/CaseNav.astro';
import {cases,casePath,crumbFor,type Case} from '../../../../lib/cases';
export function getStaticPaths(){return cases.map(item=>({params:{slug:item.slug},props:{item}}));}
interface Props {item:Case}
const {item}=Astro.props;
const crumbs=[...crumbFor(item),{label:'Materiais de imprensa',href:casePath(item)+'materiais-imprensa/'}];
---
<BaseLayout title={'Materiais para imprensa e redes — '+item.empresa_resumo+' | CasoAberto'}
 description={'Artes gratuitas, contexto, citações, referências verificáveis e resumo para jornalistas sobre o caso '+item.id+'.'} type="article" dateModified={item.status_data} breadcrumbs={crumbs.map(c=>({name:c.label,item:c.href}))}>
 <Breadcrumbs items={crumbs}/>
 <header class="pagehead"><div class="container"><span class="eyebrow">CENTRAL DE MÍDIA · {item.id}</span><h1>Material público para explicar e acompanhar o caso.</h1><p>Artes de divulgação, resumo editorial e índice documental. Os links podem ser utilizados em cobertura jornalística e compartilhamentos que preservem o contexto das afirmações.</p></div></header>
 <CaseNav item={item} current="materiais-imprensa"/>
 <section class="section"><div class="container">
  <div class="evidence-actions"><a class="button button-dark" href="/media/CA-001-factsheet.txt" download>Baixar fact sheet (TXT)</a><a class="button button-subtle" href={casePath(item)+'indice-evidencias.csv'}>Baixar índice de fontes (CSV)</a><a class="button button-subtle" href={casePath(item)+'imprensa/'}>Ver kit editorial ↗</a></div>
  {item.id==='CA-001' && <div class="media-downloads">
   <article><img src="/media/florense-case-card.svg" alt="Card editorial CasoAberto: R$ 190 mil relatados como pagos, entrega atrasada" width="1280" height="720" loading="lazy"/><h3>Card horizontal — 16:9</h3><p>Compartilhamento em mídia, X, LinkedIn ou matéria jornalística. Formato SVG editável.</p><a class="button button-dark" href="/media/florense-case-card.svg" download>Baixar SVG</a></article>
   <article><img src="/media/roma-risk-card.svg" alt="Alerta sobre o risco do pagamento antecipado com referência ao processo Roma Mobili" width="1080" height="1350" loading="lazy"/><h3>Card vertical — 4:5</h3><p>Instagram e Facebook. O link do processo judicial acompanha a arte.</p><a class="button button-dark" href="/media/roma-risk-card.svg" download>Baixar SVG</a></article>
  </div>}
  <section class="dossier-article narrow"><h2>Orientações de uso editorial</h2><p>Este material apresenta fatos públicos e alegações atribuídas ao consumidor. Antes de publicar, confirme o estado mais recente do caso, respeite os status das reclamações e vincule o endereço permanente do dossiê.</p><p>Os documentos privados não estão disponíveis neste site. Para análise de comprovantes originais, faça a solicitação diretamente ao titular ou representante autorizado.</p><h2>Links de referência</h2><ul><li><a href={casePath(item)}>Dossiê principal</a></li><li><a href={casePath(item)+'evidencias/'}>Índice documental</a></li><li><a href="/empresas/florense/">Cadastro das empresas</a></li><li><a href={casePath(item)+'risco-roma-mobili/'}>Comparação Roma Mobili</a></li></ul></section>
 </div></section>
</BaseLayout>