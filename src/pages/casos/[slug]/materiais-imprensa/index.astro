---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import {cases,casePath,crumbFor,type Case} from '../../../../lib/cases';
import {printKitForCase,printKitPath} from '../../../../lib/print-kits';
export function getStaticPaths(){return cases.map(item=>({params:{slug:item.slug},props:{item}}));}
interface Props {item:Case}
const {item}=Astro.props;
const crumbs=[...crumbFor(item),{label:'Materiais de imprensa',href:casePath(item)+'materiais-imprensa/'}];
---
<BaseLayout title={'Materiais para imprensa e redes — '+item.empresa_resumo+'| CasoAberto'}
 description={'Artes gratuitas, contexto, citações, referências verificáveis e resumo para jornalistas sobre o dossiê '+item.empresa_resumo+'.'} type="article" dateModified={item.status_data} breadcrumbs={crumbs.map(c=>({name:c.label,item:c.href}))}>
 <Breadcrumbs items={crumbs}/>
 <header class="border-b bg-card py-12 md:py-16 [&_h1]:my-4 [&_p]:max-w-3xl [&_p]:text-lg [&_p]:text-muted-foreground"><div class="container"><span class="eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-brand-strong">CENTRAL DE MÍDIA</span><h1>Artes e dados prontos para espalhar o caso.</h1><p>Cards, resumo e índice documental. Use à vontade em matérias, posts e grupos — sempre com o link do dossiê e sem tirar as afirmações de contexto.</p></div></header>
 <section class="py-14 md:py-20"><div class="container">
  <div class="my-6 flex flex-wrap gap-2.5"><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90" href={casePath(item)+"fact-sheet.txt"} download>Baixar fact sheet (TXT)</a><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 border bg-background text-foreground shadow-xs hover:bg-accent" href={casePath(item)+'indice-evidencias.csv'}>Baixar índice de fontes (CSV)</a><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 border bg-background text-foreground shadow-xs hover:bg-accent" href={casePath(item)+'imprensa/'}>Ver kit editorial ↗</a>{printKitForCase(item)&&<a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90" href={printKitPath(item)}>Imprimir cartaz / panfletos ↗</a>}</div>
  {item.id==='CA-001'&& <div class="grid gap-4 md:grid-cols-2 [&>article]:space-y-3 [&>article]:border [&>article]:bg-card [&>article]:p-5 [&>article]:shadow-sm [&_img]:h-auto [&_img]:w-full [&_p]:text-sm [&_p]:text-muted-foreground">
   <article><img src="/media/florense-case-card.svg" alt="Card editorial CasoAberto: R$ 190 mil relatados como pagos, entrega atrasada" width="1280" height="720" loading="lazy"/><h3>Card horizontal — 16:9</h3><p>Compartilhamento em mídia, X, LinkedIn ou matéria jornalística. Formato SVG editável.</p><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90" href="/media/florense-case-card.svg" download>Baixar SVG</a></article>
   <article><img src="/media/roma-risk-card.svg" alt="Alerta sobre o risco do pagamento antecipado com referência ao processo Roma Mobili" width="1080" height="1350" loading="lazy"/><h3>Card vertical — 4:5</h3><p>Instagram e Facebook. O link do processo judicial acompanha a arte.</p><a class="inline-flex shrink-0 items-center justify-center gap-2 min-h-10 max-w-full px-5 py-2 text-center text-sm font-medium whitespace-normal sm:whitespace-nowrap no-underline transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90" href="/media/roma-risk-card.svg" download>Baixar SVG</a></article>
  </div>}
  <section class="prose prose-stone mt-12 prose-headings:tracking-tight prose-a:text-brand-strong [--container-max:52rem]"><h2>Orientações de uso editorial</h2><p>Este material apresenta fatos públicos e alegações atribuídas ao consumidor. Antes de publicar, confirme o estado mais recente do caso, respeite os status das reclamações e vincule o endereço permanente do dossiê.</p><p>Os documentos privados não estão disponíveis neste site. Para análise de comprovantes originais, faça a solicitação diretamente ao titular ou representante autorizado.</p><h2>Links de referência</h2><ul><li><a href={casePath(item)}>Dossiê principal</a></li><li><a href={casePath(item)+'evidencias/'}>Índice documental</a></li><li><a href="/empresas/">Diretório de empresas</a></li>{item.id==='CA-001'&&<li><a href={casePath(item)+'risco-roma-mobili/'}>Comparação Roma Mobili</a></li>}</ul></section>
 </div></section>
</BaseLayout>