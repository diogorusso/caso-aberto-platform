---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CivicPageHeader from '../../../components/CivicPageHeader.astro';
import CaseCard from '../../../components/CaseCard.astro';
import CaseResearchExplorer from '../../../components/islands/CaseResearchExplorer';
import {categories,featuredCase,allResearch,caseStudies,caseCountFor,categoryHref} from '../../../lib/case-catalog';
---
<BaseLayout title="Arquivo CasoAberto — pesquise todos os casos" description="Casos documentados, pesquisas, empresas e histórias em um só lugar. Florense em destaque. Pesquise por tema, empresa, cidade ou palavra-chave.">
 <CivicPageHeader eyebrow="CASOABERTO · ARQUIVO DE PESQUISA" title="O arquivo está aberto. A cobrança continua." lead="Florense, varejo, viagens, comércio eletrônico, energia. Todos os casos e histórias publicados pelo CasoAberto, com provas e perguntas para quem precisa responder." />
 {featuredCase&&<section class="container space-y-5 py-12"><p class="m-0 text-xs font-bold uppercase tracking-wider text-brand-strong">CASO EM DESTAQUE · FLORENSE IPANEMA</p><CaseCard item={featuredCase} featured/></section>}
 <section class="border-y bg-muted py-12"><div class="container space-y-5"><h2 class="m-0 text-2xl">Pesquise por setor</h2><div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">{categories.map(cat=><a class="flex min-h-28 flex-col justify-between border border-border bg-card p-4 font-semibold no-underline hover:border-brand" href={categoryHref(cat)}><span class="text-lg text-foreground">{cat.title}</span><span class="text-sm text-link">{caseCountFor(cat.slug)} casos ↗</span></a>)}</div></div></section>
 <section class="container py-14"><CaseResearchExplorer client:idle entries={allResearch} categories={categories}/></section>
 <section class="border-t bg-card py-12"><div class="container flex flex-wrap items-center justify-between gap-4"><h2 class="m-0 text-2xl">{caseStudies.length} casos documentados. Um endereço para buscar todos.</h2><a class="text-link font-bold" href="/casos/">Ir ao índice principal de casos ↗</a></div></section>
</BaseLayout>
