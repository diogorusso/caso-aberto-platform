---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CivicPageHeader from '../../../components/CivicPageHeader.astro';
import PublicCaseCard from '../../../components/PublicCaseCard.astro';
import atlas from '../../../data/public-case-atlas.json';
---
<BaseLayout title="Casos públicos documentados: Hurb, 123milhas, Yeesco e Enel | CasoAberto" description="Arquivo público de casos de consumidores com fontes oficiais, reportagens, cronologia, posição das empresas e relatos pessoais atribuídos.">
<CivicPageHeader eyebrow="CASOABERTO · ARQUIVO EXTERNO" title="A promessa foi feita. O problema virou público. E a resposta?" lead="Reunimos casos documentados por órgãos públicos e imprensa. Compare o que foi vendido, o que consumidores relataram, as medidas conhecidas e as perguntas que ainda exigem resposta." note="Arquivo derivado de fontes de terceiros, não uma coleção de processos próprios. Dados e versões são identificados pelo período original; nenhuma situação individual é presumida ainda aberta." />
<section class="container space-y-8 py-14">
  <div class="flex flex-wrap items-end justify-between gap-4"><div><h2 class="m-0 text-3xl">Quatro frentes para investigar</h2><p class="mt-2 max-w-3xl text-muted-foreground">De viagens não realizadas a interrupções de energia: os dados permitem reconhecer problemas recorrentes sem confundir reclamação, multa, decisão e falência.</p></div><a class="text-link" href="/casos/">Ver também dossiês originais ↗</a></div>
  <div class="grid gap-5 md:grid-cols-2">{atlas.cases.map(study=><PublicCaseCard study={study}/>)}</div>
</section>
<section class="bg-muted py-14"><div class="container space-y-5"><h2 class="m-0 text-3xl">O problema tem pessoas, não apenas indicadores.</h2><p class="max-w-4xl">Entrevistas publicadas descrevem viagens perdidas, compras não recebidas e prejuízos em apagões. Relatos são atribuídos às fontes originais e não são apresentados como depoimentos colhidos pelo CasoAberto.</p><div class="grid gap-4 md:grid-cols-3">{atlas.stories.slice(0,3).map(person=><a class="block border border-border bg-card p-5" href={'/historias/'+person.slug+'/'}><span class="text-xs font-bold uppercase tracking-wider text-brand-strong">{person.category} · relato externo</span><h3 class="mt-3 text-xl">{person.headline}</h3><p class="text-sm text-muted-foreground">{person.deck}</p><span class="text-link text-sm">Ler história atribuída ↗</span></a>)}</div><a class="text-link font-semibold" href="/historias/">Consultar as {atlas.stories.length} histórias públicas ↗</a></div></section>
<section class="container space-y-4 py-14"><h2 class="m-0 text-2xl">Qual a diferença entre este arquivo e um dossiê CasoAberto?</h2><p class="max-w-4xl">O <a class="text-link" href="/casos/">arquivo de dossiês próprios</a> reúne investigação editorial aprofundada sobre situações diretamente acompanhadas. Este atlas organiza o que já foi publicado por Procons, imprensa e outras fontes externas, sem se apropriar das entrevistas. Ambos exigem fonte e correção; só o primeiro deve ser tratado como uma apuração original do caso individual.</p><a class="text-link" href="/sobre/criterios-de-publicacao/">Ver critérios e direito de resposta ↗</a></section>
</BaseLayout>
