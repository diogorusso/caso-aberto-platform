---
/*
 * Brand page IA: hero → nossa posição → casos → números → risco → quem é → resposta → continue.
 * Words come from lib/copy.ts; rail anchors from lib/company-sections.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CompanyIdentityHero from '../../../components/CompanyIdentityHero.astro';
import CompanyRecognitionGallery from '../../../components/CompanyRecognitionGallery.astro';
import CompanyDossier from '../../../components/CompanyDossier.astro';
import CompanyProfiles from '../../../components/CompanyProfiles.astro';
import CompanyCaseMatrix from '../../../components/CompanyCaseMatrix.astro';
import CompanyRanking from '../../../components/CompanyRanking.astro';
import ImpactDashboard from '../../../components/ImpactDashboard.astro';
import PrecedentComparison from '../../../components/PrecedentComparison.astro';
import CollapseSignalsMatrix from '../../../components/CollapseSignalsMatrix.astro';
import SectionRail from '../../../components/SectionRail.astro';
import Section from '../../../components/layout/Section.astro';
import ButtonLink from '../../../components/layout/ButtonLink.astro';
import {findBrand,brandPath} from '../../../lib/brands';
import {cases,casePath} from '../../../lib/cases';
import {companySections} from '../../../lib/company-sections';
import {copy} from '../../../lib/copy';
const brand=findBrand('florense');
if(!brand)throw Error('Florense must have a published brand profile');
const caseItem=cases.find(c=>brand.case_ids.includes(c.id));
const crumbs=[{label:'Início',href:'/'},{label:'Empresas',href:'/empresas/'},{label:brand.name,href:brandPath(brand)}];
const schema={'@context':'https://schema.org','@type':'WebPage',name:'Florense — perfil empresarial e arquivo de casos',about:{'@type':'Organization',name:brand.name,url:'https://florense.com.br/',logo:'https://casoaberto.pages.dev/media/florense/florense-logo.png'},dateModified:brand.last_reviewed};
const rail=companySections({hasPrecedent:Boolean(caseItem)});
const v=copy.verdict, w=copy.company.why, a=copy.company.answer, more=copy.company.more;
---
<BaseLayout title="Florense: reclamações, CNPJ, risco, casos e avaliação | CasoAberto" description="Não recomendamos a Florense enquanto o caso de R$ 190 mil em Ipanema seguir sem solução. Veja provas, reclamações, CNPJs e o que a empresa precisa responder." dateModified={brand.last_reviewed} breadcrumbs={crumbs.map(c=>({name:c.label,item:c.href}))} schema={schema}>
 <Breadcrumbs items={crumbs}/>
 <CompanyIdentityHero brand={brand}/>
 <SectionRail items={rail} label={brand.name}/>

 <Section id="avaliacao-editorial" eyebrow={w.eyebrow} title={w.title} description={w.body}>
  <div class="grid gap-6 md:grid-cols-2">
   <article class="rounded-xl border bg-card p-6"><h3 class="mt-0">{v.basisTitle}</h3><ol class="m-0 grid gap-2 pl-5">{brand.verdict.basis.map(x=><li>{x}</li>)}</ol></article>
   <article class="rounded-xl border bg-card p-6"><h3 class="mt-0">{v.triggersTitle}</h3><ol class="m-0 grid gap-2 pl-5">{brand.verdict.review_triggers.map(x=><li>{x}</li>)}</ol></article>
  </div>
  <p class="mt-5 mb-0 text-sm text-muted-foreground"><a href="/metodologia/#avaliacao-editorial">{v.methodLink} →</a></p>
 </Section>

 <CompanyCaseMatrix brand={brand}/>
 <ImpactDashboard brand={brand} embedded/>
 {caseItem&&<PrecedentComparison item={caseItem} compact/>}
 {caseItem&&<CollapseSignalsMatrix item={caseItem}/>}
 <CompanyDossier/>
 <CompanyProfiles only={[...brand.primary_company_profile_ids,...brand.related_company_profile_ids]} title={copy.company.profiles.brandTitle}/>
 <CompanyRecognitionGallery brand={brand}/>

 <Section id="resposta-institucional" tone="dark" eyebrow={a.eyebrow(brand.name)} title={a.title(brand.name)} description={a.body}>
  {caseItem&&<div class="flex flex-wrap gap-3"><ButtonLink variant="inverse" href={casePath(caseItem)+'imprensa/'}>{a.pressLink} →</ButtonLink></div>}
 </Section>

 <CompanyRanking currentBrand={brand.slug} heading={copy.company.ranking.brandTitle}/>
 <Section tone="muted" size="sm" eyebrow={more.eyebrow}>
  <div class="flex flex-wrap gap-3"><ButtonLink variant="outline" href="/empresas/">{more.directory}</ButtonLink><ButtonLink variant="ghost" href="/problemas/">{more.topics}</ButtonLink></div>
 </Section>
</BaseLayout>
