---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import ImpactDashboard from '../../../../../components/ImpactDashboard.astro';
import {brands,brandPath,unitPath,type Brand,type BrandUnit} from '../../../../../lib/brands';
export function getStaticPaths(){return brands.flatMap(brand=>brand.units.filter(unit=>unit.published).map(unit=>({params:{slug:brand.slug,unit:unit.slug},props:{brand,unit}})));}
interface Props {brand:Brand;unit:BrandUnit}
const {brand,unit}=Astro.props;
const href=unitPath(brand,unit)+'impacto/';
const crumbs=[{label:'Início',href:'/'},{label:'Empresas',href:'/empresas/'},{label:brand.name,href:brandPath(brand)},{label:unit.name,href:unitPath(brand,unit)},{label:'Radar de impacto',href}];
---
<BaseLayout title={unit.name+': casos, reclamações locais, dinheiro e atraso | CasoAberto'} description={'Painel de impacto da unidade '+unit.name+': reclamações catalogadas especificamente para a unidade, pagamentos relatados e cenários financeiros discriminados.'} dateModified={unit.last_reviewed} breadcrumbs={crumbs.map(c=>({name:c.label,item:c.href}))}>
 <Breadcrumbs items={crumbs}/>
 <ImpactDashboard brand={brand} unit={unit}/>
 <section class="py-14 md:py-20 bg-muted"><div class="container [--container-max:52rem]"><h2>Entenda o recorte local.</h2><p>Esta página reúne os casos vinculados a {unit.name} e reclamações expressamente identificadas como pertencentes à unidade. Reclamações de lojas de outras cidades não aparecem como ocorrências locais.</p><a class="text-link" href={unitPath(brand,unit)}>Voltar ao perfil da unidade ↗</a></div></section>
</BaseLayout>