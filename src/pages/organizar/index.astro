---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CivicPageHeader from '../../components/CivicPageHeader.astro';
const niveis = [
 {title:'Pessoal',problem:'Uma cobrança, entrega, bloqueio de conta ou decisão que afeta uma pessoa.',workflow:'Montar cronologia, preservar originais, registrar protocolos, pedir resposta e acompanhar correção.'},
 {title:'Comunidade',problem:'Moradores, famílias, trabalhadores ou consumidores que enfrentam um problema em comum.',workflow:'Formular demanda compartilhada, juntar fontes públicas, estabelecer decisões abertas e dividir responsabilidades.'},
 {title:'Institucional',problem:'Serviço público, fornecedor, regulador ou plataforma cuja conduta exige prestação de contas.',workflow:'Organizar perguntas documentadas, consultar dados públicos, acompanhar atos, respostas, correções e providências.'},
 {title:'Ecossistema digital',problem:'Moderação, discriminação algorítmica, publicidade opaca ou vazamento de dados.',workflow:'Comparar relatos e fontes, separar efeitos medidos de hipóteses, documentar recurso e publicar metodologia.'}
];
const actions = [
  {title:'Crie um dossiê',content:'Identifique fato, local, datas, fonte original, parte envolvida, impacto e resposta existente. Separe documentos reservados dos publicáveis.'},
  {title:'Defina a demanda',content:'A pergunta deve permitir resposta verificável: o que aconteceu, quem decide, qual medida é solicitada e quando haverá atualização?'},
  {title:'Organize por consentimento',content:'Decida coletivamente objetivos e porta-vozes. Compartilhe somente dados e documentos autorizados. Não exponha participantes ou terceiros.'},
  {title:'Distribua o que é verificável',content:'Publique links de fontes, material de imprensa, QR codes e kits para impressão. Critique condutas e instituições sem perseguição pessoal.'},
  {title:'Acompanhe resultados',content:'Registre respostas, audiências, medidas, recursos, prazos e correções. Compartilhamentos não são automaticamente impacto ou vitória.'}
];
---
<BaseLayout title="Organizar-se — Ferramentas de ação cidadã | CasoAberto" description="Como organizar demandas pessoais, comunitárias e institucionais com documentos, fontes, comunicação pública e acompanhamento de respostas.">
  <CivicPageHeader eyebrow="ORGANIZAÇÃO CIDADÃ · DO PROBLEMA À AÇÃO" title="Um problema documentado não precisa permanecer isolado." lead="Organize fatos, pessoas e decisões para cobrar respostas concretas. Pressão digital significa visibilidade pública, perguntas verificáveis e acompanhamento — não assédio ou fabricação de consenso." note="Esta é uma metodologia pública de organização. O site ainda não oferece cadastro, grupos privados, petições automatizadas nem envio de denúncias; esses recursos exigem proteção de dados e moderação antes de lançamento." />
  <section class="container space-y-8 py-14"><h2 class="m-0 text-3xl">Onde aplicar</h2><div class="grid gap-4 md:grid-cols-2">{niveis.map(n => <article class="space-y-3 border border-border p-6"><h3 class="m-0 text-xl">{n.title}</h3><p class="text-muted-foreground">{n.problem}</p><p class="font-medium">{n.workflow}</p></article>)}</div></section>
  <section class="bg-muted py-14"><div class="container space-y-8"><h2 class="m-0 text-3xl">Cinco movimentos que deixam rastro público</h2><ol class="list-none space-y-3 p-0">{actions.map((a,i) => <li class="grid gap-2 border-l-4 border-brand bg-card p-5 md:grid-cols-[220px_1fr]"><strong>{String(i+1).padStart(2,'0')} · {a.title}</strong><span class="text-muted-foreground">{a.content}</span></li>)}</ol></div></section>
  <section class="container space-y-5 py-14"><h2 class="m-0 text-3xl">Instrumentos já publicados</h2><p><a class="text-link font-semibold" href="/organizar/caderno-de-acao/">Abrir Caderno de Ação — ficha pronta para imprimir ↗</a></p><div class="grid gap-4 md:grid-cols-3"><a class="block border border-border p-5 text-link" href="/kit-boca-a-boca/"><strong>Kit Boca a Boca</strong><p class="mt-2 text-sm text-muted-foreground">Cartazes, folhetos, QR codes e roteiro de distribuição.</p></a><a class="block border border-border p-5 text-link" href="/cenarios/"><strong>Explorar cenários</strong><p class="mt-2 text-sm text-muted-foreground">Perguntas e próximos passos vinculados a casos documentados.</p></a><a class="block border border-border p-5 text-link" href="/casos/"><strong>Arquivo público de casos</strong><p class="mt-2 text-sm text-muted-foreground">Cronologia, evidências e acompanhamento de respostas.</p></a></div><p class="max-w-4xl text-muted-foreground">Próxima etapa de produto: espaços de causa com controle de participantes, consentimento explícito, tarefas e aprovações, registro de decisões, correspondência com instituições, transparência de financiamento e um processo independente de contestação e correção. Nenhuma dessas funções é anunciada aqui como já operacional.</p></section>
</BaseLayout>
