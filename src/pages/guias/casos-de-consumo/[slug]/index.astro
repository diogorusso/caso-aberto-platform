---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import guides from '../../../../data/public-case-guides.json';
import atlas from '../../../../data/public-case-atlas.json';
export function getStaticPaths(){return guides.guides.map(guide=>({params:{slug:guide.slug},props:{guide}}));}
type Guide=typeof guides.guides[number];
const {guide}=Astro.props as {guide:Guide};
const related=atlas.cases.filter(study=>guide.related_case_slugs.includes(study.slug));
const path='/guias/casos-de-consumo/'+guide.slug+'/';
---
<BaseLayout title={guide.title+' | CasoAberto'} description={guide.description} type="article" dateModified={guide.updated_at} breadcrumbs={[{name:'Início',item:'/'},{name:'Guias de consumo',item:'/guias/casos-de-consumo/'},{name:guide.title,item:path}]}>
<article>
<header class="bg-primary py-16 text-primary-foreground"><div class="container max-w-5xl space-y-5"><p class="m-0 text-xs font-bold uppercase tracking-wider text-[#ff917e]">{guide.category.toUpperCase()} · GUIA COM FONTES</p><h1 class="m-0 text-4xl md:text-6xl">{guide.title}</h1><p class="max-w-4xl text-xl text-white/80">{guide.description}</p><p class="m-0 text-sm text-white/60">Revisão editorial em {guide.updated_at.split('-').reverse().join('/')}. Leia as fontes originais para confirmar os procedimentos atuais.</p></div></header>
<div class="container grid max-w-6xl gap-10 py-14 lg:grid-cols-[minmax(0,1fr)_17rem]">
<div class="min-w-0 space-y-10">
<section><h2 class="mt-0 text-2xl">O problema em uma frase</h2><p class="text-lg leading-relaxed">{guide.intro}</p></section>
{guide.sections.map(section=><section class="space-y-4 border-t border-border pt-6"><h2 class="m-0 text-2xl">{section.heading}</h2>{section.paragraphs.map(p=><p class="m-0 leading-relaxed">{p}</p>)}</section>)}
<section class="space-y-4 border-l-4 border-brand bg-muted p-6"><h2 class="m-0 text-2xl">Checklist de documentação</h2><ul class="list-disc space-y-3 pl-5">{guide.checklist.map(item=><li>{item}</li>)}</ul><p class="m-0 text-xs text-muted-foreground">Armazene comprovantes e dados privados fora do site, sob seu controle. Esta lista não coleta nem transmite respostas.</p></section>
<section class="space-y-4 border border-border p-6"><p class="m-0 text-xs font-bold uppercase tracking-wider text-brand-strong">MODELO DE PERGUNTA · EDITE ANTES DE USAR</p><h2 class="m-0 text-2xl">Peça uma resposta verificável</h2><blockquote class="m-0 border-l-2 border-brand pl-4 leading-relaxed">{guide.request_example}</blockquote><p class="text-sm text-muted-foreground">O texto é um modelo de organização e não foi enviado a empresas, órgãos ou tribunais. Não inclua dados de outras pessoas sem autorização.</p></section>
{related.length>0&&<section class="space-y-4"><h2 class="m-0 text-2xl">Problemas públicos relacionados</h2><div class="grid gap-4 md:grid-cols-2">{related.map(study=><a class="block border border-border bg-card p-5" href={'/casos/arquivo-publico/'+study.slug+'/'}><h3 class="mt-0 text-lg">{study.company}</h3><p class="text-sm text-muted-foreground">{study.deck}</p><span class="text-link text-sm">Ver registros e respostas ↗</span></a>)}</div></section>}
<section class="space-y-3 border-t border-border pt-7"><h2 class="m-0 text-2xl">Fontes e data da consulta editorial</h2><ul class="space-y-3">{guide.sources.map(source=><li><a class="text-link" href={source.url} rel="noopener noreferrer">{source.name} ↗</a></li>)}</ul><p class="text-xs text-muted-foreground">Consulta editorial: {guide.updated_at.split('-').reverse().join('/')}. Datas e requisitos podem mudar; consulte as fontes para procedimentos vigentes.</p></section>
<section class="border-l-4 border-border bg-muted p-6"><h2 class="mt-0 text-lg">O que este guia não prova</h2><p class="m-0">{guide.limits}</p></section>
</div>
<aside class="h-fit space-y-4 border-t-4 border-brand bg-card p-6 lg:sticky lg:top-24"><h2 class="m-0 text-xl">Da pesquisa à ação</h2><a class="block text-link text-sm" href="/organizar/caderno-de-acao/">Caderno de ação para imprimir ↗</a><a class="block text-link text-sm" href="/casos/arquivo-publico/">Casos com fontes oficiais ↗</a><a class="block text-link text-sm" href="/historias/">Histórias de consumidores ↗</a><a class="block text-link text-sm" href="/guias/casos-de-consumo/">Outros guias ↗</a></aside>
</div></article>
</BaseLayout>
