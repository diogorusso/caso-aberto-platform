---
import EvidenceSummary from './EvidenceSummary.astro';
import CaseActionDrawer from './CaseActionDrawer.astro';
import CaseVisibilityBadge from './CaseVisibilityBadge.astro';
import Eyebrow from './layout/Eyebrow.astro';
import { type Case, brl, casePath } from '../lib/cases';
import { forCase, statusLabel } from '../lib/brands';
import media from '../data/company-media.json';
import { copy } from '@/lib/copy';
interface Props { item: Case }
const { item } = Astro.props;
const base = casePath(item);
const t = copy.case.hero;
const brand = forCase(item);
const unit = brand?.units.find((u) => u.slug === item.unidade_slug);
const brandMedia = brand ? (media.brands as Record<string, any>)[brand.slug] : undefined;
const unitMedia = item.unidade_slug ? brandMedia?.units?.[item.unidade_slug] : undefined;
const logo = brandMedia?.logo;
const photo = unitMedia?.image;
const recognition = (unit as any)?.recognition || (brand as any)?.recognition;
const badge = recognition?.badge || ((unit || brand) ? statusLabel((unit || brand)!.verdict.status) : 'Não recomendamos');
const subject = unit?.name || brand?.name || item.empresa_resumo;
const metrics = [
  [t.metrics.paid, item.valor_brl ? brl(item.valor_brl) : t.metrics.notInformed],
  [t.metrics.promised, item.prazo_original || t.metrics.notInformed],
  [t.metrics.status(item.status_data), item.status],
];
---
<section class="bg-forest py-12 text-forest-foreground md:py-16">
  <div class="container stack-section">
    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.8fr)]">
      <div class="stack-tight max-w-3xl">
        <Eyebrow inverse>{t.eyebrow(item.id)}</Eyebrow>
        <div>
          <h1 class="m-0 text-balance">{item.chamada}</h1>
          <CaseVisibilityBadge caseId={item.id} variant="header" tone="inverse" />
        </div>
        <p class="m-0 max-w-3xl text-lg leading-relaxed text-white/75">{item.resumo}</p>
        <CaseActionDrawer caseId={item.id} className="w-fit bg-brand text-brand-foreground hover:bg-brand/90" />
        <p class="m-0 text-sm text-white/65">
          Role para o impacto e o dossiê. Documentos:
          <a class="font-semibold text-brand no-underline hover:underline" href={`${base}evidencias/`}>{t.secondaryCta} ↗</a>
        </p>
      </div>

      {photo?.src && (
        <figure class="m-0 overflow-hidden border border-white/15 bg-black/20">
          <div class="relative">
            <img class="h-64 w-full object-cover sm:h-80" src={photo.src} alt={photo.alt} loading="eager" decoding="async" />
            <span class="absolute left-0 top-0 z-[1] inline-flex max-w-[calc(100%-1rem)] items-center gap-2 bg-destructive px-3 py-2 text-[0.68rem] font-extrabold uppercase tracking-[0.1em] text-white shadow-lg sm:text-xs" role="note" aria-label={`Posição editorial: ${badge}`}>
              <span class="size-2 shrink-0 bg-white" aria-hidden="true"></span>{badge}
            </span>
          </div>
          <figcaption class="flex items-start gap-3 border-t border-white/10 px-4 py-3 text-xs leading-snug text-white/70">
            {logo?.src && (
              <span class="inline-flex h-11 shrink-0 items-center justify-center border border-border bg-white px-2.5">
                <img class="max-h-7 max-w-[7.5rem] object-contain" src={logo.src} alt={logo.alt} loading="eager" decoding="async" />
              </span>
            )}
            <div class="min-w-0">
              <strong class="block text-white/90">{subject}</strong>
              <span>Imagem da unidade divulgada pela marca. Não é foto do conflito.</span>
              {photo.source_url && <a class="ml-1 font-bold text-brand no-underline hover:underline" href={photo.source_url} target="_blank" rel="noopener noreferrer">Fonte ↗</a>}
            </div>
          </figcaption>
        </figure>
      )}
    </div>

    <EvidenceSummary item={item} />
    <dl class="m-0 grid gap-4 border-t border-white/15 pt-6 md:grid-cols-3 md:gap-6">
      {metrics.map(([k, v]) => (
        <div>
          <dt class="text-sm text-white/60">{k}</dt>
          <dd class="m-0 mt-1 text-2xl font-bold tracking-tight md:text-3xl">{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
