---
import { type Case, casePath } from '../lib/cases';
import ButtonLink from './layout/ButtonLink.astro';
import Eyebrow from './layout/Eyebrow.astro';
import { copy } from '@/lib/copy';
interface Props { item?: Case }
const { item } = Astro.props;
const subject = item ? encodeURIComponent(`Apoio / relato — ${item.empresa_resumo}`) : encodeURIComponent('Apoio / relato — CasoAberto');
const body = encodeURIComponent(`Quero apoiar ou enviar um relato relacionado.\n\nConsentimento para publicação anonimizada: SIM/NÃO\nCidade/UF:\nResumo factual (sem dados pessoais sensíveis):\nLink de fonte pública (se houver):\n\nNão envie CPF, endereço residencial, telefone particular, contratos assinados completos ou documentos privados por este canal público.`);
const mail = `mailto:redacao@casoaberto.org?subject=${subject}&body=${body}`;
const t = copy.participation;
---
<section class="bg-forest py-14 text-forest-foreground md:py-20" data-print-hide>
  <div class="container grid gap-10 lg:grid-cols-[1.3fr_0.9fr] lg:items-end">
    <div class="space-y-4">
      <Eyebrow inverse>{t.eyebrow}</Eyebrow>
      <h2 class="m-0">{t.title}</h2>
      <p class="m-0 max-w-2xl text-lg text-white/75">{t.body}</p>
      <ul class="m-0 list-none divide-y divide-white/15 p-0">
        {t.checklist.map((c) => <li class="flex gap-3 py-2.5"><span class="font-bold text-brand" aria-hidden="true">✓</span>{c}</li>)}
      </ul>
    </div>
    <div class="flex flex-col items-start gap-3">
      <ButtonLink variant="brand" size="lg" href={mail}>{t.primaryCta} ↗</ButtonLink>
      {item && <ButtonLink variant="outline-inverse" size="lg" href={`${casePath(item)}reclamacoes-publicas/`}>{t.secondaryCta} ↗</ButtonLink>}
      <p class="m-0 text-sm text-white/60">{t.note}</p>
    </div>
  </div>
</section>
