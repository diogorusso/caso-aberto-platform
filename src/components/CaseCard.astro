---
import { casePath, dateBR, brl, type Case } from '../lib/cases';
import {statusLabel,verdictForCase} from '../lib/brands';
interface Props { item: Case; featured?: boolean }
const { item, featured = false } = Astro.props;
const verdict=verdictForCase(item);
---
{featured ? <article class="featured-case">
    <div class="case-top"><span class="case-number">{item.id} · {item.categoria}</span><span class="pill pill-open">{item.status}</span>{verdict && <span class={"rating-label rating-"+verdict.status}>{statusLabel(verdict.status)}</span>}</div>
    <div class="feature-cols">
      <div><p class="meta">{item.local}</p><h3>{item.chamada}</h3><p>{item.resumo}</p><a class="text-link" href={casePath(item)}>Ver o dossiê completo ↗</a></div>
      <div class="big-metric"><small>{item.valor_brl ? "Valor informado como pago" : "Última atualização"}</small><strong>{item.valor_brl ? brl(item.valor_brl) : dateBR(item.status_data)}</strong><span>{item.status}</span></div>
    </div>
  </article> : <article class="case-card">
    <div class="case-top"><span class="case-number">{item.id} · {item.categoria}</span><span class="pill pill-open">{item.status}</span>{verdict && <span class={"rating-label rating-"+verdict.status}>{statusLabel(verdict.status)}</span>}</div>
    <div class="meta">{item.local}</div><h2>{item.titulo}</h2><p>{item.resumo}</p><a href={casePath(item)} class="text-link">Ver dossiê completo ↗</a>
  </article>}
