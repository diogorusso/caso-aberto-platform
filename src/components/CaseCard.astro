---
import { casePath, dateBR, brl, type Case } from '../lib/cases';
import { statusLabel, verdictForCase, forCase } from '../lib/brands';
import media from '../data/company-media.json';
import VerdictStatusBadge from './VerdictStatusBadge';
import CaseVisibilityBadge from './CaseVisibilityBadge.astro';
import CaseCardShareActions from './islands/CaseCardShareActions';
import { ArrowUpRight } from 'lucide-react';

interface Props { item: Case; featured?: boolean }
const { item, featured = false } = Astro.props;
const href = casePath(item);
const verdict = verdictForCase(item);
const brand = forCase(item);
const brandMedia = brand ? (media.brands as Record<string, any>)[brand.slug] : undefined;
const unit = brand?.units.find((u) => u.slug === item.unidade_slug);
const logo = brandMedia?.logo;
const photo = item.unidade_slug ? brandMedia?.units?.[item.unidade_slug]?.image : undefined;
const badge = (unit as any)?.recognition?.badge || (brand as any)?.recognition?.badge;
const shareTitle = item.chamada || item.titulo;
---
<article
  class:list={[
    'group overflow-hidden rounded-xl border border-border bg-card text-inherit shadow-sm',
    'transition-[border-color,box-shadow,transform] duration-200',
    'hover:-translate-y-0.5 hover:border-brand/60 hover:shadow-md',
    featured && 'ring-1 ring-brand/20',
  ]}
>
  <div class:list={['grid gap-0 md:grid-cols-[minmax(0,16rem)_minmax(0,1fr)]', featured && 'md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]']}>
    <a
      href={href}
      class="relative min-h-[12rem] bg-muted no-underline md:min-h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-inset"
      aria-label={'Abrir dossiê: ' + (featured ? item.chamada : item.titulo)}
    >
      {photo?.src
        ? <img class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" src={photo.src} alt="" loading={featured ? 'eager' : 'lazy'} decoding="async" />
        : <div class="grid size-full place-items-center p-6 text-center text-xs text-muted-foreground">Imagem da loja ainda não catalogada</div>}
      {photo?.src && badge && featured && (
        <span class="absolute left-0 top-0 inline-flex max-w-[calc(100%-0.75rem)] items-center gap-1.5 bg-destructive px-2.5 py-1.5 text-[0.62rem] font-extrabold uppercase tracking-[0.12em] text-white shadow-lg" role="note">
          <span class="size-1.5 shrink-0 bg-white" aria-hidden="true"></span>{badge}
        </span>
      )}
      {logo?.src && (
        <span class="absolute bottom-3 left-3 inline-flex h-10 items-center justify-center border border-border bg-white px-2.5 shadow-sm">
          <img class="max-h-6 max-w-[7rem] object-contain" src={logo.src} alt="" width="112" height="24" loading="lazy" />
        </span>
      )}
    </a>

    <div class="flex flex-col space-y-4 p-6 md:p-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{item.categoria}</span>
        {verdict && <VerdictStatusBadge status={verdict.status} label={statusLabel(verdict.status)} />}
      </div>
      <p class="m-0 text-xs font-semibold uppercase tracking-wider text-brand-strong">{item.local}</p>
      <div class="space-y-3 md:space-y-4">
        {featured
          ? <h3 class="m-0 text-2xl text-foreground md:text-4xl"><a class="text-inherit no-underline hover:text-brand-strong" href={href}>{item.chamada}</a></h3>
          : <h2 class="m-0 text-2xl text-foreground md:text-3xl"><a class="text-inherit no-underline hover:text-brand-strong" href={href}>{item.titulo}</a></h2>}
        <CaseVisibilityBadge caseId={item.id} variant="card" />
      </div>
      <p class="m-0 max-w-3xl text-muted-foreground">{item.resumo}</p>
      <dl class="m-0 grid grid-cols-2 gap-3 border-t pt-3 text-sm">
        <div>
          <dt class="text-xs text-muted-foreground">{item.valor_brl ? 'Valor informado como pago' : 'Última atualização'}</dt>
          <dd class="m-0 mt-0.5 text-lg font-bold tracking-tight">{item.valor_brl ? brl(item.valor_brl) : dateBR(item.status_data)}</dd>
        </div>
        <div>
          <dt class="text-xs text-muted-foreground">Situação na última revisão</dt>
          <dd class="m-0 mt-0.5 text-lg font-bold tracking-tight">{item.status}</dd>
        </div>
      </dl>
      <div class="mt-auto flex flex-col gap-3 border-t border-border pt-4">
        <div class="flex items-center justify-end">
          <a
            href={href}
            class="inline-flex min-h-11 items-center justify-center gap-1 text-sm font-bold text-brand-strong no-underline hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
          >
            Abrir dossiê
            <ArrowUpRight size={16} aria-hidden="true" />
          </a>
        </div>
        <CaseCardShareActions
          client:visible
          caseId={item.id}
          title={shareTitle}
          href={href}
          summary={item.resumo}
          company={item.empresa_resumo}
        />
      </div>
    </div>
  </div>
</article>
