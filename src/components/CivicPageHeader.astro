---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  note?: string;
  /** Optional slot content rendered under the title (e.g. visibility metric). */
}
const { eyebrow, title, lead, note } = Astro.props;
const hasUnderTitle = Astro.slots.has('underTitle');
---
<section class="bg-primary py-12 text-primary-foreground md:py-16" aria-labelledby="civic-title">
  <div class="container stack-tight">
    <p class="m-0 text-xs font-bold uppercase tracking-[0.18em] text-[#ff917e]">{eyebrow}</p>
    <div class:list={[hasUnderTitle ? 'space-y-5 md:space-y-6' : null]}>
      <h1 id="civic-title" class="m-0 max-w-5xl text-4xl leading-tight tracking-tight sm:text-5xl lg:text-6xl">{title}</h1>
      {hasUnderTitle && <slot name="underTitle" />}
    </div>
    <p class="m-0 max-w-3xl text-lg leading-relaxed text-white/80 md:text-xl">{lead}</p>
    {note && <p class="m-0 max-w-3xl border-t border-white/20 pt-4 text-sm text-white/65">{note}</p>}
  </div>
</section>
