---
/** Drill-down to SEO case subpages. Scroll the main dossier first; open the drawer only when you need another page. */
import {type Case} from '@/lib/cases';
import {caseGroups, type SectionKey} from '@/lib/case-sections';
import {copy} from '@/lib/copy';
import Section from './layout/Section.astro';
import CaseSectionsDrawer from './islands/CaseSectionsDrawer';
interface Props {item:Case;exclude?:SectionKey[]}
const {item,exclude=['resumo']}=Astro.props;
const groups=caseGroups(item)
  .map(group=>({
    label:group.label,
    pitch:group.pitch,
    sections:group.sections
      .filter(s=>!exclude.includes(s.key))
      .map(s=>({label:s.label,hint:s.hint,href:s.href})),
  }))
  .filter(group=>group.sections.length>0);
const primary=groups[0]?.sections[0];
---
<Section id="siga-o-caso" eyebrow={copy.case.sections.eyebrow} title="Quer aprofundar? Escolha uma página." description="O dossiê acima já traz o essencial. Cronologia, provas, impacto e materiais vivem em URLs próprias — para SEO, impressão e compartilhamento.">
  <div class="flex flex-wrap items-center gap-3">
    {primary && <a class="inline-flex min-h-11 items-center justify-center rounded-md border border-brand-strong bg-brand-strong px-4 text-sm font-bold text-white no-underline hover:opacity-90" href={primary.href}>{primary.label} ↗</a>}
    <CaseSectionsDrawer client:visible groups={groups} />
  </div>
  <p class="mb-0 mt-4 max-w-2xl text-sm text-muted-foreground">Sem âncoras de “pular para a seção”. Role a página atual; abra outra só quando precisar de um recorte específico.</p>
</Section>
