---
/** One evidence-led navigation hub. Existing deep-link routes remain stable for SEO. */
import {type Case} from '@/lib/cases';
import {caseGroups, type SectionKey} from '@/lib/case-sections';
import {copy} from '@/lib/copy';
import Section from './layout/Section.astro';
import {BookOpenText,FileSearch,Printer,ArrowUpRight} from 'lucide-react';
interface Props {item:Case;exclude?:SectionKey[]}
const {item,exclude=['resumo']}=Astro.props;
const source=caseGroups(item).map(group=>({...group,sections:group.sections.filter(s=>!exclude.includes(s.key))}));
const sections=(key:string)=>source.find(group=>group.key===key)?.sections||[];
const tracks=[
 {id:'entenda',number:'01',label:'Entenda o que aconteceu',pitch:'Datas, fatos e atualizações. Não perca o começo nem a última movimentação.',icon:BookOpenText,items:sections('caso')},
 {id:'comprove',number:'02',label:'Confira provas e consequências',pitch:'Documentos, responsáveis, impacto e precedentes ligados ao caso.',icon:FileSearch,items:[...sections('provas'),...sections('risco')]},
 {id:'compartilhe',number:'03',label:'Tenha o material em mãos',pitch:'Fichas, imprensa e arquivos para compartilhar a investigação com fontes.',icon:Printer,items:sections('mobilize')},
].filter(track=>track.items.length>0);
---
<Section id="siga-o-caso" eyebrow={copy.case.sections.eyebrow} title="Um caso. Um caminho para encontrar tudo." description="O que aconteceu, como provar e como levar os fatos adiante: todas as ferramentas em três etapas." tone="muted">
 <div class="grid gap-4 lg:grid-cols-3">
   {tracks.map(track=>{
     const Icon=track.icon;
     return <nav aria-label={track.label} class="group flex min-w-0 flex-col border border-border border-t-4 border-t-brand bg-card p-6 transition-shadow hover:shadow-md">
       <div class="mb-4 flex items-center justify-between"><span class="text-xs font-extrabold tracking-[.14em] text-brand-strong">ETAPA {track.number}</span><Icon size={23} className="text-brand-strong" aria-hidden="true"/></div>
       <h3 class="m-0 text-xl font-extrabold leading-tight">{track.label}</h3>
       <p class="mt-2 mb-5 text-sm leading-relaxed text-muted-foreground">{track.pitch}</p>
       <ul class="m-0 grid list-none gap-0 p-0">
         {track.items.map((item,i)=>(
           <li class:list={['border-t border-border',i===0?'':'']}>
             <a href={item.href} class="flex items-center justify-between gap-3 py-3 text-sm no-underline hover:text-brand-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
               <span class="min-w-0"><strong class="block font-semibold">{item.label}</strong><span class="mt-1 block text-xs leading-relaxed text-muted-foreground">{item.hint}</span></span>
               <ArrowUpRight size={17} className="shrink-0 text-brand-strong" aria-hidden="true"/>
             </a>
           </li>
         ))}
       </ul>
     </nav>;
   })}
 </div>
</Section>
