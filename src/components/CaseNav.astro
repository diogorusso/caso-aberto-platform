---
/* Case sub-route navigation: the 4 IA groups from lib/case-sections, rendered as shadcn-style tab lists. */
import type { Case } from '@/lib/cases';
import { caseGroups, groupOf } from '@/lib/case-sections';
import { cn } from '@/lib/utils';
interface Props { item: Case; current?: string }
const { item, current = 'resumo'} = Astro.props;
const groups = caseGroups(item);
const activeGroup = groupOf(current);
---
<nav aria-label="Seções do caso" class="border-b bg-card" data-print-hide>
  <div class="container overflow-x-auto py-2.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <ul class="m-0 flex w-max list-none items-center gap-3 p-0">
      {groups.map((g) => (
        <li class="flex items-center gap-2">
          <span class={cn('text-xs font-semibold whitespace-nowrap uppercase tracking-wider', g.key === activeGroup ? 'text-brand-strong': 'text-muted-foreground')}>{g.label}</span>
          <ul class={cn('m-0 flex list-none items-center gap-1 p-1', g.key === activeGroup ? 'bg-brand-soft ring-1 ring-brand-strong/20': 'bg-muted')}>
            {g.sections.map((s) => (
              <li>
                <a
                  href={s.href}
                  title={s.hint}
                  aria-current={current === s.key ? 'page': undefined}
                  class={cn(
                    'inline-flex h-8 items-center px-3 text-sm font-medium whitespace-nowrap no-underline transition-colors',
                    current === s.key ? 'bg-background text-foreground shadow-sm': 'text-muted-foreground hover:text-foreground',
                  )}
                >{s.label}</a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</nav>
