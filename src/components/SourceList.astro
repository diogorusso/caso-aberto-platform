---
import type { Source } from '../lib/cases';
interface Props { items: Source[] }
const { items } = Astro.props;
---
{items.length ? (
  <ul class="m-0 list-none divide-y p-0">
    {items.map((src) => (
      <li class="flex flex-col gap-1 py-3">
        <a class="text-link break-words" href={src.url} target="_blank" rel="noopener noreferrer">{src.titulo} ↗</a>
        <span class="text-xs text-muted-foreground">{src.tipo || 'Fonte pública'}</span>
      </li>
    ))}
  </ul>
) : <p class="text-muted-foreground">Não há fontes públicas vinculadas neste momento.</p>}
