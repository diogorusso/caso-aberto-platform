---
import evidence from '../data/evidence-index.json';
interface Props { caseId: string; slug: string; compact?: boolean }
const { caseId, slug, compact=false }=Astro.props;
const rows=evidence.items.filter(x=>x.case_id===caseId);
const publicRows=rows.filter(x=>x.visibility==='publico');
const privateRows=rows.filter(x=>x.visibility==='privado');
const statusLabel=(s:string)=>({publico_localizado:'Registro público localizado',solicitar_original:'Original a reunir',documento_fornecido_na_conversa:'Documento fornecido — integral privado',protocolo_informado:'Protocolo informado pelo titular'} as Record<string,string>)[s]||s;
---
<section class="evidence-section" id="indice-evidencias">
 <div class="container">
  <header class="evidence-intro"><span class="eyebrow">ÍNDICE DOCUMENTAL · {caseId}</span><h2>Uma referência estável para cada evidência.</h2><p>{evidence.notes}</p>
   <div class="evidence-summary"><span><strong>{rows.length}</strong> registros catalogados</span><span><strong>{publicRows.length}</strong> fontes públicas</span><span><strong>{privateRows.length}</strong> provas/documentos privados a preservar</span></div>
   <div class="evidence-actions"><a class="button button-dark" href={'/casos/' + slug + '/indice-evidencias.csv'}>Baixar índice CSV ↗</a><button class="button button-subtle" type="button" data-print-evidence>Imprimir / salvar PDF</button></div>
  </header>
  <div class="evidence-tablewrap"><table class="evidence-table">
   <thead><tr><th scope="col">Referência</th><th scope="col">Documento ou registro</th><th scope="col">Situação</th><th scope="col">Conservação / próxima ação</th></tr></thead>
   <tbody>{rows.slice(0,compact?5:undefined).map(e=><tr><td><strong>{e.id}</strong><small>{e.event_date}</small></td><td><strong>{e.title}</strong><small>{e.description}</small>{e.source_url && <a href={e.source_url} target="_blank" rel="noopener noreferrer">Fonte original ↗</a>}</td><td><span class:list={['evidence-status',{'evidence-private':e.visibility==='privado'}]}>{statusLabel(e.status)}</span><small>{e.visibility==='privado'?'Acesso restrito':'Disponível na origem'}</small></td><td><small>{e.needs}</small></td></tr>)}</tbody>
  </table></div>
  {compact && <a class="text-link" href={'/casos/' + slug + '/evidencias/'}>Abrir índice integral ↗</a>}
 </div>
</section>
<script>
 document.addEventListener('click',(event)=>{
  const el=event.target;
  if(el instanceof Element && el.closest('[data-print-evidence]')) window.print();
 });
</script>