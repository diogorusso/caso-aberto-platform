---
import evidence from '../data/evidence-index.json';
import Section from './layout/Section.astro';
import ButtonLink from './layout/ButtonLink.astro';
import EvidenceTable from './tables/EvidenceTable';
import { KpiCard } from './ui/kpi-card';
import { buttonVariants } from './ui/button';
import { cn } from '@/lib/utils';
interface Props { caseId: string; slug: string; compact?: boolean }
const { caseId, slug, compact = false } = Astro.props;
const rows = evidence.items.filter((x) => x.case_id === caseId);
const publicRows = rows.filter((x) => x.visibility === 'publico');
const privateRows = rows.filter((x) => x.visibility === 'privado');
const statusLabel = (s: string) => ({
  publico_localizado: 'Registro público localizado',
  solicitar_original: 'Original a reunir',
  documento_fornecido_na_conversa: 'Documento fornecido — integral privado',
  protocolo_informado: 'Protocolo informado pelo titular',
} as Record<string, string>)[s] || s;
const tableRows = rows.slice(0, compact ? 5 : undefined).map((e: any) => ({
  id: e.id, event_date: e.event_date, title: e.title, description: e.description,
  source_url: e.source_url ?? null, statusLabel: statusLabel(e.status), isPrivate: e.visibility === 'privado', needs: e.needs,
}));
---
<Section id="indice-evidencias" tone="muted" eyebrow="Índice documental" title="Uma referência estável para cada evidência." description={evidence.notes}>
  <div class="mb-6 grid gap-3 sm:grid-cols-3">
    <KpiCard label="Registros catalogados" value={rows.length} />
    <KpiCard label="Fontes públicas" value={publicRows.length} />
    <KpiCard label="Provas/documentos privados a preservar" value={privateRows.length} />
  </div>
  <div class="mb-6 flex flex-wrap gap-2.5" data-print-hide>
    <ButtonLink href={'/casos/' + slug + '/indice-evidencias.csv'}>Baixar índice CSV ↗</ButtonLink>
    <button class={cn(buttonVariants({ variant: 'outline' }))} type="button" data-print-evidence>Imprimir / salvar PDF</button>
  </div>
  <EvidenceTable rows={tableRows} />
  {compact && <a class="text-link mt-5 inline-block text-sm" href={'/casos/' + slug + '/evidencias/'}>Abrir índice integral ↗</a>}
</Section>
<script>
  document.addEventListener('click', (event) => {
    const el = event.target;
    if (el instanceof Element && el.closest('[data-print-evidence]')) window.print();
  });
</script>
