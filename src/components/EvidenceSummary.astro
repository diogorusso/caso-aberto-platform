---
import { type Case, brl, reportsFor } from '../lib/cases';
interface Props { item: Case }
const { item } = Astro.props;
const n = reportsFor(item).length;
const rows = [
  ['Empresa', item.empresa_resumo],
  ['Valor informado', item.valor_brl ? brl(item.valor_brl) : '—'],
  ['Prazo original', item.prazo_original || '—'],
  ['Status', item.status],
  ['Arquivo público', `${n} relatos indexados`],
  ...(item.procon_protocol ? [['Procon/RJ', item.procon_protocol]] : []),
];
---
<dl class="m-0 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {rows.map(([k, v]) => (
    <div class="border border-white/15 bg-white/5 px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-wider text-white/60">{k}</dt>
      <dd class="m-0 mt-1 font-semibold leading-snug">{v}</dd>
    </div>
  ))}
</dl>
