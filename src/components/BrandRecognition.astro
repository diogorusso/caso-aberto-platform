---
/*
 * Brand recognition strip: logo + sourced store photo + red editorial badge.
 *
 * Why it exists: a text-only case is hard to match to a real-world store. This block
 * makes the brand and unit visually identifiable while keeping every claim sourced and
 * the editorial tone explicit (see AGENTS.md §20 and §22).
 *
 * Data comes from two places, never hardcoded here:
 *  - company-media.json → logo/store photo with origin metadata;
 *  - brands/units recognition block → badge + recommendation copy, per brand/unit.
 *
 * Boundary: one unit's case never becomes proof against the whole network; the badge
 * states our editorial position and never alleges bankruptcy or insolvency.
 */
import media from '../data/company-media.json';
import { brandPath, unitPath, statusLabel, type Brand, type BrandUnit } from '../lib/brands';
import { copy } from '@/lib/copy';
import Section from './layout/Section.astro';
import { Badge } from './ui/badge';
import ButtonLink from './layout/ButtonLink.astro';

interface Props {
  brand: Brand;
  unit?: BrandUnit;
  tone?: 'default' | 'muted' | 'card';
  id?: string;
}
const { brand, unit, tone = 'card', id = 'identificacao-visual' } = Astro.props;

const selected = unit || brand;
const visual = (media.brands as Record<string, any>)[brand.slug];
const unitVisual = unit ? visual?.units?.[unit.slug] : undefined;
const image = (unitVisual?.image ??
  (visual?.units ? Object.values(visual.units).map((v: any) => v.image).find(Boolean) : undefined)) as any;
const logo = visual?.logo;
const recognition = (selected as any).recognition || (brand as any).recognition;
const t = copy.recognition;
const subject = unit ? unit.name : brand.name;
const verdictLabel = recognition?.badge || statusLabel(selected.verdict.status);
const profileHref = unit ? unitPath(brand, unit) : brandPath(brand);
const reviewed = (recognition?.valid_as_of || selected.verdict.valid_as_of || '').split('-').reverse().join('/');
---

{recognition && (
  <Section
    id={id}
    tone={tone}
    eyebrow={t.eyebrow}
    title={t.title}
    description={t.description}
  >
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
      <figure class="relative m-0 overflow-hidden border bg-muted">
        {image?.src ? (
          <img
            class="h-full min-h-[16rem] max-h-[28rem] w-full object-cover"
            src={image.src}
            alt={image.alt}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="grid min-h-[16rem] place-items-center p-8 text-center">
            <div class="space-y-4">
              {logo?.src && (
                <img class="mx-auto max-h-16 w-40 object-contain" src={logo.src} alt={logo.alt} loading="lazy" />
              )}
              <p class="m-0 max-w-sm text-sm text-muted-foreground">{t.storePending}</p>
            </div>
          </div>
        )}

        <!-- Red editorial badge, always over the store image. -->
        <span
          class="absolute left-0 top-0 z-[2] inline-flex items-center gap-2 bg-destructive px-3.5 py-2.5 text-xs font-extrabold uppercase tracking-[0.12em] text-white shadow-lg"
          role="note"
          aria-label={`Posição editorial: ${verdictLabel}`}
        >
          <span class="size-2 bg-white" aria-hidden="true"></span>
          {verdictLabel}
        </span>

        <figcaption class="border-t bg-forest px-5 py-3.5 text-xs leading-relaxed text-white/70">
          <strong class="block font-bold text-white/90">{subject} · {t.photoCaption}</strong>
          {image?.credit && <span>Origem: {image.credit}. </span>}
          {!image?.photographed_at && <span>{t.photoDateUnknown} </span>}
          {image?.source_url && (
            <a
              class="font-bold text-brand no-underline hover:underline"
              href={image.source_url}
              target="_blank"
              rel="noopener noreferrer"
            >{t.sourceLabel} ↗</a>
          )}
        </figcaption>
      </figure>

      <div class="flex flex-col gap-4 border bg-card p-6 md:p-7">
        <div class="flex flex-wrap items-center gap-3">
          {logo?.src ? (
            <span class="inline-flex h-14 w-40 items-center justify-center border bg-white p-2">
              <img class="max-h-9 max-w-[9rem] object-contain" src={logo.src} alt={logo.alt} loading="lazy" />
            </span>
          ) : (
            <span class="grid h-14 w-40 place-items-center border bg-muted text-xl font-extrabold" aria-hidden="true">
              {brand.name.slice(0, 2).toUpperCase()}
            </span>
          )}
          <Badge variant="outline" className="text-muted-foreground">
            {t.logoLabel} · revisão {reviewed || '—'}
          </Badge>
        </div>

        {recognition.kicker && (
          <p class="m-0 text-xs font-extrabold uppercase tracking-[0.14em] text-brand-strong">{recognition.kicker}</p>
        )}
        {recognition.headline && <h3 class="m-0 text-2xl leading-tight md:text-3xl">{recognition.headline}</h3>}
        {recognition.body && <p class="m-0 text-sm leading-relaxed text-muted-foreground">{recognition.body}</p>}
        {recognition.warning && (
          <p class="m-0 border-l-4 border-destructive bg-brand-soft p-3 text-sm font-medium leading-relaxed">
            {recognition.warning}
          </p>
        )}
        {recognition.cta && <p class="m-0 text-lg font-extrabold tracking-tight">{recognition.cta}</p>}

        <div class="mt-auto flex flex-wrap items-center gap-3 pt-1">
          <ButtonLink size="sm" href={profileHref}>{t.cta} ↗</ButtonLink>
        </div>
      </div>
    </div>
  </Section>
)}
