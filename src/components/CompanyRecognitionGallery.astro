---
import media from '../data/company-media.json';
import type { Brand, BrandUnit } from '../lib/brands';
import Section from './layout/Section.astro';
import Eyebrow from './layout/Eyebrow.astro';
import { Card, CardContent } from './ui/card';
interface Props { brand: Brand; unit?: BrandUnit }
const { brand, unit } = Astro.props;
const visual = (media.brands as Record<string, any>)[brand.slug];
const unitVisual = unit ? visual?.units?.[unit.slug] : undefined;
const shots = unit ? unitVisual?.website_capture : visual?.website_capture;
const photo = (unitVisual?.image || (!unit && visual?.units ? Object.values(visual.units).map((v: any) => v.image).find(Boolean) : undefined)) as any;
const logo = visual?.logo;
const recognition = (unit as any)?.recognition || (brand as any).recognition;
const badgeLabel = recognition?.badge;
const siteUrl = shots?.page_url || visual?.website;
---
<Section id="identificacao-visual" tone="card" eyebrow="Arquivo visual com origem" title="Reconheça a empresa e confira os canais oficiais." description="Identidade visual, fachada e website com URLs e metadados para não confundir empresas ou unidades. O material é de referência editorial, não de publicidade.">
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <Card className="gap-0 overflow-hidden py-0">
      <div class="grid h-52 place-items-center border-b bg-white">
        {logo?.src ? <img class="max-h-20 w-2/3 object-contain" src={logo.src} alt={logo.alt} loading="lazy" /> : <strong class="text-5xl tracking-tighter">{brand.name}</strong>}
      </div>
      <CardContent className="space-y-2 p-5 text-sm">
        <Eyebrow>01 / Identidade visual</Eyebrow>
        <h3 class="m-0 text-lg">{brand.name}</h3>
        <p class="m-0 text-muted-foreground">Marca exibida para identificação; não indica associação ou endosso.</p>
        {logo?.source_url && <a class="text-link" href={logo.source_url} target="_blank" rel="noopener noreferrer">Fonte do símbolo ↗</a>}
      </CardContent>
    </Card>
    <Card className="gap-0 overflow-hidden py-0">
      <div class="relative grid h-52 place-items-center border-b bg-muted">
        {photo?.src ? <img class="size-full object-cover" src={photo.src} alt={photo.alt} loading="lazy" /> : <span class="px-6 text-center text-sm text-muted-foreground">Imagem com fonte ainda não catalogada</span>}
        {badgeLabel && (
          <span class="absolute left-0 top-0 inline-flex items-center gap-1.5 bg-destructive px-2.5 py-1.5 text-[0.66rem] font-extrabold uppercase tracking-[0.12em] text-white shadow-md" role="note">
            <span class="size-1.5 bg-white" aria-hidden="true"></span>{badgeLabel}
          </span>
        )}
      </div>
      <CardContent className="space-y-2 p-5 text-sm">
        <Eyebrow>02 / Estabelecimento</Eyebrow>
        <h3 class="m-0 text-lg">{photo?.title || 'Foto da loja pendente'}</h3>
        <p class="m-0 text-muted-foreground">{photo?.address || unit?.location || brand.location}</p>
        {photo?.credit && <p class="m-0 text-muted-foreground">Origem: {photo.credit}. Data da foto não confirmada.</p>}
        {photo?.source_url && <a class="text-link" href={photo.source_url} target="_blank" rel="noopener noreferrer">Fotografia original ↗</a>}
      </CardContent>
    </Card>
    <Card className="gap-0 overflow-hidden py-0">
      <div class="flex h-52 flex-col border-b bg-muted">
        <div class="flex items-center gap-1.5 border-b bg-accent px-3 py-2.5" aria-hidden="true">
          <i class="size-2 border border-muted-foreground/50"></i><i class="size-2 border border-muted-foreground/50"></i><i class="size-2 border border-muted-foreground/50"></i>
          <small class="ml-2 truncate text-[0.68rem] text-muted-foreground">{siteUrl || 'Website oficial'}</small>
        </div>
        <div class="flex flex-1 flex-col justify-center gap-1 p-5">
          <strong class="text-lg">Website oficial</strong>
          <p class="m-0 text-sm text-muted-foreground">Captura de tela em arquivo: {shots?.captured_at || 'ainda não registrada'}</p>
          <span class="text-xs text-muted-foreground">Visualização do site original disponível no link abaixo.</span>
        </div>
      </div>
      <CardContent className="space-y-2 p-5 text-sm">
        <Eyebrow>03 / Presença digital</Eyebrow>
        <h3 class="m-0 text-lg">{shots?.title || 'Site da empresa'}</h3>
        <p class="m-0 text-muted-foreground">Não exibimos screenshot inventado: a captura arquivada deve guardar URL, data, e arquivo original.</p>
        {siteUrl && <a class="text-link" href={siteUrl} target="_blank" rel="noopener noreferrer">Abrir site oficial ↗</a>}
      </CardContent>
    </Card>
  </div>
</Section>
