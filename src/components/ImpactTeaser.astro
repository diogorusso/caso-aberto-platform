---
import { brl, type Case } from '../lib/cases';
import { type Brand, type BrandUnit, findBrand } from '../lib/brands';
import { impactForSelection, caseImpactPath, brandImpactPath, unitImpactPath, brandSnapshot } from '../lib/impact';
import Section from './layout/Section.astro';
import ButtonLink from './layout/ButtonLink.astro';
import BrandTag from './BrandTag.astro';
import { KpiCard } from './ui/kpi-card';
import { Alert, AlertDescription } from './ui/alert';
interface Props { caseItem?: Case; brand?: Brand; unit?: BrandUnit }
const { caseItem, brand, unit } = Astro.props;
const data = impactForSelection({ caseItem, brand, unit });
const target = caseItem ? caseImpactPath(caseItem) : brand && unit ? unitImpactPath(brand, unit) : brand ? brandImpactPath(brand) : '/casos/';
const title = caseItem ? caseItem.empresa_resumo : unit?.name || brand?.name || 'Arquivo';
const snapshot = brand && !unit && !caseItem ? brandSnapshot(brand) : null;
const tagBrand = brand || (caseItem?.empresa_slug ? findBrand(caseItem.empresa_slug) : undefined);
const tagUnit = unit || (caseItem?.unidade_slug ? tagBrand?.units.find((u) => u.slug === caseItem.unidade_slug) : undefined);
---
<Section id="impacto-em-numeros" tone="muted" eyebrow={`Radar de exposição · ${title}`} title="O tamanho do problema, em números." description="Dinheiro envolvido, tempo transcorrido, reclamações e fontes — com datas, recortes e documentação.">
  {tagBrand && <BrandTag slot="action" brand={tagBrand} unit={tagUnit} size="sm" linked />}
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <KpiCard label="Valor já pago, segundo consumidor(es)" value={data.reportedPaymentTotal > 0 ? brl(data.reportedPaymentTotal) : 'Sem valor informado'} />
    <KpiCard label="Reclamações públicas neste recorte" value={data.indexedReportCount.toLocaleString('pt-BR')} note="Inclui relatos resolvidos" />
    <KpiCard label="URLs externas distintas" value={data.sourceCount.toLocaleString('pt-BR')} note="Reclamações, cadastros e publicações" />
    <KpiCard label="Desde o pagamento relatado" value={data.holdDays != null ? data.holdDays + ' dias' : 'Não informado'} note={`Até ${data.model?.snapshot_date || 'última revisão'}`} />
  </div>
  {snapshot && (
    <Alert variant="brand" className="mt-4">
      <AlertDescription className="text-foreground/85">
        <p class="m-0"><strong>Histórico externo da marca:</strong> {snapshot.total_active_records} reclamações ativas listadas no Reclame Aqui; {snapshot.delivery_delay_category_records} classificadas como atraso na entrega. <a class="text-link" href={snapshot.page_url} target="_blank" rel="noopener noreferrer">Conferir fonte e período ↗</a>. Não somamos o total externo aos registros catalogados.</p>
      </AlertDescription>
    </Alert>
  )}
  <div class="mt-6"><ButtonLink href={target}>Abrir painel completo ↗</ButtonLink></div>
</Section>
