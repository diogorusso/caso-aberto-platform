---
import Section from './layout/Section.astro';
import CaseActionBar from './CaseActionBar.astro';
interface Props {title?:string;summary?:string;caseHref?:string;caseId?:string}
const {title='Compartilhe esta investigação',summary='',caseHref=Astro.url.pathname,caseId}=Astro.props;
const slug = caseHref.split('/').filter(Boolean).pop() || '';
---
<div data-print-hide>
  <Section
    tone="dark"
    eyebrow="COMPARTILHE A COBRANÇA"
    title="Um link. Fontes incluídas."
    description="Escreva a cobrança com textos prontos ou envie o dossiê completo. Cada botão faz uma coisa só."
  >
    <CaseActionBar
      compact
      title={title}
      summary={summary}
      href={caseHref}
      caseId={caseId}
      printHref={'/casos/imprimir/'+slug+'/'}
    />
  </Section>
</div>
