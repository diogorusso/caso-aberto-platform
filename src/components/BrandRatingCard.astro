---
import { brandPath, unitPath, statusLabel, type Brand, type BrandUnit } from '../lib/brands';
import { brandImpactPath, unitImpactPath } from '../lib/impact';
import VerdictStatusBadge from './VerdictStatusBadge';
import BrandTag from './BrandTag.astro';
import { Card, CardContent, CardFooter, CardHeader } from './ui/card';
import { copy } from '@/lib/copy';
const t = copy.ratingCard;
interface Props { brand: Brand; unit?: BrandUnit }
const { brand, unit } = Astro.props;
const rated = unit || brand;
const verdict = rated.verdict;
const href = unit ? unitPath(brand, unit) : brandPath(brand);
---
<Card className="h-full">
  <CardHeader className="gap-3">
    <div class="flex items-center justify-between gap-3 border-b pb-3">
      <BrandTag brand={brand} unit={unit} size="md" linked />
      <span class="text-[0.68rem] font-semibold uppercase tracking-wider text-muted-foreground">{unit ? 'Unidade' : 'Perfil de marca'}</span>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <VerdictStatusBadge status={verdict.status} label={statusLabel(verdict.status)} />
      <time class="text-xs text-muted-foreground" datetime={verdict.valid_as_of}>Revisão: {verdict.valid_as_of.split('-').reverse().join('/')}</time>
    </div>
    <h3 class="m-0 text-2xl"><a class="no-underline hover:underline" href={href}>{rated.name}</a></h3>
    <p class="m-0 text-sm text-muted-foreground">{unit ? unit.location : brand.location} · {brand.segment}</p>
  </CardHeader>
  <CardContent className="space-y-2">
    <p class="m-0 font-medium">{verdict.headline}</p>
    <p class="m-0 text-sm text-muted-foreground">{verdict.scope}</p>
  </CardContent>
  <CardFooter className="mt-auto flex-wrap justify-between gap-3 border-t pt-4 text-sm">
    <span class="text-muted-foreground">{t.cases(rated.case_ids.length)}</span>
    <span class="flex flex-wrap gap-4">
      <a class="text-link" href={href}>{t.link} ↗</a>
      <a class="text-link" href={unit ? unitImpactPath(brand, unit) : brandImpactPath(brand)}>{t.impact} ↗</a>
    </span>
  </CardFooter>
</Card>
