---
import { cases, casePath, reports, brl, dateBR } from '../lib/cases';
import { statusLabel, type Brand, type BrandUnit } from '../lib/brands';
import { brandImpactPath, unitImpactPath } from '../lib/impact';
import Section from './layout/Section.astro';
import ButtonLink from './layout/ButtonLink.astro';
import Eyebrow from './layout/Eyebrow.astro';
import VerdictStatusBadge from './VerdictStatusBadge';
import ReportsTable from './tables/ReportsTable';
import BrandTag from './BrandTag.astro';
import { KpiCard } from './ui/kpi-card';
import { copy } from '@/lib/copy';
import { Card, CardContent, CardFooter, CardHeader } from './ui/card';
interface Props { brand: Brand; unit?: BrandUnit; compact?: boolean }
const { brand, unit, compact = false } = Astro.props;
const subject = unit || brand;
const related = cases.filter((c) => subject.case_ids.includes(c.id));
const complaints = reports
  .filter((r) => related.some((c) => r.case_id === c.id))
  .filter((r) => !unit || r.unit?.trim().toLowerCase() === unit.name.replace(brand.name, '').trim().toLowerCase() || ((r.cidade || '').toLowerCase().includes('ipanema') && unit.slug === 'ipanema-rj'));
const classified = complaints.slice().sort((a, b) => b.data.localeCompare(a.data));
const limit = compact ? 6 : 24;
const t = copy.company.matrix;
const title = unit ? t.titleUnit : t.titleBrand;
---
<Section id="casos-associados" eyebrow={t.eyebrow} title={title} description={t.description}>
  <div class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
    <KpiCard tone="muted" label={t.stats.cases} value={related.length} />
    <KpiCard tone="muted" label={t.stats.complaints} value={complaints.length} />
    <KpiCard tone="muted" label={t.stats.places} value={new Set(complaints.map((r) => r.cidade)).size} />
    <KpiCard tone="muted" label={t.stats.reviewed} value={subject.verdict.valid_as_of.split('-').reverse().join('/')} />
  </div>
  <div class="space-y-4">
    {related.map((c) => (
      <Card className="border-l-4 border-l-brand-strong">
        <CardHeader className="gap-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <BrandTag brand={brand} unit={brand.units.find((u: BrandUnit) => u.slug === c.unidade_slug)} size="sm" linked />
            <Eyebrow>{c.empresa_resumo} · {c.categoria}</Eyebrow>
            <VerdictStatusBadge status={subject.verdict.status} label={statusLabel(subject.verdict.status)} />
          </div>
          <h3 class="m-0 text-2xl"><a class="no-underline hover:underline" href={casePath(c)}>{c.titulo}</a></h3>
          <p class="m-0 max-w-4xl text-muted-foreground">{c.resumo}</p>
        </CardHeader>
        <CardContent>
          <dl class="m-0 grid gap-3 md:grid-cols-3">
            <div class="bg-muted p-3"><dt class="text-xs uppercase tracking-wider text-muted-foreground">{t.paid}</dt><dd class="m-0 mt-1 font-semibold">{c.valor_brl ? brl(c.valor_brl) : 'Não informado'}</dd></div>
            <div class="bg-muted p-3"><dt class="text-xs uppercase tracking-wider text-muted-foreground">{t.status}</dt><dd class="m-0 mt-1 font-semibold">{c.status}</dd></div>
            <div class="bg-muted p-3"><dt class="text-xs uppercase tracking-wider text-muted-foreground">{t.reviewed}</dt><dd class="m-0 mt-1 font-semibold">{dateBR(c.status_data)}</dd></div>
          </dl>
        </CardContent>
        <CardFooter><ButtonLink href={casePath(c)}>{t.caseLink} ↗</ButtonLink></CardFooter>
      </Card>
    ))}
  </div>
  {classified.length > 0 && (
    <div class="mt-10 space-y-4">
      <h3 class="m-0">Arquivo de reclamações públicas associadas a este recorte</h3>
      <ReportsTable rows={classified.slice(0, limit).map((r) => ({ id: r.id, data: r.data, cidade: r.cidade, titulo: r.titulo, tema: r.tema, status: r.status, url: r.url }))} />
      <p class="m-0 text-sm text-muted-foreground">Total exibido: {Math.min(classified.length, limit)} de {classified.length} registros deste recorte. Reclamações resolvidas permanecem identificadas como resolvidas.</p>
    </div>
  )}
  <div class="mt-8"><ButtonLink variant="outline" href={unit ? unitImpactPath(brand, unit) : brandImpactPath(brand)}>Painel de impacto e fontes ↗</ButtonLink></div>
</Section>
