---
import contractData from '../data/case-contract-entities.json';
import registries from '../data/company-profiles.json';
import { cases, casePath } from '../lib/cases';
import Section from './layout/Section.astro';
import Eyebrow from './layout/Eyebrow.astro';
import { Badge } from './ui/badge';
import { Card, CardContent, CardHeader } from './ui/card';
interface Props { caseId: string; compact?: boolean }
const { caseId, compact = false } = Astro.props;
const entry = (contractData.cases as Record<string, any>)[caseId];
const businessFor = (cnpj: string) => registries.entities.find((e) => e.cnpj.replace(/\D/g, '') === cnpj.replace(/\D/g, ''));
const linkedCase = cases.find((c) => c.id === caseId);
const responsibleRoute = linkedCase ? casePath(linkedCase) + 'responsaveis/' : '/casos/';
---
<Section id="entidades-do-contrato" tone="muted" eyebrow="Responsabilidade contratual" title="Quais CNPJs aparecem no contrato?" description="Fábrica, montadora, quem recebeu o pagamento: só entra com CNPJ no documento. Endereço igual no cadastro não basta. Exija o contrato.">
  <div class="grid gap-4 md:grid-cols-2">
    {entry?.slots?.map((slot: any) => {
      const confirmed = slot.cnpj && slot.display_name && slot.verified_at;
      return (
        <Card className="border-t-4 border-t-forest">
          <CardHeader className="gap-2">
            <Eyebrow>{slot.contract_role}</Eyebrow>
            <h3 class="m-0 text-xl">{confirmed ? slot.display_name : 'Identificação aguardando conferência'}</h3>
          </CardHeader>
          <CardContent className="space-y-2 text-sm">
            {confirmed ? (
              <>
                <p class="m-0"><strong>CNPJ:</strong> {slot.cnpj}</p>
                <p class="m-0"><strong>Conferido em:</strong> {slot.verified_at.split('-').reverse().join('/')}</p>
                {slot.verification_source_url && <a class="text-link" href={slot.verification_source_url} target="_blank" rel="noopener noreferrer">Fonte da verificação ↗</a>}
                {slot.directors?.length > 0 && (
                  <div class="mt-3 space-y-1 border-t pt-3">
                    <h4 class="m-0">Administradores vinculados ao CNPJ confirmado</h4>
                    {slot.directors.map((person: any) => <p class="m-0"><strong>{person.name}</strong> — {person.role} · <a class="text-link" href={person.source_url} target="_blank" rel="noopener noreferrer">QSA ↗</a></p>)}
                  </div>
                )}
                {businessFor(slot.cnpj) && <p class="m-0"><a class="text-link" href={'/cnpj/' + slot.cnpj.replace(/\D/g, '') + '/'}>Perfil cadastral ↗</a></p>}
              </>
            ) : (
              <>
                <p class="m-0 text-muted-foreground">Cadê o CNPJ desta função no contrato? Assim que o documento confirmar, publicamos razão social e administradores.</p>
                <Badge variant="warning" className="whitespace-normal">Ainda sem CNPJ confirmado neste slot — a empresa precisa esclarecer</Badge>
              </>
            )}
          </CardContent>
        </Card>
      );
    })}
  </div>
  <p class="mt-5 mb-3 text-sm text-muted-foreground">{entry?.public_contact_note || 'Quem responde por cada etapa? Só com CNPJ no documento.'}</p>
  {compact && <a class="text-link text-sm" href={responsibleRoute}>Como conferimos as entidades do caso ↗</a>}
</Section>
