---
import Identity from './Identity.astro';
import MobileNav from './MobileNav';
import { primaryNav, navItemIsActive } from '@/lib/navigation';
import { cn } from '@/lib/utils';
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-white/10 bg-primary text-primary-foreground" data-print-hide>
  <div class="container flex h-14 items-center justify-between gap-8">
    <Identity />
    <nav aria-label="Principal" class="site-nav hidden items-center gap-6 lg:flex">
      {primaryNav.map((item) => (
        <a
          href={item.href}
          aria-current={navItemIsActive(item, current) ? 'page' : undefined}
          class={cn(
            'border-b-2 border-transparent py-1 text-sm font-medium whitespace-nowrap text-white/65 no-underline transition-colors hover:text-white',
            navItemIsActive(item, current) && 'border-brand text-white',
          )}
        >{item.label}</a>
      ))}
    </nav>
    <div class="lg:hidden">
      <MobileNav client:media="(max-width: 1023px)" items={primaryNav} current={current} />
    </div>
  </div>
  <noscript>
    <style>.site-nav{display:flex!important;overflow-x:auto}@media(max-width:1023px){.site-nav{position:absolute;left:0;right:0;top:3.5rem;background:#121b18;padding:.5rem 1rem}}</style>
  </noscript>
</header>
