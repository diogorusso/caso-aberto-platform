---
import Identity from './Identity.astro';
import MobileNav from './MobileNav';
import { primaryNav, navItemIsActive, bestMatchingHref } from '@/lib/navigation';
import { cn } from '@/lib/utils';
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-white/10 bg-primary text-primary-foreground" data-print-hide>
  <div class="container flex h-16 items-center justify-between gap-6">
    <Identity />
    <nav aria-label="Principal" class="site-nav hidden items-center gap-1 lg:flex">
      {primaryNav.map((item) => (
        item.children?.length ? (
          <details class="group relative">
            <summary
              class={cn(
                'flex cursor-pointer list-none items-center gap-1.5 px-3 py-2 text-sm font-medium whitespace-nowrap text-white/70 transition-colors marker:content-none hover:bg-white/10 hover:text-white [&::-webkit-details-marker]:hidden',
                navItemIsActive(item, current) && 'bg-white/10 text-white',
              )}
            >
              <span>{item.label}</span>
              <span class="text-[0.65rem] text-white/45 transition group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div class="absolute top-full left-0 z-50 min-w-[18rem] border border-white/10 bg-[#121b18] py-2 shadow-xl">
              {item.description && (
                <p class="m-0 border-b border-white/10 px-4 py-2.5 text-xs leading-relaxed text-white/50">{item.description}</p>
              )}
              {item.children.map((child) => {
                const activeChild = bestMatchingHref(current, item.children ?? []) === child.href;
                return (
                <a
                  href={child.href}
                  aria-current={activeChild ? 'page' : undefined}
                  class={cn(
                    'block px-4 py-2.5 no-underline transition-colors hover:bg-white/10',
                    activeChild ? 'bg-white/10 text-white' : 'text-white/75 hover:text-white',
                  )}
                >
                  <span class="block text-sm font-semibold">{child.label}</span>
                  {child.description && <span class="mt-0.5 block text-xs leading-snug text-white/45">{child.description}</span>}
                </a>
              )})}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            aria-current={navItemIsActive(item, current) ? 'page' : undefined}
            class={cn(
              'px-3 py-2 text-sm font-medium whitespace-nowrap text-white/70 no-underline transition-colors hover:bg-white/10 hover:text-white',
              navItemIsActive(item, current) && 'bg-white/10 text-white',
            )}
          >{item.label}</a>
        )
      ))}
    </nav>
    <div class="lg:hidden">
      <MobileNav client:media="(max-width: 1023px)" items={primaryNav} current={current} />
    </div>
  </div>
  <noscript>
    <style>.site-nav{display:flex!important;overflow-x:auto}@media(max-width:1023px){.site-nav{position:absolute;left:0;right:0;top:4rem;background:#121b18;padding:.5rem 1rem}}</style>
  </noscript>
</header>
<script is:inline>
  (() => {
    const nav = document.querySelector('.site-nav');
    if (!nav) return;
    nav.addEventListener('toggle', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLDetailsElement) || !target.open) return;
      nav.querySelectorAll('details[open]').forEach((node) => {
        if (node !== target) node.open = false;
      });
    });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node) || nav.contains(event.target)) return;
      nav.querySelectorAll('details[open]').forEach((node) => { node.open = false; });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      nav.querySelectorAll('details[open]').forEach((node) => { node.open = false; });
    });
  })();
</script>
