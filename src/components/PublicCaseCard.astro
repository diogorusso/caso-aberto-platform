---
interface Props {
  study: {
    slug: string; company: string; sector: string; headline: string; deck: string;
    status_label: string; key_fact: {metric:string;label:string;period:string};
    reviewed_at: string; record_type: string;
  };
  compact?: boolean;
}
const {study,compact=false} = Astro.props;
const url='https://casoaberto.pages.dev/casos/arquivo-publico/'+study.slug+'/';
const whatsapp='https://wa.me/?text='+encodeURIComponent('CasoAberto: '+study.headline+'\nLeia documentos, cronologia e perguntas: '+url);
---
<article class="flex flex-col gap-4 border border-border bg-card p-6">
  <img src={"/og/casos/"+study.slug+".png"} alt={"Imagem de apresentação do caso "+study.company} class="aspect-[1200/630] w-full rounded-md border border-border object-cover" width="1200" height="630" loading="lazy" decoding="async"/>
  <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-semibold uppercase tracking-wide">
    <span class="text-brand-strong">{study.sector}</span>
    <span class="text-muted-foreground">PESQUISA CASOABERTO · {study.reviewed_at.split('-').reverse().join('/')}</span>
  </div>
  <h3 class:list={["m-0 leading-tight",compact?"text-xl":"text-2xl"]}>{study.headline}</h3>
  <p class="m-0 text-sm font-semibold">{study.company}</p>
  <p class="m-0 flex-1 text-muted-foreground">{study.deck}</p>
  <div class="border-l-4 border-brand bg-muted p-4">
    <strong class="text-2xl">{study.key_fact.metric}</strong>
    <p class="m-0 text-sm">{study.key_fact.label}</p>
    <p class="mt-2 text-xs text-muted-foreground">{study.key_fact.period}</p>
  </div>
  <p class="m-0 text-xs text-muted-foreground">{study.status_label}</p>
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-3"><a class="text-link font-semibold" href={'/casos/arquivo-publico/'+study.slug+'/'}>Abrir investigação ↗</a><a class="inline-flex min-h-11 items-center rounded-md border border-[#1c9c64] px-3 py-2 text-sm font-bold text-[#168557] no-underline hover:bg-muted" href={whatsapp} target="_blank" rel="noopener noreferrer">Compartilhar WhatsApp ↗</a></div>
</article>
