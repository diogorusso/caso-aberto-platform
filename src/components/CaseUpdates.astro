---
import { type Case, updatesFor, dateBR } from '../lib/cases';
interface Props { item: Case; limit?: number }
const { item, limit } = Astro.props;
const list = limit ? updatesFor(item).slice(0, limit) : updatesFor(item);
---
<ol class="m-0 list-none divide-y border-y p-0">
  {list.map((u) => (
    <li class="space-y-1.5 py-5">
      <time datetime={u.date} class="text-sm font-semibold text-brand-strong">{dateBR(u.date)}</time>
      <h3 class="m-0 text-lg">{u.title}</h3>
      <p class="m-0 text-muted-foreground">{u.summary}</p>
      {u.source_url && <a class="text-link text-sm" href={u.source_url} target="_blank" rel="noopener noreferrer">Fonte ↗</a>}
    </li>
  ))}
</ol>
