---
import { leadership } from '../lib/cases';
import { Card, CardContent, CardHeader, CardTitle } from './ui/card';
---
<div class="space-y-8">
  <div class="space-y-1">
    <p class="m-0 text-muted-foreground">{leadership.manufacturer_note}</p>
    <p class="m-0 text-xs font-semibold uppercase tracking-wider text-brand-strong">Última verificação: {leadership.last_verified_at}</p>
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    {leadership.people.map((person) => (
      <Card>
        <CardHeader className="gap-1">
          <CardTitle className="text-lg">{person.name}</CardTitle>
          <p class="m-0 text-sm text-muted-foreground">{person.role}</p>
        </CardHeader>
        <CardContent className="space-y-2 text-sm">
          <p class="m-0"><strong>Escopo:</strong> {person.scope}</p>
          <p class="m-0"><strong>Status:</strong> {person.status}</p>
          {person.notes && <p class="m-0 text-muted-foreground">{person.notes}</p>}
          <ul class="m-0 list-disc space-y-1 pl-5 text-muted-foreground">
            {person.sources.map((s) => <li><a class="text-link" href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a>{s.published_at && <span> · {s.published_at}</span>}</li>)}
          </ul>
          {person.linkedin_url
            ? <p class="m-0"><a class="text-link" href={person.linkedin_url} target="_blank" rel="noopener noreferrer">Perfil profissional ↗</a></p>
            : <p class="m-0 text-muted-foreground">LinkedIn não listado — URL não confirmada nesta verificação.</p>}
        </CardContent>
      </Card>
    ))}
  </div>
  <Card className="bg-muted shadow-none">
    <CardHeader><CardTitle className="text-lg">Franquia Ipanema (contatos públicos)</CardTitle></CardHeader>
    <CardContent className="space-y-2 text-sm">
      <p class="m-0">{leadership.franchise.address}</p>
      <p class="m-0">Tel.: {leadership.franchise.phone_public}</p>
      <p class="m-0">E-mail público: {leadership.franchise.email_public}</p>
      <a class="text-link" href={leadership.franchise.official_page} target="_blank" rel="noopener noreferrer">Página oficial da franquia ↗</a>
      <p class="m-0 text-muted-foreground">{leadership.franchise.notes}</p>
      {leadership.franchise.operators_public?.length > 0 && (
        <div class="space-y-2 border-t pt-3">
          <h4 class="m-0">Administradores registrados da empresa no endereço da unidade</h4>
          <ul class="m-0 list-none divide-y p-0">{leadership.franchise.operators_public.map((o) => <li class="py-2"><strong>{o.name}</strong> — {o.role} · <a class="text-link" href={o.source} target="_blank" rel="noopener noreferrer">Cadastro ↗</a></li>)}</ul>
        </div>
      )}
    </CardContent>
  </Card>
  <div class="grid gap-8 md:grid-cols-2">
    <div class="space-y-3">
      <h3 class="m-0">Perguntas institucionais em aberto</h3>
      <ol class="m-0 list-decimal space-y-2 pl-5 text-sm">{leadership.institutional_questions.map((q) => <li>{q}</li>)}</ol>
    </div>
    <div class="space-y-3">
      <h3 class="m-0">Canais oficiais para resposta documentada</h3>
      <ul class="m-0 list-none divide-y p-0 text-sm">{leadership.channels.map((c) => <li class="py-2"><a class="text-link" href={c.url} target="_blank" rel="noopener noreferrer">{c.label}</a></li>)}</ul>
    </div>
  </div>
</div>
