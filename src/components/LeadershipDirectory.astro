---
import { leadership } from '../lib/cases';
---
<section class="leadership">
  <p class="note-inline">{leadership.manufacturer_note}</p>
  <p class="meta">Última verificação: {leadership.last_verified_at}</p>
  <div class="lead-grid">
    {leadership.people.map((person) => (
      <article class="lead-card">
        <h3>{person.name}</h3>
        <p class="lead-role">{person.role}</p>
        <p><strong>Escopo:</strong> {person.scope}</p>
        <p><strong>Status:</strong> {person.status}</p>
        {person.notes && <p class="muted">{person.notes}</p>}
        <ul class="source-mini">
          {person.sources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a>{s.published_at && <span> · {s.published_at}</span>}</li>
          ))}
        </ul>
        {!person.linkedin_url && <p class="muted">LinkedIn não listado — URL não confirmada nesta verificação.</p>}
      </article>
    ))}
  </div>
  <aside class="info-panel">
    <h3>Franquia Ipanema (contatos públicos)</h3>
    <p>{leadership.franchise.address}</p>
    <p>Tel.: {leadership.franchise.phone_public}</p>
    <p>E-mail público: {leadership.franchise.email_public}</p>
    <a class="text-link" href={leadership.franchise.official_page} target="_blank" rel="noopener noreferrer">Página oficial da franquia ↗</a>
    <p class="muted">{leadership.franchise.notes}</p>
  </aside>
  <div class="section" style="padding-top:40px">
    <h3>Perguntas institucionais em aberto</h3>
    <ol class="editor-list">{leadership.institutional_questions.map((q) => <li>{q}</li>)}</ol>
    <h3>Canais oficiais para resposta documentada</h3>
    <ul class="source-links">{leadership.channels.map((c) => <li><a href={c.url} target="_blank" rel="noopener noreferrer">{c.label}</a></li>)}</ul>
  </div>
</section>
