---
import {Badge} from './ui/badge';
import CaseEvidenceChart from './CaseEvidenceChart.astro';
import CaseImpactDrawer from './CaseImpactDrawer.astro';
import ImpactMetricGrid from './islands/ImpactMetricGrid';
import StoryConsequencePanel from './islands/StoryConsequencePanel';
import {caseStory,printStoryPath} from '../lib/visual-impact';
import {caseStudies,personalStories} from '../lib/case-catalog';
import {cases} from '../lib/cases';
import {printKitForCase,printKitPath} from '../lib/print-kits';
import {AlertTriangle,ShieldCheck,ArrowRight,Printer,BookOpenCheck,TrendingUp,Scale,Clock3} from 'lucide-react';
interface Props {caseId:string;compact?:boolean}
const {caseId,compact=false}=Astro.props;
const story=caseStory(caseId);
const catalog=caseStudies.find(x=>x.id===caseId)||personalStories.find(x=>x.id===caseId);
const slug=catalog?.slug||story.href.split('/').filter(Boolean).pop()||caseId.toLowerCase();
const printHref=printStoryPath(slug);
const own=cases.find(x=>x.id===caseId);
const kit=own&&printKitForCase(own)?printKitPath(own):null;
const date=(s:string)=>s.split('-').reverse().join('/');
---
<section id="impacto-visual" class:list={['case-story scroll-mt-24',compact?'py-6':'border-y border-border bg-muted py-12 md:py-16']} aria-labelledby={'story-title-'+caseId}>
  <div class:list={[compact?'':'container','case-story-stack']}>
    <header class="case-story-header case-story-grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <div class="max-w-4xl space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <Badge variant="outline" className="bg-card"><TrendingUp size={13} className="mr-1 inline-block" aria-hidden="true"/> IMPACTO DOCUMENTADO</Badge>
          <Badge variant="outline" className="bg-card">REVISÃO {date(story.date)}</Badge>
        </div>
        <p class="m-0 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-brand-strong">{story.audience}</p>
        <h2 id={'story-title-'+caseId} class="m-0 max-w-3xl text-3xl leading-tight tracking-tight md:text-4xl">{story.headline}</h2>
        <p class="m-0 max-w-3xl text-base leading-relaxed text-muted-foreground md:text-lg">{story.exposure}</p>
      </div>
      <div class="flex flex-wrap items-center gap-2" data-print-hide>
        <CaseImpactDrawer caseId={caseId} triggerLabel="Ver impacto e fontes" />
        <a href={printHref} class="inline-flex min-h-11 items-center justify-center gap-2 border border-border bg-card px-4 py-3 text-sm font-bold text-foreground no-underline hover:border-brand-strong hover:text-brand-strong"><Printer size={17} aria-hidden="true"/> Imprimir ficha A4</a>
      </div>
    </header>

    <ImpactMetricGrid client:visible metrics={story.metrics}/>

    <div class="case-story-grid xl:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.9fr)]">
      <CaseEvidenceChart title={story.graphTitle} description={story.graphDescription} points={story.points} bars={story.bars} sourceUrl={story.graphSource}/>
      <StoryConsequencePanel client:visible worstCase={story.worst_case} threshold={story.threshold}/>
    </div>

    <section class="border border-border bg-card" aria-label="Caminhos documentais do caso">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4">
        <h3 class="m-0 flex items-center gap-2 text-xl"><Scale size={20} className="text-brand-strong" aria-hidden="true"/> Acompanhamento sem adivinhação</h3>
        <span class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Condições observáveis · sem controles hipotéticos</span>
      </div>
      <div class="grid gap-0 md:grid-cols-3">
        <div class="border-b border-border p-5 md:border-b-0 md:border-r"><div class="flex items-center gap-2 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-brand-strong"><Clock3 size={15} aria-hidden="true"/> 01 · Agora</div><h4 class="my-2 text-lg">O que já está em jogo</h4><p class="m-0 text-sm leading-relaxed text-muted-foreground">{story.exposure}</p></div>
        <div class="border-b border-border bg-brand-soft/40 p-5 md:border-b-0 md:border-r"><div class="flex items-center gap-2 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-brand-strong"><AlertTriangle size={15} aria-hidden="true"/> 02 · Se persistir</div><h4 class="my-2 text-lg">O agravamento possível</h4><p class="m-0 text-sm leading-relaxed">{story.worst_case}</p></div>
        <div class="p-5"><div class="flex items-center gap-2 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-success"><ShieldCheck size={15} aria-hidden="true"/> 03 · Para resolver</div><h4 class="my-2 text-lg">Qual prova encerra a pendência?</h4><p class="m-0 text-sm leading-relaxed text-muted-foreground">{story.resolution}</p></div>
      </div>
      <div class="flex flex-wrap items-center gap-3 border-t border-border bg-muted/60 px-5 py-4"><BookOpenCheck size={18} className="shrink-0 text-brand-strong" aria-hidden="true"/><strong class="text-sm">Cobre uma resposta verificável:</strong><span class="text-sm">{story.action}</span><a href={story.href} class="ml-auto inline-flex items-center gap-1 text-sm font-bold text-brand-strong">Ler o dossiê <ArrowRight size={15} aria-hidden="true"/></a></div>
    </section>

    <section id="materiais-impressao" class="scroll-mt-24 case-story-grid border-t-4 border-brand bg-forest p-5 text-forest-foreground md:grid-cols-[minmax(0,1fr)_minmax(16rem,.6fr)] md:p-8" aria-label="Material impresso do caso">
      <div class="space-y-4">
        <div class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.16em] text-brand"><Printer size={17} aria-hidden="true"/> MATERIAL DE IMPRESSÃO · {story.id}</div>
        <h3 class="m-0 text-2xl leading-tight md:text-3xl">Transforme a investigação em uma ficha que pode circular.</h3>
        <p class="m-0 max-w-2xl text-sm leading-relaxed text-white/75">Um material A4 com a pergunta principal, os dados registrados, a consequência para a comunidade, os documentos e a data de revisão. Sem copiar informações privadas.</p>
        <div class="space-y-3">
          <a href={printHref} class="inline-flex min-h-11 items-center gap-2 bg-brand px-4 py-3 text-sm font-bold text-brand-foreground no-underline hover:bg-white"><Printer size={16} aria-hidden="true"/> Abrir ficha A4 <ArrowRight size={15} aria-hidden="true"/></a>
          {kit && <p class="m-0 text-sm text-white/70"><a class="font-semibold text-brand no-underline hover:underline" href={kit}>Também disponível: cartazes e panfletos ↗</a></p>}
        </div>
      </div>
      <div class="bg-white p-5 text-foreground shadow-xl" aria-label="Prévia da ficha pública">
        <div class="flex justify-between border-b-2 border-primary pb-3 text-[.68rem] font-black uppercase tracking-[.1em]"><span>CASOABERTO / DOCUMENTAÇÃO</span><span>{story.id}</span></div>
        <div class="my-5"><p class="m-0 text-[.62rem] font-bold uppercase tracking-[.13em] text-brand-strong">{story.audience}</p><p class="mt-2 text-lg font-extrabold leading-snug">{story.headline}</p><p class="mt-2 text-xs leading-relaxed">{story.exposure}</p></div>
        <div class="border-l-[3px] border-brand-strong bg-muted p-3"><p class="m-0 text-[.6rem] font-bold uppercase tracking-wide text-brand-strong">Se continuar sem solução</p><p class="mb-0 mt-2 text-xs leading-relaxed">{story.worst_case}</p></div>
        <p class="mb-0 mt-5 text-[.65rem] text-muted-foreground">Fontes e data · revisão {date(story.date)} · {story.sources.length} referências documentais</p>
      </div>
    </section>
  </div>
</section>
<style>
.case-story-header{animation:story-enter .55s cubic-bezier(.22,1,.36,1) both}
@keyframes story-enter{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.case-story-header{animation:none}}
</style>
