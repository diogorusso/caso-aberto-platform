---
import {Badge} from './ui/badge';
import CaseEvidenceChart from './CaseEvidenceChart.astro';
import {caseStory,printStoryPath} from '../lib/visual-impact';
import {caseStudies} from '../lib/case-catalog';
import {cases} from '../lib/cases';
import {printKitForCase,printKitPath} from '../lib/print-kits';
import {Wallet,Clock3,Files,Network,FileSearch,AlertTriangle,ShieldCheck,ArrowRight,Printer,ExternalLink,BookOpenCheck,TrendingUp,Scale,Download} from 'lucide-react';
interface Props {caseId:string;compact?:boolean}
const {caseId,compact=false}=Astro.props;
const story=caseStory(caseId);
const catalog=caseStudies.find(x=>x.id===caseId);
const slug=catalog?.slug||story.href.split('/').filter(Boolean).pop()||caseId.toLowerCase();
const printHref=printStoryPath(slug);
const own=cases.find(x=>x.id===caseId);
const kit=own&&printKitForCase(own)?printKitPath(own):null;
const icons=[Wallet,Clock3,Files,Network];
const date=(s:string)=>s.split('-').reverse().join('/');
---
<section id="impacto-visual" class:list={['case-story scroll-mt-24',compact?'py-6':'border-y border-border bg-muted py-12 md:py-16']} aria-labelledby={'story-title-'+caseId}>
  <div class:list={[compact?'':'container','space-y-8']}>
    <header class="grid items-end gap-5 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div class="max-w-4xl space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <Badge variant="outline" className="bg-card"><TrendingUp size={13} className="mr-1 inline-block" aria-hidden="true"/> IMPACTO DOCUMENTADO</Badge>
          <Badge variant="outline" className="bg-card">REVISÃO {date(story.date)}</Badge>
        </div>
        <p class="m-0 text-xs font-bold uppercase tracking-[.16em] text-brand-strong">{story.audience}</p>
        <h2 id={'story-title-'+caseId} class="m-0 max-w-3xl text-3xl leading-tight tracking-tight md:text-4xl">{story.headline}</h2>
        <p class="m-0 text-lg leading-relaxed text-muted-foreground">{story.exposure}</p>
      </div>
      <a href={printHref} class="inline-flex min-h-11 items-center justify-center gap-2 border border-border bg-card px-4 py-3 text-sm font-bold text-foreground no-underline hover:border-brand-strong hover:text-brand-strong"><Printer size={17} aria-hidden="true"/> Material para imprimir <ArrowRight size={16} aria-hidden="true"/></a>
    </header>

    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {story.metrics.map((m,i)=>{
        const Icon=icons[i%icons.length];
        return <div class="case-impact-stat flex min-w-0 flex-col gap-3 border border-border border-t-4 border-t-brand bg-card px-5 py-5">
          <div class="flex items-start justify-between gap-3 text-muted-foreground"><span class="text-xs font-semibold uppercase leading-snug tracking-wide">{m.label}</span><Icon size={17} className="shrink-0 text-brand-strong" aria-hidden="true"/></div>
          <strong class="block text-2xl font-extrabold tracking-tight tabular-nums break-words md:text-3xl">{m.value}</strong>
          <p class="m-0 flex-1 text-xs leading-relaxed text-muted-foreground">{m.note}</p>
          {m.href&&<a href={m.href} class="inline-flex items-center gap-1 text-xs font-semibold text-brand-strong">Conferir fonte <ExternalLink size={12} aria-hidden="true"/></a>}
        </div>;
      })}
    </div>

    <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.1fr)_minmax(19rem,.9fr)]">
      <CaseEvidenceChart title={story.graphTitle} description={story.graphDescription} points={story.points} bars={story.bars} sourceUrl={story.graphSource}/>
      <div class="grid gap-3">
        <article class="border border-border border-t-4 border-t-brand-strong bg-card p-6">
          <div class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.14em] text-brand-strong"><AlertTriangle size={17} aria-hidden="true"/> SE A SITUAÇÃO CONTINUAR</div>
          <h3 class="mb-3 mt-4 text-2xl leading-snug">Qual consequência não pode ser ignorada?</h3>
          <p class="m-0 text-base leading-relaxed">{story.worst_case}</p>
        </article>
        <article class="border border-border bg-card p-6">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-[.14em] text-muted-foreground"><FileSearch size={16} aria-hidden="true"/> O QUE MUDA O STATUS</div>
          <p class="mb-0 mt-3 leading-relaxed">{story.threshold}</p>
        </article>
      </div>
    </div>

    <section class="border border-border bg-card" aria-label="Caminhos documentais do caso">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4 md:px-6">
        <h3 class="m-0 flex items-center gap-2 text-xl"><Scale size={20} className="text-brand-strong" aria-hidden="true"/> Acompanhamento sem adivinhação</h3>
        <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">CONDIÇÕES OBSERVÁVEIS · SEM CONTROLES HIPOTÉTICOS</span>
      </div>
      <div class="grid gap-0 md:grid-cols-3">
        <div class="border-b border-border p-5 md:border-b-0 md:border-r md:p-6"><div class="flex items-center gap-2 text-xs font-bold uppercase tracking-[.14em] text-brand-strong"><Clock3 size={16} aria-hidden="true"/> 01 · AGORA</div><h4 class="my-2 text-lg">O que já está em jogo</h4><p class="m-0 text-sm leading-relaxed text-muted-foreground">{story.exposure}</p></div>
        <div class="border-b border-border bg-brand-soft/40 p-5 md:border-b-0 md:border-r md:p-6"><div class="flex items-center gap-2 text-xs font-bold uppercase tracking-[.14em] text-brand-strong"><AlertTriangle size={16} aria-hidden="true"/> 02 · SE PERSISTIR</div><h4 class="my-2 text-lg">O agravamento possível</h4><p class="m-0 text-sm leading-relaxed">{story.worst_case}</p></div>
        <div class="p-5 md:p-6"><div class="flex items-center gap-2 text-xs font-bold uppercase tracking-[.14em] text-success"><ShieldCheck size={16} aria-hidden="true"/> 03 · PARA RESOLVER</div><h4 class="my-2 text-lg">Qual prova encerra a pendência?</h4><p class="m-0 text-sm leading-relaxed text-muted-foreground">{story.resolution}</p></div>
      </div>
      <div class="flex flex-wrap items-center gap-3 border-t border-border bg-muted/60 px-5 py-4 md:px-6"><BookOpenCheck size={18} className="shrink-0 text-brand-strong" aria-hidden="true"/><strong class="text-sm">Cobre uma resposta verificável:</strong><span class="text-sm">{story.action}</span><a href={story.href} class="ml-auto inline-flex items-center gap-1 text-sm font-bold text-brand-strong">Ler o dossiê <ArrowRight size={15} aria-hidden="true"/></a></div>
    </section>

    <section id="materiais-impressao" class="scroll-mt-24 grid gap-5 border-t-4 border-brand bg-forest p-6 text-forest-foreground md:grid-cols-[minmax(0,1fr)_minmax(16rem,.6fr)] md:p-8" aria-label="Material impresso do caso">
      <div class="space-y-4">
        <div class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.16em] text-brand"><Printer size={17} aria-hidden="true"/> MATERIAL DE IMPRESSÃO · {story.id}</div>
        <h3 class="m-0 text-2xl leading-tight md:text-3xl">Transforme a investigação em uma ficha que pode circular.</h3>
        <p class="m-0 max-w-2xl text-sm leading-relaxed text-white/75">Um material A4 com a pergunta principal, os dados registrados, a consequência para a comunidade, os documentos e a data de revisão. Sem copiar informações privadas.</p>
        <div class="flex flex-wrap gap-2"><a href={printHref} class="inline-flex min-h-11 items-center gap-2 bg-brand px-4 py-3 text-sm font-bold text-brand-foreground no-underline hover:bg-white"><Printer size={16} aria-hidden="true"/> Abrir ficha A4 <ArrowRight size={15} aria-hidden="true"/></a>{kit&&<a href={kit} class="inline-flex min-h-11 items-center gap-2 border border-white/40 px-4 py-3 text-sm font-semibold text-white no-underline hover:bg-white/10"><Download size={16} aria-hidden="true"/> Cartazes e panfletos</a>}</div>
      </div>
      <div class="bg-white p-5 text-foreground shadow-xl" aria-label="Prévia da ficha pública">
        <div class="flex justify-between border-b-2 border-primary pb-3 text-[.68rem] font-black uppercase tracking-[.1em]"><span>CASOABERTO / DOCUMENTAÇÃO</span><span>{story.id}</span></div>
        <div class="my-5"><p class="m-0 text-[.62rem] font-bold uppercase tracking-[.13em] text-brand-strong">{story.audience}</p><p class="mt-2 text-lg font-extrabold leading-snug">{story.headline}</p><p class="mt-2 text-xs leading-relaxed">{story.exposure}</p></div>
        <div class="border-l-[3px] border-brand-strong bg-muted p-3"><p class="m-0 text-[.6rem] font-bold uppercase tracking-wide text-brand-strong">Se continuar sem solução</p><p class="mb-0 mt-2 text-xs leading-relaxed">{story.worst_case}</p></div>
        <p class="mb-0 mt-5 text-[.65rem] text-muted-foreground">Fontes e data · revisão {date(story.date)} · {story.sources.length} referências documentais</p>
      </div>
    </section>
  </div>
</section>
<style>
.case-impact-stat{transition:transform .2s ease,border-color .2s ease}
.case-impact-stat:hover{transform:translateY(-3px);border-color:var(--brand-strong)}
@media (prefers-reduced-motion:reduce){.case-impact-stat{transition:none}.case-impact-stat:hover{transform:none}}
</style>
