---
import Identity from './Identity.astro';
import WhatsAppShareButton from './WhatsAppShareButton.astro';
import { cases, dateBR } from '@/lib/cases';
import { platformSharePayload } from '@/lib/share-messages';
import { Separator } from '@/components/ui/separator';
import { copy } from '@/lib/copy';
const latest = cases.reduce((a, b) => (a > b.status_data ? a : b.status_data), '');
const platformShare = platformSharePayload();
const groups = [
  {
    title: 'Casos',
    links: [
      ['Todos os casos', '/casos/'],
      ['Histórias documentadas', '/historias/'],
      ['Empresas e avaliações', '/empresas/'],
      ['Precedentes judiciais', '/precedentes/'],
      ['Consulta de CNPJ', '/cnpj/'],
      ['Kit Boca a Boca', '/kit-boca-a-boca/'],
    ],
  },
  {
    title: 'Artigos',
    links: [
      ['Hub de artigos', '/artigos/'],
      ['Guias ao consumidor', '/guias/casos-de-consumo/'],
      ['Insights de autonomia digital', '/autonomia-digital/guias/'],
      ['Escola de autonomia digital', '/autonomia-digital/'],
      ['Academia', '/academia/'],
      ['Diagnóstico gratuito', '/autonomia-digital/diagnostico/'],
    ],
  },
  {
    title: 'Instituto e projeto',
    links: [
      ['Instituto', '/instituto/'],
      ['Dados abertos', '/instituto/dados/'],
      ['Órgãos oficiais', '/orgaos-oficiais/'],
      ['Observatório de plataformas', '/observatorio/plataformas/'],
      ['Política e poder', '/observatorio/politica/'],
      ['Organizar', '/organizar/'],
      ['Metodologia', '/metodologia/'],
      ['Sobre', '/sobre/'],
      ['Critérios editoriais', '/sobre/criterios-de-publicacao/'],
      ['Atualizações (RSS)', '/rss.xml'],
    ],
  },
];
---
<footer class="bg-[#0f1714] py-14 text-[#e3ebe2]" data-print-hide>
  <div class="container">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr_1fr]">
      <div class="flex flex-col gap-6">
        <Identity />
        <p class="m-0 max-w-sm text-sm leading-relaxed text-white/60">Instituto e plataforma independentes para investigar, organizar demandas legítimas, proteger a autonomia digital e cobrar respostas com fontes verificáveis.</p>
        <WhatsAppShareButton
          href={platformShare.whatsappHref}
          label={copy.share.whatsapp}
          hint="Espalhe a plataforma"
          variant="compact"
          class="mt-1"
        />
      </div>
      {groups.map((g) => (
        <nav aria-label={g.title} class="flex flex-col gap-2.5">
          <strong class="text-sm text-white">{g.title}</strong>
          {g.links.map(([label, href]) => <a href={href} class="text-sm text-white/65 no-underline hover:text-white hover:underline">{label}</a>)}
        </nav>
      ))}
    </div>
    <Separator className="my-8 bg-white/10" />
    <div class="flex flex-col gap-2 text-xs text-white/50 sm:flex-row sm:justify-between">
      <span>© {new Date().getFullYear()} CasoAberto. Projeto editorial independente.</span>
      {latest && <span>Arquivo atualizado em {dateBR(latest)} · Brasil</span>}
    </div>
  </div>
</footer>
