---
import Identity from './Identity.astro';
import { cases, dateBR } from '../lib/cases';
const latest = cases.reduce((a, b) => (a > b.status_data ? a : b.status_data), '');
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <Identity footer />
      <p>Publicação independente para dar visibilidade a casos documentados, reunir fontes públicas, comparar avaliações editoriais e cobrar respostas verificáveis.</p>
    </div>
    <div>
      <strong>Pesquise</strong>
      <a href="/empresas/">Perfis e avaliações de empresas</a>
      <a href="/casos/">Casos documentados</a>
      <a href="/avaliacoes/nao-recomendamos/">Não recomendamos</a>
      <a href="/cnpj/">Consulta de CNPJ</a>
      <a href="/problemas/">Tipos de problema</a>
      <a href="/precedentes/">Falências e recuperações: precedentes</a>
    </div>
    <div>
      <strong>Entenda o projeto</strong>
      <a href="/como-funciona/">Como funciona</a>
      <a href="/metodologia/">Critérios e metodologia</a>
      <a href="/precedentes/">Análise de risco e cenários com dados</a>
      <a href="/guias/o-que-fazer-atraso-moveis-planejados/">Como documentar atrasos</a>
      <a href="/rss.xml">Atualizações (RSS)</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} CasoAberto. Projeto editorial independente.</span>
    {latest && <span>Arquivo atualizado em {dateBR(latest)} · Brasil</span>}
  </div>
</footer>