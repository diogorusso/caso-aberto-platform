---
import Identity from './Identity.astro';
import { cases, dateBR } from '@/lib/cases';
import { Separator } from '@/components/ui/separator';
const latest = cases.reduce((a, b) => (a > b.status_data ? a : b.status_data), '');
const groups = [
  {
    title: 'Pesquise',
    links: [
      ['Perfis e avaliações de empresas', '/empresas/'],
      ['Todos os casos documentados', '/casos/'],
      ['Móveis e casa', '/casos/categoria/moveis-e-casa/'],
      ['Viagens e turismo', '/casos/categoria/viagens-e-turismo/'],
      ['Compras online', '/casos/categoria/compras-online/'],
      ['Energia e serviços', '/casos/categoria/energia-e-servicos/'],
      ['Política e direitos', '/casos/categoria/politica-e-direitos/'],
      ['Histórias que estão por trás dos casos', '/historias/'],
      ['Guias para consumidores', '/guias/casos-de-consumo/'],
      ['Não recomendamos', '/avaliacoes/nao-recomendamos/'],
      ['Consulta de CNPJ', '/cnpj/'],
      ['Tipos de problema', '/problemas/'],
      ['Falências e recuperações: precedentes', '/precedentes/'],
      ['Explore cenários de impacto', '/cenarios/'],
      ['Observatório de plataformas digitais', '/observatorio/plataformas/'],
      ['Kit Boca a Boca para imprimir', '/kit-boca-a-boca/'],
    ],
  },
  {
    title: 'Entenda o projeto',
    links: [
      ['Sobre o projeto', '/sobre/'],
      ['Política editorial e direito de resposta', '/sobre/criterios-de-publicacao/'],
      ['Instituto de dados e pesquisa', '/instituto/'],
      ['Organização cidadã', '/organizar/'],
      ['Escola de autonomia digital', '/autonomia-digital/'],
      ['Academia e produtos educacionais', '/academia/'],
      ['Insights gratuitos', '/autonomia-digital/guias/'],
      ['Diagnóstico gratuito de pegadas digitais', '/autonomia-digital/diagnostico/'],
      ['Como funciona', '/como-funciona/'],
      ['Critérios e metodologia', '/metodologia/'],
      ['Análise de risco e cenários com dados', '/precedentes/'],
      ['Como documentar atrasos', '/guias/o-que-fazer-atraso-moveis-planejados/'],
      ['Atualizações (RSS)', '/rss.xml'],
    ],
  },
];
---
<footer class="bg-[#0f1714] py-14 text-[#e3ebe2]" data-print-hide>
  <div class="container">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr]">
      <div class="space-y-4">
        <Identity />
        <p class="m-0 max-w-sm text-sm leading-relaxed text-white/60">Instituto e plataforma independentes para investigar, organizar demandas legítimas, proteger a autonomia digital e cobrar respostas com fontes verificáveis.</p>
      </div>
      {groups.map((g) => (
        <nav aria-label={g.title} class="flex flex-col gap-2.5">
          <strong class="text-sm text-white">{g.title}</strong>
          {g.links.map(([label, href]) => <a href={href} class="text-sm text-white/65 no-underline hover:text-white hover:underline">{label}</a>)}
        </nav>
      ))}
    </div>
    <Separator className="my-8 bg-white/10" />
    <div class="flex flex-col gap-2 text-xs text-white/50 sm:flex-row sm:justify-between">
      <span>© {new Date().getFullYear()} CasoAberto. Projeto editorial independente.</span>
      {latest && <span>Arquivo atualizado em {dateBR(latest)} · Brasil</span>}
    </div>
  </div>
</footer>
