---
import Identity from './Identity.astro';
import { cases, casePath, dateBR } from '../lib/cases';
const featured = cases[0];
const latest = cases.reduce((a, b) => (a > b.status_data ? a : b.status_data), '');
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <Identity footer />
      <p>Publicação independente de accountability do consumidor. Organizamos evidências públicas, cronologias e perguntas institucionais — sem ser governo, tribunal ou escritório de advocacia.</p>
    </div>
    <div>
      <strong>Plataforma</strong>
      <a href="/casos/">Todos os casos</a>
      <a href="/empresas/">Avaliações de empresas</a>
      <a href="/cnpj/">Consulta CNPJ</a>
      <a href="/problemas/">Tipos de reclamação</a>
      <a href="/avaliacoes/nao-recomendamos/">Não recomendamos</a>
      <a href="/empresas/florense/">Dossiê Florense</a>
      <a href="/guias/risco-pagamento-antecipado-moveis-planejados/">Risco do pagamento antecipado</a>
      <a href="/guias/o-que-fazer-atraso-moveis-planejados/">O que fazer em atraso</a>
      <a href="/como-funciona/">Como funciona</a>
      <a href="/metodologia/">Metodologia</a>
      <a href="/rss.xml">RSS</a>
    </div>
    {featured && (
      <div>
        <strong>Caso em destaque</strong>
        <a href={casePath(featured)}>{featured.empresa_resumo}</a>
        <a href={`${casePath(featured)}risco-roma-mobili/`}>Alerta Roma Mobili</a>
        <a href={`${casePath(featured)}responsaveis/`}>Quem responde</a>
        <a href={`${casePath(featured)}imprensa/`}>Kit imprensa</a>
        <a href={`${casePath(featured)}evidencias/`}>Índice de evidências</a>
      </div>
    )}
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} CasoAberto. Projeto editorial independente.</span>
    <span>Última revisão: {dateBR(latest)} · Brasil</span>
  </div>
</footer>
