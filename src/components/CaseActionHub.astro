---
import {caseActionPlan} from '../lib/case-actions';
import CaseActionDrawer from './CaseActionDrawer.astro';
import {MessageCircle,Copy,Download,ExternalLink,FileCheck2,ShieldCheck,ArrowRight} from 'lucide-react';
interface Props {caseId:string;compact?:boolean}
const {caseId,compact=false}=Astro.props;
const plan=caseActionPlan(caseId);
const actionPath='/casos/acoes/'+plan.id+'/';
const stages=[...new Set(plan.channels.map(c=>c.stage))];
const btn='inline-flex min-h-11 items-center justify-center gap-2 rounded-md border px-3.5 py-2 text-sm font-bold no-underline transition-colors focus-visible:ring-2 focus-visible:ring-brand';
---
<section id={'agir-'+plan.id} class:list={['scroll-mt-24',compact?'border-y border-border bg-muted py-7':'bg-muted py-12 md:py-16']} aria-labelledby={'action-title-'+plan.id} data-print-hide>
 <div class="container space-y-6">
  <header class="space-y-3">
   <p class="m-0 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.14em] text-brand-strong"><MessageCircle size={16} aria-hidden="true"/> COBRANÇA COM DOCUMENTOS · {plan.id}</p>
   <h2 id={'action-title-'+plan.id} class="m-0 max-w-4xl text-2xl leading-tight md:text-4xl">A resposta não chegou? Faça a pergunta certa. No canal certo.</h2>
   <p class="m-0 max-w-4xl text-base text-muted-foreground">{plan.templates.length} mensagens prontas para {plan.company}, com {plan.channels.length} canais identificados. Edite os fatos do seu caso. Copie, registre e acompanhe.</p>
   {compact ? (
    <div class="flex flex-wrap items-center gap-3">
     <CaseActionDrawer caseId={caseId} />
     <a href={actionPath} class="text-sm font-semibold text-link">Abrir página completa de cobrança ↗</a>
    </div>
   ) : (
    <p class="m-0 max-w-3xl text-sm text-muted-foreground">Role a página: modelos, canais e caminho judicial estão abaixo, nesta ordem.</p>
   )}
  </header>
  {!compact&&<>
   <div class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,.85fr)]">
    <div class="min-w-0 space-y-4" id={'modelos-'+plan.id}>
     <h3 class="m-0 text-2xl">Escolha a mensagem. Ajuste os fatos. Envie.</h3>
     <p class="m-0 text-sm text-muted-foreground">Trechos entre colchetes são campos para completar com informações do seu caso. O conteúdo fica no navegador até você copiar ou baixar.</p>
     {plan.templates.map((item,i)=><details class="group rounded-lg border border-border bg-card" open={i===0}>
      <summary class="flex cursor-pointer items-start justify-between gap-4 p-5"><span class="space-y-1"><span class="block text-xs font-bold uppercase tracking-wide text-brand-strong">{String(i+1).padStart(2,'0')} · {item.audience}</span><strong class="block text-lg leading-snug">{item.label}</strong><span class="block text-xs leading-relaxed text-muted-foreground">{item.description}</span></span><span class="text-brand-strong" aria-hidden="true">+</span></summary>
      <div class="space-y-3 border-t border-border p-4 md:p-5">
       <label class="block text-sm font-semibold" for={'msg-'+plan.id+'-'+item.id}>Editar texto</label>
       <textarea id={'msg-'+plan.id+'-'+item.id} spellcheck="true" rows="12" class="w-full rounded-md border border-border bg-background p-3 font-mono text-xs leading-relaxed text-foreground focus-visible:ring-2 focus-visible:ring-brand" data-action-message>{item.body}</textarea>
       <div class="flex flex-wrap gap-2">
        <button type="button" data-action-copy class={btn+' cursor-pointer border-primary bg-primary text-primary-foreground'}><Copy size={15} aria-hidden="true"/> Copiar texto</button>
        <button type="button" data-action-download data-action-filename={'casoaberto-'+plan.id+'-'+item.id+'.txt'} class={btn+' cursor-pointer border-border bg-background text-foreground'}><Download size={15} aria-hidden="true"/> Baixar .txt</button>
        {item.channelIds.slice(0,2).map(id=>{const ch=plan.channels.find(c=>c.id===id);return ch&&<a class={btn+' border-border bg-background text-link'} href={ch.url} target="_blank" rel="noopener noreferrer">{ch.title} <ExternalLink size={13} aria-hidden="true"/></a>})}
       </div>
      </div>
     </details>)}
    </div>
    <aside class="min-w-0 space-y-4" id="canais">
     <h3 class="m-0 text-2xl">Onde registrar e cobrar?</h3>
     <p class="m-0 text-sm text-muted-foreground">Cada canal tem finalidade e fonte. Alguns exigem cadastro, protocolo anterior ou o fornecedor na lista de participantes.</p>
     {stages.map(stage=><div class="space-y-2 rounded-lg border border-border bg-card p-4">
      <h4 class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">{stage}</h4>
      {plan.channels.filter(c=>c.stage===stage).map(ch=><article class="space-y-2 border-t border-border pt-3 first:border-0 first:pt-0">
       <a href={ch.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-bold text-link">{ch.title} <ExternalLink size={14} aria-hidden="true"/></a>
       <p class="m-0 text-sm">{ch.purpose}</p>
       <p class="m-0 text-xs leading-relaxed text-muted-foreground">{ch.note}</p>
       <a href={ch.source_url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-link">Fonte desse canal ↗</a>
      </article>)}
     </div>)}
     <div class="space-y-3 border-l-4 border-brand-strong bg-background p-4"><h4 class="m-0 text-lg">Documente antes de enviar</h4><ul class="m-0 list-disc space-y-1 pl-4 text-sm"><li>Contrato, oferta, pagamento e prazo.</li><li>Fatos com data, documentos e evidências.</li><li>Protocolos, respostas e tentativas de solução.</li><li>Pedido específico e resposta esperada.</li><li>Dados pessoais somente em canal apropriado.</li></ul></div>
    </aside>
   </div>
   {!plan.isCivic&&<section class="space-y-5 border-t border-border pt-8" id="justica">
    <p class="m-0 text-xs font-bold uppercase tracking-widest text-brand-strong">O CAMINHO JUDICIAL</p>
    <h3 class="m-0 text-2xl">Quer entrar com uma ação? Não comece pelo formulário errado.</h3>
    <div class="grid gap-4 md:grid-cols-3">
     {[['01 · Organizar','Separe contrato, comprovantes, prazos, registros de atendimento e valor pretendido.'],['02 · Verificar a via','Confira competência territorial, valor da causa, natureza do pedido e necessidade de representação.'],['03 · Protocolar','Use o canal do tribunal correspondente ou peça assistência jurídica; guarde recibo, número e intimações.']].map(item=><div class="space-y-2 border border-border bg-card p-5"><h4 class="m-0 text-lg">{item[0]}</h4><p class="m-0 text-sm text-muted-foreground">{item[1]}</p></div>)}
    </div>
    <p class="m-0 max-w-4xl text-sm text-muted-foreground">{plan.judicialNote}</p>
    <div class="space-y-3">
     <a class={btn+' border-brand-strong bg-brand-strong text-white'} href="/guias/como-acionar-empresa-na-justica/">Passo a passo para entrar com ação <ArrowRight size={15} aria-hidden="true"/></a>
     <p class="m-0 text-sm text-muted-foreground">Canais judiciais com fonte: {plan.channels.filter(ch=>ch.step==='judicial').slice(0,3).map((ch,i)=><><a class="font-semibold text-link" href={ch.url} target="_blank" rel="noopener noreferrer">{ch.title}</a>{i<2?' · ':''}</>)}</p>
    </div>
   </section>}
   <footer class="flex flex-wrap gap-4 border-t border-border pt-5 text-sm text-muted-foreground"><span class="inline-flex items-center gap-1"><FileCheck2 size={16} aria-hidden="true"/> {plan.templates.length} modelos editáveis</span><span class="inline-flex items-center gap-1"><ShieldCheck size={16} aria-hidden="true"/> {plan.channels.length} canais com fontes</span></footer>
  </>}
 </div>
</section>
<script>
 document.addEventListener('click',async(event)=>{
  const target=event.target;
  if(!(target instanceof Element))return;
  const button=target.closest('[data-action-copy],[data-action-download]');
  if(!(button instanceof HTMLButtonElement))return;
  const textarea=button.closest('details')?.querySelector('textarea[data-action-message]');
  if(!(textarea instanceof HTMLTextAreaElement))return;
  if(button.hasAttribute('data-action-copy')){
   try{await navigator.clipboard.writeText(textarea.value);button.textContent='Texto copiado ✓';}
   catch{textarea.focus();textarea.select();button.textContent='Copie o texto selecionado';}
  }
  if(button.hasAttribute('data-action-download')){
   const blob=new Blob([textarea.value],{type:'text/plain;charset=utf-8'});
   const url=URL.createObjectURL(blob);
   const anchor=document.createElement('a');anchor.href=url;anchor.download=button.dataset.actionFilename||'casoaberto-mensagem.txt';anchor.click();
   setTimeout(()=>URL.revokeObjectURL(url),3000);
  }
 });
</script>
