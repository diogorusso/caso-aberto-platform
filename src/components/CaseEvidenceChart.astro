---
/** Progressive chart: interactive shadcn/Recharts island + static SVG for no-JS/print.
 * Dates and magnitudes stay sourced from the case record; no fabricated series.
 */
import {ChartNoAxesCombined,BookOpenText,ExternalLink} from 'lucide-react';
import EvidenceChart from './islands/EvidenceChart';
import type {PlotPoint} from '../lib/visual-impact';
interface Props{
 title:string;description:string;points:PlotPoint[];
 bars?:{label:string;value:number}[];
 sourceUrl?:string;
}
const {title,description,points,bars,sourceUrl}=Astro.props;
const plotted=[...points].sort((a,b)=>a.date.localeCompare(b.date));
const grouped=plotted.reduce<Array<{date:string;total:number;titles:string[]}>>((acc,p)=>{
 const last=acc[acc.length-1];
 if(last&&last.date===p.date){last.total+=1;last.titles.push(p.title);}
 else acc.push({date:p.date,total:1,titles:[p.title]});
 return acc;
},[]);
let cumulative=0;
const W=760,H=246,left=56,right=26,top=28,bottom=44;
const plotW=W-left-right,plotH=H-top-bottom;
const xFor=(index:number)=>left+(grouped.length<2?plotW/2:(index/(grouped.length-1))*plotW);
const total=plotted.length;
const svgPts=grouped.map((p,i)=>{cumulative+=p.total;return {...p,x:xFor(i),y:top+plotH*(1-cumulative/Math.max(total,1)),running:cumulative};});
const path=svgPts.map((p,i)=>i===0?'M '+p.x+' '+(top+plotH)+' V '+p.y:'H '+p.x+' V '+p.y).join(' ');
const fillPath=svgPts.length?path+' L '+svgPts[svgPts.length-1].x+' '+(top+plotH)+' L '+svgPts[0].x+' '+(top+plotH)+' Z':'';
const tick=(v:number)=>v.toLocaleString('pt-BR');
const date=(v:string)=>v.split('-').reverse().join('/');
const barItems=(bars||[]).filter(b=>b.value>0);
const maxBar=Math.max(1,...barItems.map(b=>b.value));
---
<div class="h-full min-h-[22rem] print:hidden" data-evidence-chart>
  <EvidenceChart client:only="react" className="h-full min-h-[22rem]" title={title} description={description} points={points} bars={bars} sourceUrl={sourceUrl}>
    <div class="case-data-chart flex h-full min-h-[22rem] animate-pulse flex-col border border-border bg-card p-5" aria-hidden="true">
      <p class="m-0 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-brand-strong">Dados documentados</p>
      <h3 class="m-0 mt-2 text-xl">{title}</h3>
      <p class="m-0 mt-2 text-sm text-muted-foreground">{description}</p>
    </div>
  </EvidenceChart>
</div>

<noscript>
<div class="case-data-chart border border-border bg-card" aria-labelledby="chart-title-static">
  <div class="flex items-start justify-between gap-4 border-b border-border p-5">
    <div class="space-y-2"><p class="m-0 flex items-center gap-2 text-xs font-bold uppercase tracking-[.14em] text-brand-strong"><ChartNoAxesCombined size={16} aria-hidden="true"/> DADOS DOCUMENTADOS</p><h3 id="chart-title-static" class="m-0 text-xl md:text-2xl">{title}</h3><p class="m-0 max-w-2xl text-sm leading-relaxed text-muted-foreground">{description}</p></div>
    <span class="shrink-0 border border-border px-2.5 py-1 text-xs font-semibold text-muted-foreground">{barItems.length?'BARRAS':'CRONOLOGIA'}</span>
  </div>
  {barItems.length ? (
    <div class="grid gap-3 p-5" role="img" aria-label={title+'. '+barItems.map(b=>b.label+': '+b.value).join('; ')}>
      {barItems.map((b)=>(
        <div class="grid gap-1.5">
          <div class="flex justify-between gap-4 text-sm"><span class="font-medium">{b.label}</span><strong class="tabular-nums">{tick(b.value)}</strong></div>
          <div class="h-3 overflow-hidden bg-muted" aria-hidden="true">
            <div class="h-full bg-brand-strong" style={'width:'+String(b.value/maxBar*100)+'%'}></div>
          </div>
        </div>
      ))}
    </div>
  ) : grouped.length>0 ? (
    <div class="p-5">
      <svg viewBox={`0 0 ${W} ${H}`} class="w-full overflow-visible" role="img" aria-labelledby="chart-svg-title chart-svg-desc">
        <title id="chart-svg-title">{title}</title><desc id="chart-svg-desc">{description} {total} marcos documentados entre {date(grouped[0].date)} e {date(grouped[grouped.length-1].date)}.</desc>
        {[0,.5,1].map(f=><g><line x1={left} x2={W-right} y1={top+plotH*(1-f)} y2={top+plotH*(1-f)} stroke="var(--border)" stroke-dasharray="3 5"/><text x={left-12} y={top+plotH*(1-f)+4} text-anchor="end" font-size="12" fill="var(--muted-foreground)">{tick(Math.round(total*f))}</text></g>)}
        <path d={fillPath} fill="var(--brand)" fill-opacity=".1"/>
        <path d={path} fill="none" stroke="var(--brand-strong)" stroke-width="3"/>
        {svgPts.map((p,i)=><g><circle cx={p.x} cy={p.y} r={i===svgPts.length-1?6:4} fill="var(--brand-strong)" stroke="var(--card)" stroke-width="2"><title>{date(p.date)} · {p.titles.join('; ')}</title></circle></g>)}
        <text x={left} y={H-10} font-size="12" fill="var(--muted-foreground)">{date(grouped[0].date)}</text>
        <text x={W-right} y={H-10} font-size="12" text-anchor="end" fill="var(--muted-foreground)">{date(grouped[grouped.length-1].date)}</text>
      </svg>
      <p class="mt-0 px-2 text-xs text-muted-foreground"><BookOpenText size={13} className="mr-1 inline-block align-[-2px]" aria-hidden="true"/> Cada degrau representa um marco registrado, não uma medida de dano nem um novo caso individual.</p>
    </div>
  ) : <p class="p-6 text-sm text-muted-foreground">Nenhum marco datado catalogado.</p>}
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border px-5 py-4 text-xs text-muted-foreground">
    <span>{barItems.length?barItems.reduce((s,b)=>s+b.value,0).toLocaleString('pt-BR')+' registros na distribuição exibida':total+' marcos no recorte do dossiê'}</span>
    {sourceUrl&&<a href={sourceUrl} rel="noopener noreferrer" class="inline-flex items-center gap-1 font-semibold text-brand-strong">Conferir origem <ExternalLink size={13} aria-hidden="true"/></a>}
  </div>
</div>
</noscript>

<div class="case-data-chart mt-0 hidden border border-border bg-card print:block" aria-labelledby="chart-title-print">
  <div class="border-b border-border p-5">
    <p class="m-0 text-xs font-bold uppercase tracking-[.14em] text-brand-strong">Dados documentados</p>
    <h3 id="chart-title-print" class="m-0 mt-2 text-xl">{title}</h3>
    <p class="m-0 mt-2 text-sm text-muted-foreground">{description}</p>
  </div>
  {barItems.length ? (
    <div class="grid gap-3 p-5" role="img" aria-label={title}>
      {barItems.map((b)=>(
        <div class="flex justify-between gap-4 text-sm"><span>{b.label}</span><strong class="tabular-nums">{tick(b.value)}</strong></div>
      ))}
    </div>
  ) : (
    <div class="p-5 text-sm" role="img" aria-label={title}>
      <p class="m-0">{total} marcos documentados{grouped.length?` de ${date(grouped[0].date)} a ${date(grouped[grouped.length-1].date)}`:''}.</p>
    </div>
  )}
</div>
