---
import { TableOfContents, type TocItem } from './table-of-contents';
export type { TocItem };
interface Props {
  items: TocItem[];
  title?: string;
  class?: string;
}
const { items, title = 'Nesta página', class: className = '' } = Astro.props;
---
{items.length > 1 && (
  <TableOfContents client:load items={items} title={title} className={className} />
)}
