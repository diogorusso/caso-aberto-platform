---
import { SectionRail as SectionRailUi, type SectionRailItem } from './section-rail';
export type { SectionRailItem };
interface Props {
  items: SectionRailItem[];
  label?: string;
  class?: string;
}
const { items, label = 'Nesta página', class: className = '' } = Astro.props;
---
{items.length > 1 && (
  <SectionRailUi client:load items={items} label={label} className={className} />
)}
