---
import { SurfaceCard as SurfaceCardUi, type SurfaceCardVariant } from './surface-card';
interface Props {
  label?: string;
  title?: string;
  description?: string;
  status?: string;
  href?: string;
  external?: boolean;
  variant?: SurfaceCardVariant;
  class?: string;
}
const {
  label,
  title,
  description,
  status,
  href,
  external = false,
  variant = 'surface',
  class: className = '',
} = Astro.props;
---
<SurfaceCardUi
  label={label}
  title={title}
  description={description}
  status={status}
  href={href}
  external={external}
  variant={variant}
  className={className}
/>

