---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  variant?: 'default' | 'muted' | 'dark' | 'contrast' | 'editorial' | 'accent';
  spacing?: 'sm' | 'md' | 'lg';
  class?: string;
}
const {
  id,
  eyebrow,
  title,
  description,
  variant = 'default',
  spacing = 'lg',
  class: className = '',
} = Astro.props;
const dark = variant === 'dark' || variant === 'contrast' || variant === 'accent';---
<section
  id={id}
  class:list={['ca-section', `ca-section--${variant}`, `ca-section--${spacing}`, className]}
  data-surface={variant}
>
  <div class="container">
    {(eyebrow || title) && (
      <header class:list={['ca-sec-hd', description && 'ca-sec-hd--split']}>
        <div>
          {eyebrow && <p class:list={['eyebrow', dark && 'light']}>{eyebrow}</p>}
          {title && <h2>{title}</h2>}
        </div>
        {description && <p class="ca-sec-desc">{description}</p>}
      </header>
    )}
    <slot />
  </div>
</section>
