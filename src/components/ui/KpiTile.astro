---
import { KpiCard, type KpiTone } from './kpi-card';
interface Props {
  label: string;
  value: string | number;
  note?: string;
  href?: string;
  hrefLabel?: string;
  tone?: KpiTone;
  class?: string;
}
const {
  label,
  value,
  note,
  href,
  hrefLabel,
  tone = 'light',
  class: className = '',
} = Astro.props;
---
<KpiCard label={label} value={value} note={note} href={href} hrefLabel={hrefLabel} tone={tone} className={className} />
