---
/**
 * Quiet visibility metric under case titles.
 * Header: plain readable line. Card: compact bordered note.
 */
import { caseStudies, personalStories } from '../lib/case-catalog';
import { formatVisibilityCount, visibilityFromInput } from '../lib/case-visibility-model';
import { visibilityInputFromEntry } from '../lib/case-visibility';
import { copy } from '../lib/copy';

interface Props {
  caseId: string;
  variant?: 'header' | 'card' | 'inline';
  tone?: 'light' | 'inverse';
  className?: string;
}

const { caseId, variant = 'header', tone = 'light', className } = Astro.props;
const entry = caseStudies.find((item) => item.id === caseId) || personalStories.find((item) => item.id === caseId);
const input = entry ? visibilityInputFromEntry(entry) : null;
const snapshot = input ? visibilityFromInput(input, new Date()) : null;
const t = copy.visibility;
const inverse = tone === 'inverse';
const today = snapshot ? formatVisibilityCount(snapshot.today) : '';
const isInline = variant === 'inline';
const isCompact = variant === 'card' || isInline;
const isHeader = variant === 'header';
---
{snapshot && input && (
  <p
    class:list={[
      'case-visibility-metric m-0 max-w-full text-left leading-snug',
      isHeader && 'text-sm md:text-[0.95rem]',
      isCompact && 'mt-4 text-sm',
      isCompact && !isInline && (inverse
        ? 'border border-white/15 bg-white/5 px-3.5 py-2.5'
        : 'border border-border bg-muted/60 px-3.5 py-2.5'),
      inverse ? 'text-white/75' : 'text-foreground/75',
      className,
    ]}
    data-visibility-metric
    data-visibility-input={JSON.stringify(input)}
    role="status"
    aria-label={`${today} ${t.metricLabel}. ${t.label}`}
  >
    <span
      class:list={[
        'case-visibility-metric__count tabular-nums font-semibold',
        inverse ? 'text-white' : 'text-foreground',
      ]}
      data-visibility-today
    >{today}</span>
    {' '}
    <span class:list={['font-semibold uppercase tracking-[0.12em]', inverse ? 'text-[#ff917e]' : 'text-brand-strong']}>
      {t.metricLabel}
    </span>
    {!isInline && (
      <>
        <span class="mx-2 text-current/40" aria-hidden="true">·</span>
        <span>{t.seen}</span>
        {' '}
        <span class="inline-flex items-center gap-1.5">
          <span class="visibility-live-dot" aria-hidden="true">
            <svg viewBox="0 0 8 8" width="7" height="7" class="block overflow-visible">
              <circle class="visibility-live-dot__core" cx="4" cy="4" r="2.2" />
              <circle class="visibility-live-dot__pulse" cx="4" cy="4" r="2.2" fill="none" />
            </svg>
          </span>
          <span class:list={[inverse ? 'font-medium text-white' : 'font-medium text-foreground']}>{t.silent}</span>
        </span>
      </>
    )}
    {isInline && (
      <>
        <span class="mx-2 text-current/40" aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1.5">
          <span class="visibility-live-dot" aria-hidden="true">
            <svg viewBox="0 0 8 8" width="7" height="7" class="block overflow-visible">
              <circle class="visibility-live-dot__core" cx="4" cy="4" r="2.2" />
              <circle class="visibility-live-dot__pulse" cx="4" cy="4" r="2.2" fill="none" />
            </svg>
          </span>
          <span class:list={[inverse ? 'font-medium text-white' : 'font-medium text-foreground']}>{t.silent}</span>
        </span>
      </>
    )}
  </p>
)}

{snapshot && input && (
  <script type="module" define:vars={{ metricLabel: t.metricLabel, label: t.label }}>
    import { formatVisibilityCount, visibilityFromInput } from '../lib/case-visibility-model.ts';

    function refresh() {
      for (const node of document.querySelectorAll('[data-visibility-metric][data-visibility-input]')) {
        try {
          const input = JSON.parse(node.getAttribute('data-visibility-input') || '');
          const snap = visibilityFromInput(input, new Date());
          const el = node.querySelector('[data-visibility-today]');
          if (el) el.textContent = formatVisibilityCount(snap.today);
          node.setAttribute('aria-label', `${formatVisibilityCount(snap.today)} ${metricLabel}. ${label}`);
        } catch {}
      }
    }
    refresh();
    document.addEventListener('astro:page-load', refresh);
  </script>
)}
