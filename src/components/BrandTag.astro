---
/*
 * BrandTag — company logo and optional store photo for recognition.
 * Small/medium surfaces stay logo-only: no cramped photo overlays and no
 * duplicated “não recomendamos” badge (call sites already render VerdictStatusBadge).
 * Large photo surfaces may show the sourced store image without an overlay badge.
 */
import media from '../data/company-media.json';
import type { Brand, BrandUnit } from '../lib/brands';
interface Props {
  brand: Brand;
  unit?: BrandUnit;
  variant?: 'logo' | 'photo' | 'both';
  size?: 'sm' | 'md' | 'lg';
  linked?: boolean;
}
const { brand, unit, variant = 'logo', size = 'md', linked = false } = Astro.props;
const brandMedia = (media.brands as Record<string, any>)[brand.slug];
const unitMedia = unit ? brandMedia?.units?.[unit.slug] : undefined;
const logo = brandMedia?.logo;
const firstUnit = brandMedia?.units ? Object.values(brandMedia.units)[0] : undefined;
const photo = (unitMedia?.image ?? (firstUnit as any)?.image) as any;
const subject = unit ? unit.name : brand.name;
const href = linked ? (unit ? `/empresas/${brand.slug}/${unit.slug}/` : `/empresas/${brand.slug}/`) : undefined;
const logoSizes = { sm: 'h-8 min-w-[5.5rem] px-1.5', md: 'h-10 min-w-[7rem] px-2', lg: 'h-14 min-w-[9rem] px-3' };
const imgSizes = { sm: 'max-h-5 max-w-[5rem]', md: 'max-h-7 max-w-[6.5rem]', lg: 'max-h-10 max-w-[9rem]' };
const photoSizes = { sm: 'h-12 w-16', md: 'h-16 w-24', lg: 'h-24 w-36' };
const showLogo = variant !== 'photo' && logo?.src;
const showPhoto = variant !== 'logo' && photo?.src && (size === 'lg' || variant === 'photo');
const Tag = linked ? 'a' : 'span';
---
<Tag
  class="inline-flex flex-wrap items-center gap-2 no-underline"
  href={linked ? href : undefined}
  aria-label={linked ? `Perfil de ${subject}` : undefined}
>
  {showLogo && (
    <span class:list={['inline-flex items-center justify-center border border-border bg-white shadow-sm', logoSizes[size]]}>
      <img class:list={['object-contain', imgSizes[size]]} src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
    </span>
  )}
  {showPhoto && (
    <span class:list={['relative inline-block shrink-0 overflow-hidden border border-border bg-muted', photoSizes[size]]}>
      <img class="size-full object-cover" src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
    </span>
  )}
  {!showLogo && !showPhoto && (
    <span class:list={['inline-flex items-center justify-center border border-border bg-muted text-xs font-extrabold uppercase tracking-wide text-foreground', logoSizes[size]]}>
      {brand.name}
    </span>
  )}
</Tag>
