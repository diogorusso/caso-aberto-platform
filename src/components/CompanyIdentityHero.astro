---
import media from '../data/company-media.json';
import {casePath,brl} from '../lib/cases';
import {type Brand,type BrandUnit,statusLabel} from '../lib/brands';
import {impactForSelection,brandSnapshot} from '../lib/impact';
import VerdictMiniSummary from './VerdictMiniSummary.astro';
interface Props {brand:Brand;unit?:BrandUnit}
const {brand,unit}=Astro.props;
const selected=unit||brand;
const visual=(media.brands as Record<string, any>)[brand.slug];
const unitVisual=unit?visual?.units?.[unit.slug]:undefined;
const image=unitVisual?.image ?? (visual?.units ? Object.values(visual.units).map((v:any)=>v.image).find(Boolean) : undefined);
const photoSource=image?.source_url;
const snapshot=brandSnapshot(brand);
const {relatedCases,reportedPaymentTotal,indexedReportCount,sourceCount,holdDays}=impactForSelection({brand,unit});
const first=relatedCases[0];
const caseLink=first?casePath(first):'/casos/';
const status=statusLabel(selected.verdict.status);
---
<section class="company-identity" id="perfil-empresarial" aria-labelledby="company-identity-heading">
 <div class="container">
  <div class="company-identity-top"><span class="eyebrow">CASOABERTO / PERFIL EMPRESARIAL {unit?'· UNIDADE LOCAL':'· MARCA E REDE'}</span><span>Revisado em {selected.verdict.valid_as_of.split('-').reverse().join('/')}</span></div>
  <div class="company-identity-grid">
   <div class="company-identity-copy">
    <div class="company-brand-lockup">
     {visual?.logo?.src?<span class="company-brand-logo"><img src={visual.logo.src} alt={visual.logo.alt} loading="eager" decoding="async"/></span>:<span class="company-brand-monogram" aria-hidden="true">{brand.name.slice(0,2).toUpperCase()}</span>}
     <span><strong>{brand.name}</strong><small>{unit?unit.location:brand.segment+' · '+brand.location}</small></span>
    </div>
    <div class="company-verdict-line"><span class={'company-verdict-pill status-'+selected.verdict.status}>{status}</span><span class="company-verdict-date">Avaliação editorial · {selected.verdict.valid_as_of.split('-').reverse().join('/')}</span></div>
    <h1 id="company-identity-heading">{unit?unit.name:brand.name}<span class="company-identity-heading-tail">: histórico, casos e responsabilidade.</span></h1>
    <p class="company-profile-summary">{unit?unit.summary:brand.summary}</p>
    <VerdictMiniSummary verdict={selected.verdict} showMeta={false}/>
    <div class="company-identity-actions">
     <a class="button button-dark" href={caseLink}>Ver caso e evidências ↗</a>
     <a class="button button-subtle" href="#analisar-impacto">Analisar impacto ↓</a>
     <a class="company-inline-link" href="#casos-associados">Reclamações relacionadas ↓</a>
    </div>
   </div>
   <aside class="company-identity-visual" aria-label="Identificação visual da empresa">
    {image?.src?<figure class="company-photo-card"><img src={image.src} alt={image.alt} width="820" height="600" loading="eager" decoding="async"/><figcaption><strong>{image.title}</strong><span>{image.address||unitVisual?.address||brand.location}</span><small>Imagem de divulgação da marca, sem data da fotografia confirmada. Não é foto do conflito.</small><a href={photoSource} target="_blank" rel="noopener noreferrer">Ver fotografia na fonte original ↗</a></figcaption></figure>
     :<div class="company-photo-empty"><strong>Imagem do estabelecimento em verificação</strong><p>O catálogo aceita imagens com fonte, localização, data e autoria. Não usamos fotos de outras lojas para representar uma unidade.</p></div>}
    {unitVisual?.website&&<a class="company-visual-source" href={unitVisual.website} target="_blank" rel="noopener noreferrer">Página oficial da unidade ↗</a>}
   </aside>
  </div>
  <div class="company-identity-metrics" aria-label="Dados deste dossiê">
   <div><strong>{reportedPaymentTotal?brl(reportedPaymentTotal):'—'}</strong><span>Pagamento informado nos casos associados</span></div>
   <div><strong>{holdDays!=null?holdDays+' dias':'—'}</strong><span>Desde pagamento relatado até última revisão</span></div>
   <div><strong>{indexedReportCount}</strong><span>Reclamações públicas catalogadas {unit?'da unidade':'nos casos vinculados'}</span></div>
   <div><strong>{sourceCount}</strong><span>URLs de referências distintas no dossiê</span></div>
  </div>
  {snapshot&&!unit&&<p class="company-brand-footnote">Contexto da marca: {snapshot.total_active_records} reclamações listadas no histórico externo do Reclame Aqui em {snapshot.as_of.split('-').reverse().join('/')}. Amostra diferente, não somada acima. <a href={snapshot.page_url} target="_blank" rel="noopener noreferrer">Fonte ↗</a></p>}
 </div>
</section>