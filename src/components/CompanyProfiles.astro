---
import profiles from '../data/company-profiles.json';
import Section from './layout/Section.astro';
import Eyebrow from './layout/Eyebrow.astro';
import { Card, CardContent, CardFooter, CardHeader } from './ui/card';
import { cn } from '@/lib/utils';
interface Props { only?: string[]; title?: string; hidePeople?: boolean }
const { only, title = 'Mapa societário e cadastros das empresas', hidePeople = false } = Astro.props;
const entities = profiles.entities.filter((p) => !only || only.includes(p.id));
const brl = (n: number | null) => (n == null ? 'Não informado no levantamento': new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 2 }).format(n));
---
<Section id="perfis-cnpj" tone="muted" eyebrow="Cadastro empresarial · Receita Federal / QSA" title={title} description="Fichas com fonte. Sócios e administradores no QSA. Quem responde pelo pedido? Exija o CNPJ do contrato e do pagamento — e emita o comprovante oficial.">
  <a slot="action" class="text-link text-sm" href={profiles.registry_verification_url} target="_blank" rel="noopener noreferrer">Consultar CNPJ e QSA na Receita Federal ↗</a>
  <div class="space-y-5">
    {entities.map((p) => (
      <Card className={cn(p.id === 'brasmoveis-historico'&& 'border-l-4 border-l-warning')} id={'cnpj-'+ p.id}>
        <CardHeader className="gap-4 md:grid-cols-[1fr_auto]">
          <div class="space-y-2">
            <Eyebrow>{p.scope}</Eyebrow>
            <h3 class="m-0 text-2xl">{p.name}</h3>
            <p class="m-0 max-w-2xl text-sm text-muted-foreground">{p.relationship}</p>
          </div>
          <div class="bg-muted p-4 md:min-w-56">
            <small class="block text-xs text-muted-foreground">CNPJ</small>
            <strong class="block font-mono text-lg">{p.cnpj}</strong>
            <small class="block text-xs text-muted-foreground">{p.registration}</small>
          </div>
        </CardHeader>
        <CardContent className="space-y-5">
          <dl class="m-0 grid gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
            {[
              ['Abertura', p.opened.split('-').reverse().join('/')],
              ['Capital social declarado', brl(p.capital_brl)],
              ['CNAE principal', `${p.main_cnae} · ${p.main_activity}`],
              ['Natureza jurídica', p.type],
              ['Localidade comercial', p.address],
              ...(p.tax_regime ? [['Regime tributário cadastrado', p.tax_regime]] : []),
            ].map(([k, v]) => (
              <div class="border-t pt-3">
                <dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{k}</dt>
                <dd class="m-0 mt-1 text-sm font-medium">{v}</dd>
              </div>
            ))}
          </dl>
          {p.additional_cnaes && (
            <div class="space-y-2 border-t pt-4">
              <h4 class="m-0">Atividades secundárias</h4>
              <ul class="m-0 list-disc space-y-1 pl-5 text-sm text-muted-foreground">{p.additional_cnaes.map((s) => <li>{s}</li>)}</ul>
            </div>
          )}
          {!hidePeople && p.qsa.length > 0 && (
            <div class="space-y-3 border-t pt-4">
              <h4 class="m-0">Quadro de sócios e administradores — cadastro consultado</h4>
              <div class="grid gap-2 sm:grid-cols-2">
                {p.qsa.map((q) => (
                  <div class="border p-3">
                    <strong class="block text-sm">{q.name}</strong>
                    <span class="text-xs text-muted-foreground">{q.role}{q.entered ? '· desde '+ q.entered.split('-').reverse().join('/') : ''}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
          {hidePeople && p.qsa.length > 0 && (
            <p class="m-0 border-t pt-4 text-sm text-muted-foreground">Administradores do endereço comercial só entram neste caso depois da conferência dos CNPJs do contrato. A ficha cadastral original continua na fonte.</p>
          )}
          <div class="space-y-2 border-t pt-4">
            <h4 class="m-0">Notas de verificação</h4>
            <ul class="m-0 list-disc space-y-1 pl-5 text-sm text-muted-foreground">{p.notes.map((n) => <li>{n}</li>)}</ul>
          </div>
        </CardContent>
        <CardFooter className="flex-wrap gap-x-5 gap-y-2 border-t pt-4 text-sm">
          <strong>Ficha individual e fontes</strong>
          <a class="text-link" href={'/cnpj/'+ p.cnpj.replace(/\D/g, '') + '/'}>Ver perfil CNPJ com QSA e vínculos ↗</a>
          {p.sources.map((s) => <a class="text-link" href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}
        </CardFooter>
      </Card>
    ))}
  </div>
  <p class="mt-6 mb-0 max-w-4xl text-sm text-muted-foreground">Atualizado em {profiles.updated_at.split('-').reverse().join('/')}. Fontes agregadoras apontam a Receita Federal; emita o comprovante oficial. Capital social no cadastro ≠ dinheiro na conta. Exija o CNPJ do contrato.</p>
</Section>
