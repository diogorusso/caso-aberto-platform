    "verify:civic": "node scripts/validate-civic-research.mjs",
    "verify:publications": "node scripts/validate-publications.mjs",
    "content:pack": "node scripts/create-content-packs.mjs",
    "verify:content-packs": "node --test scripts/test-content-packs.mjs",
    "verify:curated-content": "node scripts/validate-curated-content.mjs",
    "verify:education-coverage": "node scripts/validate-education-coverage.mjs",
    "content:coverage": "node scripts/report-education-coverage.mjs",
    "verify:lead-magnets": "node scripts/validate-academy-lead-magnets.mjs",
