    "verify:course-crypto": "node --test scripts/test-private-course.mjs",
    "verify:public-bundle": "node scripts/audit-public-education-bundle.mjs",
    "verify:cause-api": "npm --prefix services/cause-api run verify",
    "verify:public-case-atlas": "node scripts/validate-public-case-atlas.mjs",
    "verify:politics": "node scripts/validate-political-observatory.mjs",
    "research:politics": "node scripts/run-political-research.mjs",
    "verify:case-catalog": "node scripts/validate-case-catalog.mjs",
    "verify:visual-stories": "node scripts/validate-visual-stories.mjs",
    "verify:research-ledger": "node scripts/validate-research-ledger.mjs",
